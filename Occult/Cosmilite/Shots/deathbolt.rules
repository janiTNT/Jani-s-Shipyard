ID = "janiTNT.DeathboltCosmic"
Range = 2250
IdealRange = [800, 470]
IdealRadius = [5, 50]
Speed = 800

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 1
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	/*Homing
	{
		Type = TargetHoming
		TurnVelocity = 90d
		Delay = 0.75
		//AvoidanceRaycastDistance = 250
		//VelocityCompensation = 70%
		ModifiesLinearVelocity = true
	}*/

	Targetable
	{
		Type = Targetable
		Health = 10000
		TargetCategory = "laser"
	}
	
	DamagePool
	{
		Type = DamagePool
		Damage = 180000
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable
		Penetration = 80
		PenetrationSpeed = 30
		
		SourceShipLowCollisions = false

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=100000; EffectScaleExponent=1; }
					Radius = 8
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Damage
					Damage = 0
					DamagePool = DamagePool
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=80; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/shots/missile_he/particles/missile_he_flash.rules>
				&<./data/shots/missile_he/particles/missile_he_hit.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/laser_bolt_large/laser_bolt_large_hit.wav"
					Volume = .75
					SpeedVariation = .4
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			MediaEffects
			[
				&<./data/shots/missile_he/particles/missile_he_flash.rules>
				&<./data/shots/missile_he/particles/missile_he_hit.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/laser_bolt_large/laser_bolt_large_hit.wav"
					Volume = .75
					SpeedVariation = .4
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		PenetratingOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 0
					DamagePool = DamagePool
				}
			]
		}
		PenetratingStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 0
					DamagePool = DamagePool
				}
			]
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}
	
	Sprite2
	{
		Type = Sprite
		Offset = [0, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "../../shots/bolttrail.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [40, 5]
			VertexColor = [0 * 4, 128 * 4, 255 * 4]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [.1, .1]
		LerpTime = .5
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [25, 25]
			VertexColor = [0, 128, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}