		Type = Sprite
		Z = .25
		IsLight = true
		RenderBucket = BulletUpper3
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../other/SightLaserB.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [800, 20]
			VertexColor = [215 , 215, 255]
