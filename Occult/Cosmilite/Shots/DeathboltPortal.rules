ID = "janiTNT.DeathboltSpawnerPortal"
Range = 1000
IdealRange = 600
Speed = 0
Stage2 = &<deathboltportalp2.rules>

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 2
		Density = 0.1
		LinearDamping = 1
		FrameOfReferenceDuration = 2
		RandomExtraSpeed = [-50, 50]
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 1
		Range = 1000
		TargetTypesByPriority = [ShipParts]
	}
	
	Repulsion
	{
		Type = ProximityAcceleration
		Range = 150
		Acceleration = -180
		AccelerateTowardsShips = true
		AccelerateTowardsFriendlies = false
		AccelerateTowardsEnemies = true
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 512d
		Delay = .25
	}

	/*Acceleration
	{
		Type = Acceleration
		Acceleration = 80
	}*/

	DeployDeath
	{
		Type = DeathByLifetime
		Lifetime = 1
		//FactorEffectsWith = Targetable

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &~/Stage2
					Count = 1
					InheritVelocity = true
					ScaleHealth = true
					Distance = 0
					Spread = [-.5d, .5d]
				}
			]
		}
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 324d
		Sprite
		{
			Texture
			{
				File = "flare.png"
				MipLevels = max
			}
			Size = [5, 5]
			TargetBlendMode = Add
			VertexColor = [0 , 180 * 0.9, 255* 0.9]
		}
		LerpScaleFrom = [0.32, 0.35]
		LerpTime = 1
	}
	Sprite2
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = -102d
		Sprite
		{
			Texture
			{
				File = "flare.png"
				MipLevels = max
			}
			Size = [6, 6]
			TargetBlendMode = Add
			VertexColor = [255* 0.9 , 120 * 0.9, 255* 0.9]
		}
		LerpScaleFrom = [0.32, 0.35]
		LerpTime = 2
	}
