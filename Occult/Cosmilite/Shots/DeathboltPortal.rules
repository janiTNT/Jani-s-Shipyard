	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = -92d
		Sprite
		{
			Texture
			{
				File = "flare.png"
				MipLevels = max
			}
			Size = [12, 12]
			TargetBlendMode = Add
			VertexColor = [255 , 0, 0]
		}
