	LightsSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//Spin = 500d
		Z = .25
		IsLight = true
		//Offset = [24/64, 0]
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [12, 12]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 0
		}
		LerpScaleFrom = [0, 0]
		LerpTime = 0.75
	}


	/*Targetable
	{
		Type = Targetable
		Health = 32000
		TargetCategory = "missile"

		// No AOE damage when shot down.
		OnDeath = &../Hit/HitFriendly
	}*/

	Hit
	{
		Type = SimpleHit
		SourcePartCollisionDelay = 1.5/30
		SourceShipLowCollisions = false

		HitShield = &HitOperational
		HitOperational
		{
			Bounce = true
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			Bounce = true
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}
			]
		}
	}
}