ID = "janiTNT.imperium_boss_wall_2_dash"
//OtherIDs = ["missile", "cosmoteer.missile"]
Range = 150
IdealRange = 450
Speed = 0

Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [11, 88]
		Density = 1000
		LinearDamping = 2.5
		FrameOfReferenceDuration = 1
	}
	
	Acceleration
	{
		Type = Acceleration
		Acceleration = [-0, -100]
		AccelerationOverTime = [0, 2]
	}

	DeathByDistanceTraveled
	{
		Type = DeathByDistanceTraveled
		Distance = (&~/Range) * 1
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "wallsigil.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [22, 44]
			TargetBlendMode = Add
		}
	}
	
	SpriteWider
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "wallsigil.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [22, 70]
			TargetBlendMode = Add
			VertexColor = [20, 20, 20, 255]
		}
	}

	Hit
	{
		Type = SimpleHit
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false

		ShieldCollisions = { Shields=false; }

		HitShield {}
		
		HitOperational
		{
			Bounce = true
			
			MediaEffectsScale = 3
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				//&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 0.2
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			Bounce = true
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
	}
}