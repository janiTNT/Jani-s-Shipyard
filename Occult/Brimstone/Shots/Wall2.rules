ID = "janiTNT.imperium_boss_wall_2"
//OtherIDs = ["missile", "cosmoteer.missile"]
Range = 2000
IdealRange = 450
Speed = 400

Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [11, 88]
		Density = 1000
		LinearDamping = 2.5
		FrameOfReferenceDuration = 1
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 80 - 5//full cycle.
		//Lifetime = 15
		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<Wall2_p2.rules>
					Count = 1
					InheritVelocity = false
				}
			]
		}
	}
	
	Aimlaser
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//IsLit = true
		Offset = [-150/2, 0]
		Sprite
		{
			Texture
			{
				File = "../../other/SightLaserB.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [150, 88*1.75]
			VertexColor = [255/4, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 1
		}
		StartTime = (80 - 5) - 5
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "wallsigil.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [22, 44]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [1, 0]
		LerpTime = 0.2
	}
	
	SpriteWider
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "wallsigil.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [22, 88]
			TargetBlendMode = Add
			VertexColor = [20, 20, 20, 255]
		}
		LerpScaleFrom = [1, 0]
		LerpTime = 1
	}

	Hit
	{
		Type = SimpleHit
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false

		ShieldCollisions = { Shields=false; }

		HitShield {}
		
		HitOperational
		{
			Bounce = true
			
			MediaEffectsScale = 3
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				//&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 0.2
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			Bounce = true
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
	}
}