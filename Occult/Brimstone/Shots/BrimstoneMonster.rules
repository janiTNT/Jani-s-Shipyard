ID = "janiTNT.brimstonemonster_boss"
//OtherIDs = ["missile", "cosmoteer.missile"]
Range = 10000
IdealRange = 250
Speed = 10

Components
{
	Physics
	{
		Type = CirclePhysics
		//Radius = 34 //Perfect...
		Radius = 28*4
		Density = 3
		LinearDamping = 1 * 0.25
		AngularDamping = 1
		FrameOfReferenceDuration = 1
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 45d/2
		Delay = 0
		//AvoidanceRaycastDistance = 250
		VelocityCompensation = 80%
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 1
		Range = 560
		TargetTypesByPriority = [ShipParts]
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = 20 * 0.25
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = [70*4, 72*4]
		OnDeath = &../Hit/HitFriendly
	}

	Sprite1
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		RotOffset = 90d
		Spin = 83d
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinnerVoid.png"
				MipLevels = max
			}
			//UVRotation = 1
			Size = [72*4, 72*4]
			VertexColor = [128 , 25, 25]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [0.1, 0.1]
		LerpTime = 1.5
	}
	Sprite2
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Spin = 94d
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinnerVoid.png"
				MipLevels = max
			}
			//UVRotation = 1
			Size = [72*4, 72*4]
			VertexColor = [128 , 25, 25]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [0.1, 0.1]
		LerpTime = 1.6
	}
	Sprite3
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 120d
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinner.png"
				MipLevels = max
			}
			//UVRotation = 1
			Size = [72*4, 72*4]
			VertexColor = [20 , 0, 60]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [0.1, 0.1]
		LerpTime = 1.6
	}
	
	VoidSprite
	{
		Type = Sprite
		RenderBucket = BulletLower1
		Sprite
		{
			Texture
			{
				File = "../../Other/VoidOfTheSpinner.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [72*4, 72*4]
			VertexColor = [0, 0, 0, 256]
		}
		LerpScaleFrom = [0.1, 0.1]
		LerpTime = 1.5
	}
	ShadowSprite
	{
		Type = Sprite
		RenderBucket = BulletLower1
		Sprite
		{
			Texture
			{
				File = "./data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [150*4, 150*4]
			
			VertexColor = [0, 0, 0, 80]
		}
		LerpScaleFrom = [0.2, 0.2]
		LerpTime = 3
	}
	
	DeathProximity
	{
		Type = DeathByEnemyProximity
		Interval = 0.25
		Range = 28 * 4 * 1.25
		StartDelay = 1
		OnDeath = &../Hit/HitOperational
	}
	
	Hit
	{
		Type = SimpleHit
		SourceShipLowCollisions = false
		FriendlyShipHighCollisions = false
		NonFriendlyShipLowCollisions = false
		NonFriendlyShipHighCollisions = false

		HitShield = &HitOperational
		HitOperational
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=1800000 * 2; EffectScaleExponent=1; }
					Radius = 90 * 2
					ImpulsePerNDamage = -550
					NDamage = 1000
					Slices = 1
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=600000 * 2; EffectScaleExponent=1; }
					Radius = 80 * 2
					ImpulsePerNDamage = -55
					NDamage = 1000
					Delay = .5
					Slices = 1
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
					}
				}
			]
			
			MediaEffectsScale = 400
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_shockwave.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_hit.rules>
				//&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural
		{
			HitEffects = []
		}

		HitFriendly
		{
			MediaEffectsScale = 10
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_shockwave.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_hit.rules>
				//&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
	}
	
