ID = "janiTNT.CursedFly_0"
Range = 2000
IdealRange = 450
Speed = 50

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 2
		Density = 0.1
		LinearDamping = 2
		FrameOfReferenceDuration = 2
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 2
		Range = 1000
		TargetTypesByPriority = [ShipParts]
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 50d
		Delay = 2
	}

	Retarget
	{
		Type = SameShipRetarget
	}
 
	Acceleration
	{
		Type = Acceleration
		Acceleration = 40
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = [7.5]
		
		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<Fly_p2.rules>
					Count = 1
					Distance = 0		
					InheritVelocity = true
					RandomizeTarget = false
				}
			]
		}
	}
	
	DeathByEnemyProximity
	{
		Type = DeathByEnemyProximity
		Interval = .1
		Range = 50
		DetectsShips = true
		DetectsBullets = false
		StartDelay = 2

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<Fly1.rules>
					Count = 4
					Distance = .5
					Spread = [-20d, 40d]
					InheritVelocity = true
					RandomizeTarget = true
				}
			]
		}
	}
	
	WingSprite
	{
		Type = AnimatedSprite
		Offset = [-6, -6]
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "FlyWing_flip_becausethegamedoesnthaveit.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [12, 12]
				TargetBlendMode = Add
			}
			FrameCount = 8
			FrameSize = [328, 332]
			TargetBlendMode = Add
			FramesPerRow = 8
			FramesPerSecond = 40
		}
	}
	WingSprite2
	{
		Type = AnimatedSprite
		Offset = [-6, 6]
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "FlyWing.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [12, 12]
				TargetBlendMode = Add
			}
			FrameCount = 8
			FrameSize = [328, 332]
			TargetBlendMode = Add
			FramesPerRow = 8
			FramesPerSecond = 40
		}
	}
	
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 324d
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinner.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [12*0.8, 12*0.8]
			TargetBlendMode = Add
			VertexColor = [350*0.8, 25, 25]
		}
		LerpScaleFrom = [0.2, 0.2]
		LerpTime = 1
	}
	
	LightsSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//Spin = 500d
		Z = .25
		IsLight = true
		//Offset = [24/64, 0]
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [24, 24]
			TargetBlendMode = Add
			VertexColor = [255 , 0, 0]
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 0.15
		}
		LerpScaleFrom = [0, 0]
		LerpTime = 0.75
	}
	
	Aimlaser
	{
		Type = Sprite
		Z = .25
		IsLight = true
		RenderBucket = BulletUpper3
		//IsLit = true
		Offset = [700/2, 0]
		Sprite
		{
			Texture
			{
				File = "../../other/SightLaserB.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [700, 3]
			VertexColor = [255/6, 0, 25/6]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 1
		}
		LerpScaleFrom = [0.5, 0]
		LerpTime = .25
		StartTime = 6.5
	}
	
	Targetable
	{
		Type = Targetable
		Health = 10000
		TargetCategory = "missile"

		OnDeath = &../DeathByEnemyProximity/OnDeath
	}
	

	Hit
	{
		Type = SimpleHit

		HitShield = &HitOperational
		SourceShipCollisionDelay = 1.5/30
		SourceShipLowCollisions = false
		
		HitOperational = &../DeathByEnemyProximity/OnDeath
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=1000; EffectScaleExponent=1; }
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=1.5; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./Data/shots/bullet_med/particles/bullet_hit_med_sparks.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/shots/bullet_med/bullet_med_hit.wav"
					Volume = .1
					SpeedVariation = .4
				}
			]
		}
		HitFriendly
		{
			Bounce = true
		}
	}
}