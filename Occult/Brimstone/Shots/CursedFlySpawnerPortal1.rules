	LightsSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//Spin = 500d
		Z = .25
		IsLight = true
		//Offset = [24/64, 0]
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [12, 12]
			TargetBlendMode = Add
			VertexColor = [255 , 0, 0]
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 0.15
		}
		LerpScaleFrom = [0, 0]
		LerpTime = 0.75
	}
}