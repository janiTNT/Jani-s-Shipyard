							Distance = -1200
							//Arc = [70d, 180d]
							Spread = [-2d, 4d]
							InheritVelocity = false
						}
					// ]
					// Count = 1
					// Interval = .25
					// InitialDelay = 15
				// }
				{
					Type = SpawnBullets
					Bullet = &<BrimstonePortal.rules>
					Count = 1
					Distance = -1100
					Arc = [-90d, 180d]
					Spread = [-1d, 2d]
					InheritVelocity = false
				}
				{
					Type = Repeating
