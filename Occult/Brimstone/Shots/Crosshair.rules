ID = "janiTNT.imperium_boss_wall_initializer"
//OtherIDs = ["missile", "cosmoteer.missile"]
Range = 1000
IdealRange = 800
Speed = 240

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 2
		Density = 1
		LinearDamping = 2
		AngularDamping = 1
		FrameOfReferenceDuration = 1
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 1080d
		Delay = 0.5
		//AvoidanceRaycastDistance = 250
		//VelocityCompensation = 10%
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 2
		Range = 800
		TargetTypesByPriority = [ShipCenters]
		TargetType = ShipCenters
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = 600 * 2
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 5
		OnDeath
		{
			HitEffects
			[
				{
