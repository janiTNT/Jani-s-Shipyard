				} */
			]
		}
	}
	
	CrosshairSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 45d
		Sprite
		{
			Texture
			{
				File = "wallaim.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [90, 90]
