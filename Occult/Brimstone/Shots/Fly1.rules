ID = "janiTNT.CursedFly_1"
Range = 2000
IdealRange = 450
Speed = 15

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 2/1.5
		Density = 0.1
		LinearDamping = 2
		FrameOfReferenceDuration = 2
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 4
		Range = 1000
		TargetTypesByPriority = [ShipParts]
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 120d
		Delay = .5
		AvoidanceRaycastDistance = 100
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = [5, 160]
		AccelerationOverTime = [0, 2]
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = [10, 15]
	}
	
	DeathByEnemyProximity
	{
		Type = DeathByEnemyProximity
		Interval = .15
		Range = 15
		DetectsShips = true
		DetectsBullets = false
		StartDelay = 1

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<Fly2.rules>
					Count = 4
					Distance = .5/1.5
					Spread = [-20d, 40d]
					InheritVelocity = false
					RandomizeTarget = true
				}
			]
		}
	}
	
	WingSprite
	{
		Type = AnimatedSprite
		Offset = [-4/1.5, -4/1.5]
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "FlyWing_flip_becausethegamedoesnthaveit.png"
					SampleMode = Linear
					MipLevels = max
				}
				TargetBlendMode = Add
				Size = [8/1.5, 8/1.5]
			}
			FrameCount = 8
			FrameSize = [328, 332]
			FramesPerRow = 8
			FramesPerSecond = 90
		}
	}
	WingSprite2
	{
		Type = AnimatedSprite
		Offset = [-4/1.5, 4/1.5]
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "FlyWing.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [8/1.5, 8/1.5]
				TargetBlendMode = Add
			}
			FrameCount = 8
			FrameSize = [328, 332]
			FramesPerRow = 8
			FramesPerSecond = 90
		}
	}
	
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 512d
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinner.png"
				MipLevels = max
			}
			Size = [6/1.5, 6/1.5]
			TargetBlendMode = Add
			VertexColor = [400, 25, 25]
		}
		LerpScaleFrom = [0.2, 0.2]
		LerpTime = .15
	}
	
	LightsSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//Spin = 500d
		Z = .25
		IsLight = true
		//Offset = [24/64, 0]
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [24/1.5, 24/1.5]
			TargetBlendMode = Add
			VertexColor = [255 , 0, 0]
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 0.15
		}
	}
	
	Targetable
	{
		Type = Targetable
		Health = 1000
		TargetCategory = "missile"

		OnDeath = &../DeathByEnemyProximity/OnDeath
	}
	

	Hit
	{
		Type = SimpleHit

		HitShield = &HitOperational
		SourceShipCollisionDelay = 1.5/30
		SourceShipLowCollisions = false
		
		HitOperational = &../DeathByEnemyProximity/OnDeath
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=1000; EffectScaleExponent=1; }
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=1.5; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./Data/shots/bullet_med/particles/bullet_hit_med_sparks.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/shots/bullet_med/bullet_med_hit.wav"
					Volume = .1
					SpeedVariation = .4
				}
			]
		}
		HitFriendly
		{
			Bounce = true
		}
	}
}