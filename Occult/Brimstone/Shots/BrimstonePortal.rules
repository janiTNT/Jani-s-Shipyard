ID = "janiTNT.BrimstoneSpawnerPortal"
Range = 1000
IdealRange = 600
Speed = 0
Stage2 = &<BrimstonePortal2.rules>
Beam0 = &<BeamCenter0.rules>
Beam1 = &<BeamCenter1.rules>
Beam2 = &<BeamCenter2.rules>

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 4
		Density = 0.1
		LinearDamping = 1
		FrameOfReferenceDuration = 2
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = .5
		Range = 1000
		TargetTypesByPriority = [ShipParts]
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 45d
		Delay = 1
	}

	DeployDeath
	{
		Type = DeathByLifetime
		Lifetime = 25
		//FactorEffectsWith = Targetable

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &~/Stage2
					Count = 1
					InheritVelocity = false
					ScaleHealth = true
					Distance = 0
				}
 				{
					Type = Repeating
					HitEffects
					[
						{
							Type = SpawnBullets
							Bullet = &~/Beam0
							Count = 1
							InheritVelocity = false
							ScaleHealth = true
							Distance = 0+(130/2)
						}
						{
							Type = SpawnBullets
							Bullet = &~/Beam1
							Count = 1
							InheritVelocity = false
							ScaleHealth = true
							Distance = 130+(130/2)
						}
						: 1
						{Distance = 130*2+(130/2)}
						: 1
						{Distance = 130*3+(130/2)}
						: 1
						{Distance = 130*4+(130/2)}
						: 1
						{Distance = 130*5+(130/2)}
						: 1
						{Distance = 130*6+(130/2)}
						: 1
						{Distance = 130*7+(130/2)}
						: 1
						{Distance = 130*8+(130/2)}
						: 1
						{Distance = 130*9+(130/2)}
						: 1
						{Distance = 130*10+(130/2), Bullet = &~/Beam2}
					]
					Count = 1
					Interval = 0
					InitialDelay = 2
				}
				{
					Type = Repeating
					HitEffects
					[
						{
							Type = SpawnBullets
							Bullet = &<BrimstoneInvisiBeam.rules>
							Count = 1
							Distance = 2
							Spread = [-0, 0d]
							InheritVelocity = false
							RandomizeTarget = false
						}
					]
					Count = 14 / .1
					Interval = .1
					InitialDelay = 2
				}
			]
		}
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 324d
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinner.png"
				MipLevels = max
			}
			Size = [8*8, 8*8]
			TargetBlendMode = Add
			VertexColor = [255, 25, 25]
		}
		LerpScaleFrom = [0.32, 0.35]
		LerpTime = 2
	}
	Sprite2
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Spin = 300d
		Sprite
		{
			Texture
			{
				File = "../../Other/PortalSpinner.png"
				MipLevels = max
			}
			Size = [8.1*8, 8.1*8]
			TargetBlendMode = Add
			VertexColor = [255 , 25, 25]
		}
		LerpScaleFrom = [0.32, 0.35]
		LerpTime = 3.5
	}
	
	Aimlaser
	{
		Type = Sprite
		Z = .25
		IsLight = true
		RenderBucket = BulletUpper3
		//IsLit = true
		Offset = [1450/2, 0]
		Sprite
		{
			Texture
			{
				File = "../../other/SightLaserB.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [1450, 5]
			VertexColor = [255/2, 0, 25/2]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 1
		}
		LerpScaleFrom = [0.5, 0]
		LerpTime = .25
		StartTime = 20
	}

	LightsSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//Spin = 500d
		Z = .25
		IsLight = true
		//Offset = [24/64, 0]
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [12, 12]
			TargetBlendMode = Add
			VertexColor = [255 , 0, 0]
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = 0.15
		}
		LerpScaleFrom = [0, 0]
		LerpTime = 0.75
	}
}