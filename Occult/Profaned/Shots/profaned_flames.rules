ID = "janiTNT.profanedflameattack"
Range = 800
IdealRange = [75, 190]
IdealRadius = [5, 50]
Speed = 250
ForgetTarget = true

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 1
		Density = 1
		RandomExtraSpeed = [-40, 40]
		LinearDamping = .5
		AngularDamping = 1
		FrameOfReferenceDuration = 1
	}

	Death
	{
		Type = DeathByLifetime
		Lifetime = [4, 4.8]
	}
	
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 50d
		Delay = .5
		ModifiesLinearVelocity = true
	}
	
	TargetSearch
	{
		Type = TargetSearch
		Interval = 1
		Range = 80
		TargetTypesByPriority = [ShipParts]
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 20.0
		PenetrationSpeed = 20

		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=12000; EffectScaleExponent=1; }
					Filter
					{
						Friendlies = true
					}
				}
				/* {
					Type = AreaFires
					FireChancePerTile = .3
					FireRadius = 10
					Radius = 1
					FireFalloff = 0
					Delay = 0.75
					AllowFriendlyFires = true
					Filter
					{
						Friendlies = true
					}
				} */
				{
					Type = Impulse
					Impulse = { BaseValue=180; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/shots/bullet_deck/particles/bullet_hit_deck.rules>
				&<./data/shots/bullet_deck/particles/bullet_hit_deck_sparks.rules>
				&<./data/shots/bullet_deck/particles/bullet_smoke_deck.rules>
				&<./data/shots/bullet_deck/particles/bullet_flash_deck.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav",
									"./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav",
									"./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav"]
					Volume = 1
					SpeedVariation = .15
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .2
					Duration = .75
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.5, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=10000; EffectScaleExponent=1; }
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=90; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/shots/bullet_large/particles/bullet_hit_large.rules>
				&<./data/shots/bullet_deck/particles/bullet_hit_deck_sparks.rules>
				&<./data/shots/bullet_deck/particles/bullet_flash_deck_struct.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav",
									"./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav",
									"./data/shots/bullet_deck/sounds/deck_cannon_impact_01.wav"]
					Volume = 1
					SpeedVariation = .15
				}
			]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=20000; EffectScaleExponent=1; }
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance = { BaseValue = .8; EffectScaleExponent = 1 }
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse = { BaseValue=180; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/shots/bullet_deck/particles/bullet_hit_deck.rules>
				&<./data/shots/bullet_deck/particles/bullet_hit_deck_sparks.rules>
			]
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite1
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Spin = 500d
		//IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../lightball.png"
				MipLevels = max
			}
			Size = [6, 6]
			TargetBlendMode = Add
			VertexColor = [255*1.5, 205*1.5, 128*1.5]
		}
		LerpScaleFrom = [0.2, 0.2]
		LerpTime = 3
	}
	
	Sprite2 : & Sprite1
	{
		Spin = -274d
		Sprite
		{
			Texture
			{
				File = "../../lightball.png"
				MipLevels = max
			}
			Size = [5.75, 5.75]
			TargetBlendMode = Add
			VertexColor = [255*1.5, 205*1.5, 128*1.5]
		}
	}
	
	Sprite3 : & Sprite1
	{
		Spin = -612d
		Sprite
		{
			Texture
			{
				File = "../../lightballs.png"
				MipLevels = max
			}
			Size = [8.5, 8.5]
			TargetBlendMode = Add
			VertexColor = [255*1.5, 205*1.5, 128*1.5]
		}
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 1
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./data/ships/common/light_blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [18, 18]
			VertexColor = [255*4, 205*4, 128*4]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 1
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.015
		}
		LerpScaleFrom = [0.2, 0.2]
		LerpTime = .5
	}

	/*MediaEffects
	{
		Type = MediaEffects
		MediaEffects
		[
			&<profaned_flames_trail.rules>
		]
	}*/
}