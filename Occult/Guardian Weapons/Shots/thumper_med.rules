ID = "janiTNT.ThumperProjectileMed"
Range = 780
IdealRange = [160, 770]
IdealRadius = [5, 50]
Speed = 200

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 2
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	/*Targetable
	{
		Type = Targetable
		Health = 8000
		TargetCategory = "laser"
	}*/

	Hit
	{
		Type = PenetratingHit

		//FactorEffectsWith = Targetable

		CrewCollisions = {Enemies=false; Junk=false}
		ShieldCollisions = { Shields=false; }

		HitCrew = &HitOperational
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		NonFriendlyShipLowCollisions = true
		NonFriendlyShipHighCollisions = true
		
		Collisions
        	{
            		Enemies = false
            		Junk = false
            		Friendlies = false
            		Neutrals = false
        	}
		
		//HitShield = &HitOperational
		HitOperational
		{
			Bounce = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=12000; EffectScaleExponent=1; }
					Radius = 6
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=800; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/shots/missile_he/particles/missile_he_hit.rules>
				&<./data/shots/missile_he/particles/missile_he_flash.rules>
				&<./data/shots/missile_he/particles/missile_he_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/missile_he/sounds/launcher_rocket_impact_01.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_02.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"]
					SpeedVariation = .1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			Bounce = true
			MediaEffects
			[
				&<./data/shots/missile_he/particles/missile_he_hit.rules>
				&<./data/shots/missile_he/particles/missile_he_flash.rules>
				&<./data/shots/missile_he/particles/missile_he_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/missile_he/sounds/launcher_rocket_impact_01.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_02.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"]
					SpeedVariation = .1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	DeathByEnemyProximity
	{
		Type = DeathByEnemyProximity
		Interval = .1
		Range = 120
		DetectsShips = true
		DetectsBullets = false
		StartDelay = 0.5

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<thumper_med_deploying.rules>
					Count = 1
					InheritVelocity = true
				}
			]

			MediaEffects
			[

			]
		}
	}

	Sprite
	{
		Type = Sprite
		Offset = [0, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		LerpScaleFrom = [0.25, 0.25]
		LerpTime = 0.5
		Sprite
		{
			Texture
			{
				File = "CircleShineSoft.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [16, 16]
			VertexColor = [173, 148, 255]
			TargetBlendMode = Add
		}
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.5
		IsLight = true
		LerpScaleFrom = [0.5, 0.5]
		LerpTime = 0.5
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [28, 28]
			VertexColor = [241, 163, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}