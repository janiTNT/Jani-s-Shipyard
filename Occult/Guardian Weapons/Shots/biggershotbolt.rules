ID = "janiTNT.GuardianBoltLargerer"
Range = 350
IdealRange = [90, 200]
IdealRadius = [5, 50]
Speed = 250

Components
{	
	Physics
	{
		Type = CirclePhysics
		Radius = 3
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 64000
		TargetCategory = "laser"
	}
	
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 15d
		Delay = 0.5
		ModifiesLinearVelocity = true
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 120000* 2
					Radius = 10 * 2^0.5
					ExpandDuration = .8
					ExpandStartRadius = 2
					ExpandLoss = 100%
					ImpulsePerNDamage = 10
					NDamage = 1000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 40000 * 2
					Radius = 8 * 2^0.5 
					ExpandDuration = .8
					ExpandStartRadius = 2
					ExpandLoss = 100%
					ImpulsePerNDamage = 5
					NDamage = 1000
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]

			MediaEffectsScale = 0.8
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_shockwave.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_hit.rules>
				//&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = .75
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			MediaEffects
			[
				&<./data/shots/missile_nuke/particles/missile_nuke_flash_light.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_flash.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_shockwave.rules>
				&<./data/shots/missile_nuke/particles/missile_nuke_hit.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./data/shots/missile_nuke/missile_nuke_hit.wav"
					Volume = 1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = Sprite
		Offset = [-1, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "../../Shots/LightBolt.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [10, 6]
			TargetBlendMode = Add
		}
	}
	
	Sprite2
	{
		Type = Sprite
		Offset = [-1, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "../../Shots/bolttrail.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [90, 4]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [.1, .1]
		LerpTime = .5
	}
	
	RadiationSpriteBig
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Spin = 360d
		Z = .25
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./data/shots/missile_nuke/radiation.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [36, 36]
			VertexColor = [64, 64, 64]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = .4
		}
		LerpScaleFrom = [.1, .1]
		LerpTime = .5
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [50, 50]
			VertexColor = [255, 255, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}