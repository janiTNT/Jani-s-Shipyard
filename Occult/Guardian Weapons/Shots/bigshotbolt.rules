ID = "janiTNT.GuardianBoltLarge"
Range = 210
IdealRange = [90, 200]
IdealRadius = [5, 50]
Speed = 300

Components
{	
	Physics
	{
		Type = CirclePhysics
		Radius = 2
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 12000
		TargetCategory = "laser"
	}
	
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 8d
		Delay = 0.5
		ModifiesLinearVelocity = true
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=60000; EffectScaleExponent=1; }
					Radius = 8
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Impulse;
					Impulse = { BaseValue=1400; EffectScaleExponent=1; }
				}
			]

			MediaEffects
			[
				&<./data/common_effects/particles/explosions/big_part_explode.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_flash.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_sparks.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_smoke.rules>
				&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/common_effects/sounds/large_part_destroyed_01.wav",
									"./data/common_effects/sounds/large_part_destroyed_02.wav",
									"./data/common_effects/sounds/large_part_destroyed_03.wav"]
					Volume = 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = 1
				}
			]
		}
		HitStructural = &HitOperational

		HitFriendly
		{
			MediaEffects
			[
				&<./data/common_effects/particles/explosions/big_part_explode.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_flash.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_sparks.rules>
				&<./data/common_effects/particles/explosions/big_part_explode_smoke.rules>
				&<../../particles/bigflash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/common_effects/sounds/large_part_destroyed_01.wav",
									"./data/common_effects/sounds/large_part_destroyed_02.wav",
									"./data/common_effects/sounds/large_part_destroyed_03.wav"]
					Volume = 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = 1
				}
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = Sprite
		Offset = [-1, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "../../Shots/LightBolt.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [8, 4]
			TargetBlendMode = Add
		}
	}
	
	Sprite2
	{
		Type = Sprite
		Offset = [-1, 0]
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "../../Shots/bolttrail.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [60, 3]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [.1, .1]
		LerpTime = .5
	}
	
	RadiationSpriteBig
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Spin = 360d
		Z = .25
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./data/shots/missile_nuke/radiation.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [27, 27]
			VertexColor = [64, 64, 64]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 10
			_litAdditiveStrength = 0.25
			_unlitAdditiveStrength = .4
		}
		LerpScaleFrom = [.1, .1]
		LerpTime = .5
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [35, 35]
			VertexColor = [255, 255, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}