RouteLines
{
	FusionLine
    {
    	Type = CappedLine
    	RenderToSeparateTexture = true
    	LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel.png"
    			SampleMode = Linear
    			MipLevels = max
    			UMode = Wrap
    		}
    		Shader = "./Data/gui/line_split_channel.shader"
    		_baseColor = [255, 0, 255, 100]
    		_glowColor = [255, 25, 200, 100]
    		TargetBlendMode = Max
    	}
    	BeginCapSprite : LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel_endcap_flipped.png"
    			SampleMode = Linear
    			MipLevels = max
    		}
    	}
    	BeginCapSize = [(&../LineThickness) / 2, (&../LineThickness)]
    	EndCapSprite : LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel_endcap.png"
    			SampleMode = Linear
    			MipLevels = max
    		}
    	}
    	EndCapSize = &BeginCapSize
    	LineThickness = 0.8
    	LineUPerLength = 0.8 / (&LineThickness)
    	ColorFactor = [255, 255, 255, 255]
    	UnroutableColorFactor = [255, 255, 255, 90]
    }
	CoolantLine
    {
    	Type = CappedLine
    	RenderToSeparateTexture = true
    	LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel.png"
    			SampleMode = Linear
    			MipLevels = max
    			UMode = Wrap
    		}
    		Shader = "./Data/gui/line_split_channel.shader"
    		_baseColor = [0, 143, 255, 255]
    		_glowColor = [0, 143, 255, 255]
    		TargetBlendMode = Max
    	}
    	BeginCapSprite : LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel_endcap_flipped.png"
    			SampleMode = Linear
    			MipLevels = max
    		}
    	}
    	BeginCapSize = [(&../LineThickness) / 2, (&../LineThickness)]
    	EndCapSprite : LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel_endcap.png"
    			SampleMode = Linear
    			MipLevels = max
    		}
    	}
    	EndCapSize = &BeginCapSize
    	LineThickness = 0.6
    	LineUPerLength = 0.8 / (&LineThickness)
    	ColorFactor = [255, 255, 255, 255]
    	UnroutableColorFactor = [255, 255, 255, 90]
    }
	HotCoolantLine
    {
    	Type = CappedLine
    	RenderToSeparateTexture = true
    	LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel.png"
    			SampleMode = Linear
    			MipLevels = max
    			UMode = Wrap
    		}
    		Shader = "./Data/gui/line_split_channel.shader"
    		_baseColor = [255, 128, 0, 255]
    		_glowColor = [255, 128, 0, 255]
    		TargetBlendMode = Max
    	}
    	BeginCapSprite : LineSprite
    	{
    		Texture
    		{
    			File = "./Data/gui/line_split_channel_endcap_flipped.png"
    			SampleMode = Linear
    			MipLevels = max
    		}
    	}
		BeginCapSize = [(&../LineThickness) / 2, (&../LineThickness)]
    	EndCapSprite : LineSprite
    	{
