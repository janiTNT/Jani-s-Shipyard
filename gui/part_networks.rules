OverlayIcons
{
	FusionPortOut
	{
		Sprite
		{
			File = "port_arrow_base.png"
			VertexColor = [255, 0, 255, 255]
			Size = [0.5, 0.5]
		}
		EdgeOffset = -(&Sprite/Size/0) * 24/64
		RouteLineOffset = (&EdgeOffset) - (&Sprite/Size/0) * 16/64
		DrawLineToEdgeWhenConnected = true
		UnroutableColorFactor = [255, 255, 255, 170]
	}
	FusionPortIn
	{
		Sprite
		{
			File = "port_arrow_base.png"
			VertexColor = [255, 0, 255, 192]
			Size = [0.5, 0.5]
			UVRotation = 2
		}
		EdgeOffset = -(&Sprite/Size/0) * 24/64
		RouteLineOffset = (&EdgeOffset) - (&Sprite/Size/0) * 16/64
		DrawLineToEdgeWhenConnected = true
		UnroutableColorFactor = [255, 255, 255, 170]
	}
