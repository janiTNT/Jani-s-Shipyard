	JS_JaniDisableStorage
	{
		Type = ResourceStorage
		ResourceType = janitnt.bossanticheese
		MaxResources = 100 //Timeout for 10 seconds.
		SuppliesResources = false
		StartingResources = 0
		InitToMaxResources = 0
		InitToMaxResourcesPVP = 0
		DropResourcesWhenDestroyed = false
		DropResourcesWhenRemoved = false
	}
	JS_DisablingStorageDrain
	{
		Type = ResourceConverter
		OperationalToggle = JS_JaniDisableStorage
		FromStorage = JS_JaniDisableStorage
		FromQuantity = 10
		MinFromQuantityForConversion = 1
		Interval = 1
	}
	JS_DisablingBuff
	{
		Type = WholeShipProvider
		OperationalToggle = JS_JaniDisableStorage
		BuffType = BossesDisableComponents
		BuffAmount = 1
		BuffsSelf = true
	}
	JS_DetectDisableBuff
	{
		Type = BuffToggle
		BuffType = BossesDisableComponents
		MinBuffValue = 1
	}
	JS_Boss_Components_Enabled
	{
		Type = MultiToggle
		Toggles = [{Toggle = JS_DetectDisableBuff, invert = true}]
		Mode = All
	}
}