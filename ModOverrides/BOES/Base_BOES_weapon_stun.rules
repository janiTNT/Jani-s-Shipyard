	JS_JaniDisableStorage_Stun
	{
		Type = ResourceStorage
		ResourceType = janitnt.boss_weaponstun
		MaxResources = 5*4 //Variable Timeout
		SuppliesResources = false
		StartingResources = 0
		InitToMaxResources = 0
		InitToMaxResourcesPVP = 0
		DropResourcesWhenDestroyed = false
		DropResourcesWhenRemoved = false
	}
	JS_StunDisablingStorageDrain
	{
		Type = ResourceConverter
		OperationalToggle = JS_JaniDisableStorage_Stun
		FromStorage = JS_JaniDisableStorage_Stun
		FromQuantity = 1
		MinFromQuantityForConversion = 1
		Interval = 0.25
	}
