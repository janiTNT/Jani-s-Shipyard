Part : <T3.rules>/Part
{
	NameKey = "Codex/NoText"
	//DescriptionKey = "Codex/NoText"
	ID = T.janiTNT.3b // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	IsRotateable = true
	
	FlipHRotate = [1, 0, 3, 2]
	FlipVRotate = [3, 2, 1, 0]

	EditorIcon
	{
		Texture = "./Data/ships/terran/corridor/icon.png"
		Size = [25, 25]
	}
	Components : ^/0/Components
	{
		Sprite
		{
			Type = Sprite
			Location = [0.5, 0.5]
			Layer = "sr"
			RandomDamageLevels
			[
				[//Default
					{File = "roof.png";NormalsFile = "roof_n4.png";Size = [1, 1]; UVRotation = 0}
				]
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints3.png"
			Size = [1, 1]
		}
	}
}