Part : <T1.rules>/Part
{
	NameKey = "Codex/NoText"
	//DescriptionKey = "Codex/NoText"
	ID = T.janiTNT.2 // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	IsRotateable = true
	
	EditorIcon
	{
		Texture = "./Data/ships/terran/corridor/icon.png"
		Size = [28, 28]
	}
	Components : ^/0/Components
	{
		Sprite
		{
			Type = Sprite
			Location = [0.5, 0.5]
			Layer = "sr"
			RandomDamageLevels
			[
				[//Default
					{File = "roof.png";NormalsFile = "roof_n2.png";Size = [1, 1]; UVRotation = 0}
				]
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints1.png"
			Size = [1, 1]
		}
	}
}