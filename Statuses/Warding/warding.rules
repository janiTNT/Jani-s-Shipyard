ID = janiTNT.warding
Layer = Tile
StatusCombineMode = CombineValue
/* ValueCombiner
{
	Type = SimpleValueCombiner
	Mode = Max
} */
ValueClampRange = [0, 1]
RemoveAtMinValue = true
TransferToUnderlyingOnPartDestroyed = true
TickInterval = 7.5 / (&/Simulation/PhysicsUpdatesPerSecond) // 0.25 at 30 physics update
//RequireValueRangeForTick = [350, Infinity]
MediaIntensityValueType = Interpolated
MediaIntensityInterpolationRange = [0, 0.99]
ClampMediaIntensity = false
/* SoftRepair
{
	RepairType = Simultaneous
	TargetValue = 0
	WorkPerValueChange = 0.02
	RegistrationValueRange = [350, infinity]
	DeregistrationValueBuffer = 150
} */
