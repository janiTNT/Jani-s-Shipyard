DamageResistances // TODO: FIX EXPLOSION RESISTANCE ON ARMOR
{
	default {
		MultiplyByStatusCount = false
		DivideByPartArea = true
		Resistance
		{
			BaseValue = 100%
			Modifiers
			[
				{
					Type = StatusRemap
					StatusType = janiTNT.warding
					ModificationMode = Multiply
					RemapFrom = [0, 1]
					RemapTo = [0, 1]
					Exponent = 0.75
				}
				/* {
					Type = StatusExponent
					StatusType = janiTNT.warding
					ValueType = Interpolated
					ModificationMode = Multiply
					Exponent = 0.95
				} */
				/* {
					Type = Status
					StatusType = janiTNT.warding
					ModificationMode = Multiply
					ValueType = Raw
				} */
			]
		}
	}
	explosive = &default
	salvage = &default
	thermal = &default
	heat = &default // semi unused 
	fire = &default
}
