PenetrationResistanceModifier
{
	ModificationMode = Multiply
	MultiplyByStatusCount = false
	DivideByPartArea = true
	Resistance
	{
		BaseValue = 100%
		Modifiers
		[
			/* {
				Type = StatusExponent
				StatusType = janiTNT.warding
				ValueType = Interpolated
				ModificationMode = Multiply
				Exponent = 1.5
			} */
			{
				Type = StatusRemap
				StatusType = janiTNT.warding
				ModificationMode = Multiply
				RemapFrom = [0, 1]
				RemapTo = [1, 16]
				Exponent = 0.75
			}
		]
	}
}
ValueModulators
{
	ContinueAfterFirstModulation = true
	Modulators
	[
		{
			Type = Constant
			AffectedValueRange = [0, infinity]
			Value = 0.01
			ModificationMode = Subtract
			ScaleByDeltaTime = true
		}
		{
			Type = Constant
			AffectedValueRange = [0, infinity]
			Value = 1.05
			ModificationMode = Divide
			ScaleByDeltaTime = true
		}
	]
}
ContinuousMediaEffects
[
	{
		Type = TileQuad
		DebugName = "Heat_Fancy"
		Sprite
		{
			Texture
			{
				File = "warding_noise.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			_maskTexture
			{
				File = "./Data/statuses/heat/single_tile_square_mask.png"
				MipLevels = max
				SampleMode = Linear
			}
			_noiseTexture2
			{
				File = "distorted.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			Shader = warding.shader
			_hotColor = [120, 204, 255, 255]
			_coldColor = [12, 20, 25, 0]
			_normalIntensity = 0.95
			TargetBlendMode
			{
				SourceRgbFactor = SourceAlpha
				DestRgbFactor = InverseSourceAlpha
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Surface2
		Inflate = 1
		FadeInTime = 0.15
		FadeOutTime = 0.5
		IsFancy = true
		IsFancyLight = true
		CaptureBackBuffer = true
		ColorOverIntensity
		[
			[0, 0, 0, 0]
			[255, 255, 255, 255]
		]
	}
	//Simple Version
	{
		Type = TileQuad
		DebugName = "Heat_Simple"
		Sprite
		{
			Texture
			{
				File = "warding_noise.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			_maskTexture
			{
				File = "./Data/statuses/heat/single_tile_square_mask.png"
				MipLevels = max
				SampleMode = Linear
			}
			_noiseTexture2
			{
				File = "./Data/common_effects/particles/noise_distorted_voronoi.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			Shader = warding_simple.shader
			_hotColor = [120, 204, 255, 255]
			_coldColor = [120, 152, 255, 0]
			_normalIntensity = 0.2
			TargetBlendMode
			{
				SourceRgbFactor = One
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Surface2
		Inflate = 0.5
		FadeInTime = 0
		FadeOutTime = 0.5
		IsSimpleOrSimpleLight = true
		ColorOverIntensity
		[
			[0, 0, 0, 0]
			[255, 255, 255, 255]
		]
	}
]