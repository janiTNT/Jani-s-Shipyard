]
ValueModulators
{
	Modulators
	[
		{
			Type = Constant
			AffectedValueRange = [0, infinity]
			Value = 15
			ModificationMode = Subtract
			ScaleByDeltaTime = true
		}
		// dissolve faster when part is scorched
		/* {
			Type = Constant
			AffectedValueRange = [-infinity, infinity]
			StatusFilter
			{
				StatusType = cosmoteer.scorched
				MinValue = 1
			}
			ModificationMode = Add
			Value = -1.5
		} */
	]
}
ContinuousMediaEffects
[
	{
		Type = TileQuad
		Sprite
		{
			Texture
			{
				File = "./data/statuses/heat/HeatNoise2.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			_maskTexture
			{
				//File = "./Data/common_effects/particles/wet_light_cookie.png"
				File = "./data/statuses/heat/single_tile_square_mask.png"
				MipLevels = max
				SampleMode = Linear
			}
			_noiseTexture2
			{
				File = "./data/statuses/heat/heatNoise.png"
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			Shader = "brimstone.shader"
			_hotColor = [255, 25, 70, 255]
			_coldColor = [255, 10, 15, 255]
			_normalIntensity = 0.6; //lower is more intense, 0.02 for ship
			TargetBlendMode
			{
				SourceRgbFactor = SourceAlpha
				DestRgbFactor = InverseSourceAlpha
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Surface2
		Inflate = 0.5
		FadeInTime = 0
		FadeOutTime = 0.5
		IsFancyLight = true
		CaptureBackBuffer = true
		ColorOverIntensity
		[
			[0, 0, 0, 0]
			[255, 255, 255, 255]
		]
    }
]