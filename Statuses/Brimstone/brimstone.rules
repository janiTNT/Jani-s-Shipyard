MAX_SCORCH_DAMAGE_PERCENT = 90%
DAMAGE_PER_TICK = 100

ID = janiTNT.Brimstone
Layer = Tile
StatusCombineMode = CombineValue
STATUS_TO_RESOURCE_RATIO = 1000
RESOURCE_TO_STATUS_RATIO = 1 / (&STATUS_TO_RESOURCE_RATIO)
ValueClampRange = [0, Infinity]
RemoveAtMinValue = true
TransferToUnderlyingOnPartDestroyed = true
TickInterval = 0.5
RequireValueRangeForTick = [500, Infinity]
MediaIntensityValueType = Interpolated
MediaIntensityInterpolationRange = [0, 700]
ClampMediaIntensity = false
//CrewSpeedFactor = [1, .1]
SoftRepair
{
	RepairType = Simultaneous
	TargetValue = 0
	WorkPerValueChange = 0.02
	RegistrationValueRange = [500, infinity]
	DeregistrationValueBuffer = 150
}
Diffusion
{
	Basis = 0
	SpeedFactor = 0.1
	MinDeltaThreshold = (&SpeedFactor) * 0.1
	EmptyCellSpeedFactor = 0.0015
	PartOutboundSpeedFactors
	{
		cosmoteer.structure = 4
		cosmoteer.structure_1x3_wedge = &cosmoteer.structure
		cosmoteer.structure_1x2_wedge = &cosmoteer.structure
		cosmoteer.structure_tri = &cosmoteer.structure
		cosmoteer.structure_wedge = &cosmoteer.structure
	}
}
DamageResistances
{
	default {
		MultiplyByStatusCount = false
		Resistance
		{
			BaseValue = -2%
			Modifiers
			[
				{
					Type = StatusExponent
					StatusType = janiTNT.Brimstone
					ValueType = Raw
					ModificationMode = Multiply
					Exponent = 0.75
				}
			]
		}
	}
	explosive = &default
	salvage = &default
}
PenetrationResistanceModifier
{
	ModificationMode = Multiply
	MultiplyByStatusCount = false
	Resistance
	{
		BaseValue = 1
		Modifiers
		[
			{
				Type = ScaledStatusExponent
				StatusType = janiTNT.Brimstone
				ValueType = Raw
				ModificationMode = Divide
				BaseStatusValue = 1
				Exponent = 0.5
				Scale = 1/150
			}
		]
	}
}
TickingEffects
[
	{
		Type = Damage
		Damage = 0
		DamageType = default
		DamagePerTileHealth
		{
			BaseValue = 1
			Modifiers
			[
				{
					Type = StatusRemap
					StatusType = janiTNT.Brimstone
					ModificationMode = Multiply
					RemapFrom = [500, 5000]
					RemapTo = [0, 1]
					Exponent = 2
				}
			]
		}
		Filter
		{
			Friendlies = true
			Neutrals = true
		}
	}
