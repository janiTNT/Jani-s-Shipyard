	Background_Structure_Small = "Pequena Estrutura de Fundo"
	Background_Structure_SmallIcon = "Estrutura de Fundo"
	Background_Structure = "Estrutura de Fundo"
	Background_StructureIcon = "Estrutura de Fundo"
	Background_StructureDesc = "Uma estrutura sem colisão, pode ser usada para atravessar outras naves, não pode ser colorida normalmente, mas dá para você escolher qual a cor quiser usar.\nTecnicamente sem massa."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	Background_Structure_Block = "Estrutura de Fundo em bloco"
	Background_Structure_BlockIcon = "Estrutura de F. Bloco"
	
	Background_Structure_Wedge = "Estrutura de Fundo em cunha"
	Background_Structure_WedgeIcon = "Estrutura de F. Cunha"
	
	Background_Structure_Gap = "Estrutura de Fundo em T"
	Background_Structure_GapIcon = "Estrutura de F. em T"
	
	BackgroundSteelFloor = "Chão de aço de Fundo"
	BackgroundSteelFloorIcon = "Chão de Fundo"
	BackgroundSteelFloorDesc = "Fundo de metal que pode ser usado como outra forma de partes de fundo. Útil pra decoração de hangares e etc. Não pode ser pintado normalmente Metal Flooring to be used as another background piece. useful for Hangar decoration and whatnot. While cannot be painted normally, you can choose any color to use.\nTechnically has zero weight."
	
	PowerPort = "Port de energia de partes Part Energy Port"
	PowerPortIcon = "Port de energia"
	PowerPortDesc = "Essa parte serve como centro de entrega de bateria pra partes especificas que não podem ser carregadas pela tripulação (Olhe a descrição dessas partes), ou partes similares.\n\n<s14><color r='80' g='80' b='220' a='255'>Jani's shipyard and DataDriven</color></s14>"
	
	ControlRoom1x1JANI = "Cabine de controle miniatura"
	ControlRoom1x1JANIIcon = "Cabine Mini"
	ControlRoom1x1JANIDesc = "Essa cabine miniatura permite a nave voar e coordenar suas armas, fornecendo <good>+12<image name='command_points' colored='true'/></good> Pontos de Comando."
	
	ControlRoom1x1KROOM = "Cabine de controle miniatura \"Kroom\""
	ControlRoom1x1KROOMIcon = "Cabine Kroom"
	ControlRoom1x1KROOMDesc = "Essa cabine miniatura fornece <good>+10<image name='command_points' colored='true'/></good> Pontos de comando. Quando operada, automaticamente transfere energia entre partes adjacente, tem uma cama e câmara de vácuo integrada pelo custo de pontos"\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Krooms Forge by Kroom.</color></s14>"
	
	ThrusterHuge4x4 = "Propulsor de Transportador 4x4"
	ThrusterHuge4x4Icon = "Propulsor Transportador (4)"
	ThrusterHuge4x4Desc = "Uma variação maior do propulsor gigante que pode impulsionar a nave com muito mais força mas tem mais tempo pra alcançãr propulsão máxima. estatísticas são baseada na area interna do propulsor. Salas dos motores afetam esses propulsores menos."
	
	
	ThrusterHuge5x5 = "Propulsor de Transportador 5x5"
	ThrusterHuge5x5Icon = "Propulsor Transportador (5)"
	ThrusterHuge5x5Desc = "Uma variação ainda maior do propulsor gigante que pode impulsionar a nave com mais do que dobro da força mas tem mais tempo pra alcançãr propulsão máxima. estatísticas são baseada na area interna do propulsor. Salas dos motores afetam esses propulsores menos."
	
	ThrusterHuge6x6 = "Propulsor de Transportador 6x6"
	ThrusterHuge6x6Icon = "Propulsor Transportador (6)"
	ThrusterHuge6x6Desc = "Uma variação maior ainda do propulsor gigante que pode impulsionar a nave com 4x mais força mas tem mais tempo pra alcançãr propulsão máxima. estatísticas são baseada na area interna do propulsor. Salas dos motores afetam esses propulsores menos."
	
	ThrusterHuge7x6 = "Propulsor de Transportador 7x6"
	ThrusterHuge7x6Icon = "Propulsor Transportador (7)"
	ThrusterHuge7x6Desc = "Uma variação maior ainda do propulsor gigante que pode impulsionar a nave com mais de 5x força mas tem mais tempo pra alcançãr propulsão máxima. tem portas alternativas. estatísticas são baseada na area interna do propulsor. Salas dos motores afetam esses propulsores menos."
	
	ThrusterHuge8x7 = "Propulsor de Transportador 8x7"
	ThrusterHuge8x7Icon = "Propulsor Transportador (8)"
	ThrusterHuge8x7Desc = "A maior variação de Propulsor de Transportador, tem ainda mais peformance por bloco, tem portas alternativas. Salas dos motores afetam esses propulsores menos."
	
	CRAM_Firingpiece = "Customizable Reaper Ammo Mega Cannon - Firing piece"
	CRAM_FiringpieceIcon = "CRAM Firing Piece"
	CRAM_FiringpieceDesc = "Main part of a CRAM cannon. requires both to be fully loaded and the cooldown to be finished. Higher firepower can be obtained from using gauge increasers or packers."
	
	CRAM_Barrel = "Custom Cannon Barrel"
	CRAM_BarrelIcon = "Barrel"
	CRAM_BarrelDesc = "Improves range and speed and accuracy of a CRAM cannon."
	
	CRAM_Barrel2 = "Custom Cannon Barrel Double Length"
	CRAM_Barrel2Icon = "Barrel 2x"
	CRAM_Barrel2Desc = "Extends a barrel by 2 blocks in a single block. double effect. (same per Length)"
	
	CRAM_barrelend = "Custom Cannon Barrel End"
	CRAM_barrelendIcon = "Barrel End"
	CRAM_barrelendDesc = "Decorative. looks better at the end and similar to a cosmoteer cannon."
	
	CRAM_HeavyBarrel = "Custom Cannon Heavy Barrel"
	CRAM_HeavyBarrelIcon = "Heavy Barrel"
	CRAM_HeavyBarrelDesc = "Double effect per barrel. higher hp."
	
	Cram_Connector = "Custom Cannon Connector"
	Cram_ConnectorIcon = "Connector"
	Cram_ConnectorDesc = "Connects to a block 2 blocks forwards. should eventually connect to a firing piece."
	
	Cram_ConnectorD = "Custom Cannon Connector Diagonal"
	Cram_ConnectorDIcon = "Connector D."
	Cram_ConnectorDDesc = "Connects to a block on the edge of the diagonal. should eventually connect to a firing piece."
	
	Cram_GaugeIncreaser = "CRAM Gauge Increase"
	Cram_GaugeIncreaserIcon = "Gauge Increase"
	Cram_GaugeIncreaserDesc = "Connects to the sides of a firing piece, or up to one gauge increaser in a straight line. increases the size of the barrel, affecting stats even ammo usage."
	
	Cram_Intake = "Custom Cannon Ammo Intake"
	Cram_IntakeIcon = "Intake"
	Cram_IntakeDesc = "Feeds Loaders remotely from a range. good for tight setups with no crew space."
	
	Cram_Loader1x = "Custom Cannon Chain loader"
	Cram_Loader1xIcon = "Chain Loader"
	Cram_Loader1xDesc = "Stores 20 bullets, functions like a chaingun magazine. high speed throughput. (10 bullets/s)"
	
	Cram_Loader3x = "Custom Cannon Loader"
	Cram_Loader3xIcon = "Loader"
	Cram_Loader3xDesc = "Stores 60 bullets, feeds ammo at a slowly but steady pace. (2 bullets/s)"
	
	Cram_Loader3xD = "Custom Cannon Dual Loader"
	Cram_Loader3xDIcon = "Dual Loader"
	Cram_Loader3xDDesc = "Stores 60 bullets, feeds ammo at a slowly but steady pace. Feeds the same speed on both sides, best used when both are in use."
	
	Cram_Packer1x = "CRAM Payload Packer"
	Cram_Packer1xIcon = "Packer"
	Cram_Packer1xDesc = "A alternative connector that houses 20 bullets that are consumed per shot,Increasing Health and penetration heavily, and damage slightly. Will direct effects forwards like a normal connector if full, The cannon will only fire once all packers are full. Cannot chain other Packers."
	
	Cram_Cooler1x = "Custom Cannon TurboCooler"
	Cram_Cooler1xIcon = "TurboCooler"
	Cram_Cooler1xDesc = "Connects only on the two diagonals. Reduces the cooldown of the CRAM cannon. requires power to function, Avoid staying on the room too long to avoid third degree burns."\
	"\n<gray><s10>Now You're 20% cooler</s10></gray>"
	
	
	
	
	ExplosiveChargeHAX = "DECONSTRUCTOR BOBM HUGE BOBM"
	ExplosiveChargeHAXIcon = "DECONSTRUCTOR DEV TOOL"
	
	MegaroidArmor1x1 = "Placas de Armadura Anciã"
	MegaroidArmor2_1x1 = "Placas de Armadura Alternada"
	MegaroidArmorWedge = "Armadura Anciã - Cunha"
	MegaroidArmorWedge1x2 = "Armadura Anciã - Cunha 1x2"
	MegaroidArmorDesc = "Armadura extremamente velha que tem pequena capacidade de se regenerar. O metal foi degradado por Séculos e não pode ser recuperado."
	MegaroidArmor2Desc = "Armadura extremamente velha que tem pequena capacidade de se regenerar. O metal foi degradado por Séculos e não pode ser recuperado. Segmentos alternativos que apenas se destruirão quando partes similars começarem."
	
	MegaroidArmorFDesc = ""
	MegaroidArmor3BDescDesc = ""
	
	MegaroidArmor_foundation_1x1 = "Rocha de Armadura Petrificada"
	MegaroidArmor_foundation_1x1B = "Rocha de Armadura Alternada"
	MegaroidArmor_foundation_1x1Desc = "Antigas Rochas extremamente fortes que tem pequena capacidade regenerativa. Mais forte de que Armadura Anciã, prevenindo partes críticas de se desconectarem. Partes exclusivas para chefões."
	MegaroidArmor_foundation_1x1BDesc = "Antigas Rochas extremamente fortes que tem pequena capacidade regenerativa. Mais forte de que Armadura Anciã, prevenindo partes críticas de se desconectarem. Partes exclusivas para chefões. Segmentos alternativos que apenas se destruirão quando partes similars começarem."
	
	MegaroidBallweapon = "Esfera Luminosa"
	MegaroidBallweaponDesc = "Poderosas esferas místicas que atiram em intrusos que sobrevoarem muito próximos dos hiperoides."
	MegaroidBallWeaponLarge = "Esfera Luminosa Zeta"
	MegaroidBallWeaponLargeDesc = "Uma esfera maior com um disparo potente que ajuda a afastar os indesejados."
	MegaroidBallWeaponLarge_Rapid = "Esfera Luminosa Raga"
	MegaroidBallWeaponLarge_RapidDesc = "Uma esfera larga com ataques de rajadas rápidas."
	MegaroidBallWeaponLargerer = "Esfera Luminosa Zenith"
	MegaroidBallWeaponLargererDesc = "Esfera gigante com recarga lenta e disparo de projéteis com potência nuclear."
	
	MegashieldSmall = "Projetor de Escudo Ancião"
	MegashieldSmallDesc = "Um escudo autoregenerativo construído para proteger os guardiões. Uma runa pequena brilha nele."
	MegashieldAdvancedSmall = "Projetor de Escudo Ancião Avançado"
	MegashieldAdvancedSmallDesc = "Uma variante altamente defensiva para proteger os guardiões."
	
	MegaSigilSmall = "Pequena Runa de Controle"
	MegaSigilSmallDesc = "A runa talhada energiza esta nave automatizada, possivelmente criada para proteger estes hiperoides até que outras naves surjam para minerá-los.Embora estes protejam algo para uma civilização que nunca virá...\nDestruir isso causa uma reação em cadeia na nave inteira\nNão é recomendado entrar em combate próximo."
	
	MegaroidThrustCR = "Propulsor Ancião"
	MegaroidThrustCRDesc = "Maquina misteriosa de propulsores antigo. Como isso consegue voar é um misterio, sem sorte pra recriar os efeitos.\n<gray>contêm um tripulante escondido pra logica do jogo.</gray>"
	
	MegaroidMonoThrustCR = "Propulsor Ancião"
	MegaroidMonoThrustCRDesc = "Uma versão do propulsor com maior velocidade, mas funciona mais como um propulsor genérico. Pode impulsionar apenas em uma direção.\n<gray>Contém tripulante oculto.</gray>"
	
	MegaroidWeakpoint = "Ponto Fraco do Boss"
	MegaroidWeakpointDesc = "Você precisa destruir isso para desativar partes sobrecarregadas do Boss Cosmilite. Normalmente desativa escudos ou reduz a cadência de disparo de algumas armas."
	
	MegaroidEmpty = "Bloco Oculto Vazio"
	MegaroidEmptyDesc = "Sem Colisão e usado para criar partes flutuantes. Tecnicamente sem peso."
	
	MegaroidBallweaponWall_Blaster = "Esfera atira-paredes"
	MegaroidBallweaponThumperWall_BlasterDesc = "Atira paredes espectrais que travam movimento estilo Lançadores de Batedores."
	
	MegaroidArmor3_1x1 = "Cosmilite Armor Plating"
	MegaroidArmor3_4x1 = "Cosmilite Armor Plating (Wide)"
	MegaroidArmor3Desc = "Centuries-old huge bricks of extremely tough armor that have minor regenerative capabilities. Some of the metal can be salvaged.. A small difference in internal structure appears to cause the part to only chain react when one of its similar parts had begun reacting."
	
	MegaSigilCosmiliteBoss = "Supreme Control Sigil (Cosmic Boss)"
	MegaSigilCosmiliteBossDesc = "Heart of the boss ship. turns into a \"loot bag\" once destroyed.\nThe usual deathbolts and guadian attacks, combined with a extremly high penetration \"Devourer of gods\". Upon being scratched with any damage, may summon an even stronger \"DoG\" and deploys a shield.\n\n\n<bad>DO NOT SALVAGE. LOOT WILL NOT DROP, DESTROY FIRST</bad>"
	
	BossMissileweapon = "Missile Summoning Sigil"
	BossMissileweaponDesc = "Summons large homing missiles to swifly destroy ships attempting to defeat these massive ships.\nSpawns a additional missile on hit."
	
	MegaroidBallWeaponCosmiliteBoss = "Luminous Sphere (Cosmic)"
	MegaroidBallWeaponCosmiliteBossDesc = "Fires two similar Damaging and Tractor beams with opposite polarities at foes in a helix, After some time firing, fires a white superlaser.\n\nAt 60% health, Its beams focus down, Superlaser fire rate is increased, Can now fire a \"Deathbolts\" attack, that has very high penetration and damage.\nAt 30% health, Can summon portals that spawn Cosmic Guardians, Cosmic worms that can burrow into your ship and circle back.\nAfter destroyed, the rest of the front half of the ship crumbles to pieces."
	
	MegaroidCosmiliteLoot = "Boss Loot \"Bag\" (Cosmic)"
	MegaroidCosmiliteLootDesc = "Salvage this part to recover some rare resources and some stacks of Cosmilite. Build a factory with them and Profaned Star Cores to get a steady supply of Cosmilite."
	
	
	MegaSigilProfanedBoss = "Supreme Control Sigil (Profaned Boss)"
	MegaSigilProfanedBossDesc = "This Sigil is used to control this massive Boss ship. Destroying this sigil Causes the boss to initiate more attacks until there is only one sigil left. and that sigil will contain the actual loot.\nOnce a Sigil is down, the boss doubles the spawn rate of Mini Suns, and can now summon faster suns when on Flamethrower Phase.\nOnce only one sigil is left, Can now summon 6 even faster suns when on Beams attack.\nFor more info, read the description of the Sun.\nMay contain Divine Geodes. Build a altar with them and Pages of Annihilation to get a steady supply of Divine Geodes."
	
	
	MegaSigilProfanedBoss2 = "Supreme Control Sigil (Profaned Boss, With Loot)"
	MegaSigilProfanedBoss2Desc = "Last Sigil of the boss. Will now Drop a Loot orb on destruction.\nIf you need A Recap:\n\nOnce a Sigil is down, the boss doubles the spawn rate of Mini Suns, and can now summon faster suns when on Flamethrower Phase.\nOnce only one sigil is left, Can now summon 6 even faster suns when on Beams attack.\n\n<bad>DO NOT SALVAGE. LOOT WILL NOT DROP, DESTROY FIRST</bad>"
	
	MegaroidProfanedLoot = "Boss Loot \"Bag\" (Profaned)"
	MegaroidProfanedLootDesc = "Salvage this part to recover some rare resources and some stacks of Divine Geodes. Build a altar with them and Pages of Annihilation to get a steady supply of Divine Geodes."
	
	MegaroidArmor4_1x1 = "Profaned Armored Rock"
	MegaroidArmor4Desc = "Ancient extremly tough rock that have minor regenerative capabilities. Explodes into damaging flame projectiles on destruction."
	
	
	MegaroidBallWeaponProfanedBoss = "Miniaturized Weaponized Sun"
	MegaroidBallWeaponProfanedBossDesc = "Main Component of the Profaned Boss. Fires a spread of beams to slowly damage a ship, similar to sun damage zones. Periodically Summons miniature homing suns that deal extreme damage when collided.\nAfter a while, changes to a flamethrower phase where its Sigils are vulnerable and Thrusters off, yet has a strong forward attack that is easily dodgeable, but hard to tank, While also firing a spread of fireballs, some that heal you.\nOnce that Phase is over, it slowly fires two strong Holy Beams to force you to go back into the front of the ship. Extremly Deadly.\nFor more details, Read the description of the Sigil.\n\nPatically Indestructible."	
	
	MegaroidBallWeaponBarrage = "Luminous Sphere (Barrage)"
	MegaroidBallWeaponBarrageDesc = "Fires seven slow moving devastating bolts in a barrage. its advised to avoid them Altogether."
	
	MegaroidBallProfanedFlak = "Profaned Solar Flak"
	MegaroidBallProfanedFlakDesc = "Fires Solar balls to defend the boss from projectiles."
	
	MegaSigilBrimstoneBoss = "Supreme Control Sigil (Brimstone Boss)"
	MegaSigilBrimstoneBossDesc =  "t"
	
	BossNukeweapon = "Nuke Summoning Sigil"
	BossNukeweaponDesc = "A Variant of the missile sigil that fires super nukes (Shocking <image name='dahell'/> i know). fires a triple burst if only the boss sigil is alive."
	
	MegaroidBallweaponThumper = "Lançador de Bolas Batedoras"
	MegaroidBallweaponThumperDesc = "Atira projeteis que agem como barreiras físicas quando param perto do alvo."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Part Credit From: skipydog</color></s14>"
	MegaroidBallweaponThumperBurst = "Lançador Batedor em múltiplo"
	MegaroidBallweaponThumperBurstDesc = "Atira projeteis que agem como barreiras físicas quando param perto do alvo. Variante que atira em múltiplos de 4."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Part Credit From: skipydog</color></s14>"
	MegaroidBallweaponThumper_Frag = "Lançador Batedor em espingarda"
	MegaroidBallweaponThumper_FragDesc = "Atira projeteis que agem como barreiras físicas quando param perto do alvo. Variante com mais vida que atira em um combo forte de uma vez."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Part Credit From: skipydog</color></s14>"
	
	MegaSigilAstralBoss = "Supreme Control Sigil (Astral Boss)"
	MegaSigilAstralBossDesc = "<image name='dahell'/><image name='dahell'/><image name='dahell'/><image name='dahell'/><image name='dahell'/><image name='dahell'/><image name='dahell'/><image name='dahell'/>\n"
	
	MegaroidAstralLoot = "Boss Loot \"Bag\" (Astral)"
	MegaroidAstralLootDesc = "Salvage this part to recover some rare resources and some stacks of Astral Bars. Build a Factory with them and Cosmilite bars to get a steady supply of Astral Bars."
	
	MegaroidBallWeaponFringeBossBeam = "Luminous Sphere (Hyperbeam)"
	MegaroidBallWeaponFringeBossBeamDesc = "Aims for some time, stops rotating and gives  concentrated beam at that rotation."
	
	MegaroidBallWeaponFringeBossBarrage = "Luminous Sphere (Giga Barrage)"
	MegaroidBallWeaponFringeBossBarrageDesc = "Fires a cone of high damage extremly slow projectiles, along with some low damage fast laser bolts."
	
	MegaroidBallWeaponFringeBossCannon = "Luminous Sphere (TripleCannon)"
	MegaroidBallWeaponFringeBossCannonDesc = "High penetration High damage triple shot cannon projectiles"
	
	MegaroidBallWeaponFringeBossDrone = "Luminous Sphere (Stellaborn Burst)"
	MegaroidBallWeaponFringeBossDroneDesc = "Spawns Several Stellarborn \"drones\" to attack enemies with multiple ways.\n Can phase through the boss."
	
	MegaroidBallWeaponFringeBossLaser = "Luminous Sphere (Laser Barrage)"
	MegaroidBallWeaponFringeBossLaserDesc = "Fires several laser bolts followed by a bigger bolt."
	
	MegaroidBallWeaponFringeBossFireBlast = "Luminous Sphere (Fireblast)"
	MegaroidBallWeaponFringeBossFireBlastDesc = "Fires a homing slow projectile that eventually explodes into a circle of lasers in all directions. high damage if hit close.\n Can phase through the boss."
	
	MegaroidBallWeaponFringeBossMine = "Luminous Sphere (MineThrower)"
	MegaroidBallWeaponFringeBossMineDesc = "Launches some mines in the general direction. mines have homing projectiles and therefore are deadly."
	
	MegaroidBallWeaponFringeBossMissile = "Luminous Sphere (Missile Strike)"
	MegaroidBallWeaponFringeBossMissileDesc = "Fires a barrage of several missiles. missiles spawn missiles on hit.\n Can phase through the boss."
	
	CosmiliteFactory = "Cosmilite Bar Forge"
	CosmiliteFactoryIcon = "Cosmilite"
	CosmiliteFactoryDesc = "<image name='dahell'/>Forges and smashes bars of Cosmilite under extreme conditions. Consumes 4 Tristeel and 8 Hyperium per use. Requires Cosmilite to build, locking the obtaining of this resource only after you defeat and collect the loot of the \"Godslayer Guardian\" Boss in a Threat level 10+ system"
	
	ZetasphereFactory = "Zetasphere Compressor Forge"
	ZetasphereFactoryIcon = "Zetaspheres"
	ZetasphereFactoryDesc = "<image name='dahell'/>800 steel to 1 zetasphere"
	
	LogicWire = "Cabo de Lógica"
	LogicWireIcon = "Cabo"
	LogicWireDesc = "Transmite um sinal de lógica recebido pra outra parte na frente."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicWireDiag = "Cabo Diagonal de Lógica"
	LogicWireDiagIcon = "Cabo Diag."
	LogicWireDiagDesc = "Transmite um sinal de lógica recebido pra outra parte na diagonal."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicGateNot = "Porta Lógica NOT"
	LogicGateNotIcon = "Porta NOT"
	LogicGateNotDesc = "Transmite um sinal lógico se não tiver nenhum, Para de emitir um sinal se receber um sinal.\nPequeno delay."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicWireSplitter1 = "Cabo de Lógica Separador (180)"
	LogicWireSplitter1Icon = "Cabo Separ. [-]"
	LogicWireSplitter2 = "Cabo de Lógica Separador (90)"
	LogicWireSplitter2Icon = "Cabo Separ. [L]"
	LogicWireSplitter3 = "Cabo de Lógica Separador 3 Way"
	LogicWireSplitter3Icon = "Cabo Separ. [T]"
	LogicWireSplitterDesc = "Transmite um sinal recebido para mais de uma direção."\
