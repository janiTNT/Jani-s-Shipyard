	LargeFabricator = "Sintetizador de Placas de Gôldio"
	LargeFabricatorIcon = "Gôldio"
	LargeFabricatorDesc = "Sintetiza eletronicamente placas de gôldio na qual são usadas numa variedade de peças avançadas. Consome ouro. Ganha +25% de velocidade de produção para cada fábrica adjacente de qualquer tipo."
	LargeFabricatorOverclockDesc = "Aumenta muito a velocidade de fabricação. Produz calor enquanto fabrica Gôldio."
	GoldiumFactoryOverclock = "Sintetizador de Placas de Gôldio (Overclocking)"
	//"Manufactures steel plates, which are used to construct almost all ship parts. Consumes iron. Gains +25% production speed for each adjacent factory of any type."
	
	FactorySplitter = "[[LEGACY]]Building Material Resource Cutter"
	FactorySplitterIcon = "[[LEGACY]]Cutter"
	FactorySplitterDesc = "[[LEGACY]]Specialized Machine that cuts down building resources into smaller pieces in order to construct Ship Parts with more fractionary costs.\nFractional costs of cut materials may vary.\n\nWARNING due to a game bug,<bad>SWAPPING</bad> what resource to split or merge while it still has resources inside it will <bad>ERASE</bad> the resources.\n\nDue to another bug, you need to use resource managment in <bad>Manual tile selection</bad> OR use <bad>Supply Lines</bad>, as crew will <bad>NOT</bad> automatically supply or deliver resources to and from this part.\n\nCurrently can make tristeel doors and station armor, or split enriched uranium back into uranium. other materials are useless."
	
	FactorySplitterTristeel = "Cortador de Tri-Aço"
	FactorySplitterTristeelIcon = "Cortador de Tri-Aço"
	FactorySplitterTristeelDesc = "Máquina especializada que corta tri-aço em barras pequenas usadas na construção de várias peças patenteadas pela Jani. O processo pode ser facilmente revertido.\n\nDevido aos bugs, você terá que usar o gerenciamento de recursos na <bad>seleção de peças manual<bad> ou usar as <bad>linahs de suprimentos + mudar os botões de suprimento automático</bad>, assim a tripulação <bad>não irá</bad> automaticamente suprir ou entregar recursos para ou desta parte."
	
	FactorySplitterUranium = "Desenriquecedor de Urânio"
	FactorySplitterUraniumIcon = "Desenriq. Urânio."
	FactorySplitterUraniumDesc = "Uma variação do Cortador, esta máquina divide novamente o urânio enriquecido em quatro partes de urânio não-enriquecido. A produção é manual para evitar crash no jogo."
	
	FactoryElectronicCircuit = "Produtor de Circuitos Eletrônicos"
	FactoryElectronicCircuitIcon = "Circuitos"
	FactoryElectronicCircuitDesc = "Fabrica circuitos eletrônicos baratos, que são usados em diversas aplicações, desde drones a sistemas de controle de lógica e etc. Consome aço e bobinas. Ganha +25% de velocidade de produção para cada fábrica adjacente de qualquer tipo."
	FactoryElectronicCircuitOverclockDesc = "Amplifica significantemente a velocidade de produção e também gera calor enquanto produz os circuitos eletrônicos."

    FactoryElectronicCircuitOverclock = "Produtor de Circuitos Eletrônicos (Overclocking)"
	
	FactoryAdvancedCircuit = "Produtor de Circuitos Avançados"
	FactoryAdvancedCircuitIcon = "Adv. Circuitos"
	FactoryAdvancedCircuitDesc = "Fabrica circuitos avançados com alta capacidade de processamento, consome circuitos eletrônicos e hiperbobinas. Ganha +25% de velocidade de produção para cada fábrica adjacente de qualquer tipo."
	FactoryAdvancedCircuitOverclockDesc = "Amplifica significantemente a velocidade de produção e também gera calor enquanto produz os circuitos avançados."
	FactoryAdvancedCircuitOverclock = "Produtor de Circuitos Avançados (Overclocking)"
	
	TriSteelDoor = "Porta de Tri-Aço"
	TriSteelDoorIcon = "Porta de Tri-Aço"
	TriSteelDoorDesc = "Porta Decorativa, usa barras de tri-aço, por que não???"
	
	DecouplerBoomer = "Desacoplador"
	DecouplerBoomerIcon = "Desacoplador"
	DecouplerBoomerIconB = "Desacoplador (detonado)"
	DecouplerBoomerDesc = "Separador que divide uma seção facilmente da nave do que estava em sua frente.\n\nCtrl + Clique no Desacoplador para o selecionar e ativar.\nPode ser acionado também por um sinal lógico."
	DecouplerBoomerDescC = "Separador que divide uma seção facilmente da nave do que estava em sua frente.\n\nVersão com Corredor Andável.\n\nCtrl + Clique no Desacoplador para o selecionar e ativar.\nPode ser acionado também por um sinal lógico."
	DecouplerBoomerDescD = "Um Desacoplador detonado, não útil para nada."
	
	NormalSlope1C = "Roof normal map Slope (Corridor)"
	NormalSlope1CIcon = "Roof Slope C."
	NormalSlope1CDesc = "A decorative part that has a slope on the roof for decorative purposes."
	
	NormalSlope1A = "Roof normal map Slope (Armor)"
	NormalSlope1AIcon = "Roof Slope A."
	NormalSlope1ADesc = &NormalSlope1CDesc
	
	NormalSlope2C = "Roof normal map Slope Corner (Corridor)"
