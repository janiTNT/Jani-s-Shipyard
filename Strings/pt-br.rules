	CustomExplosivesActivator = "Detonador de Explosivos Customizados"
	CustomExplosivesActivatorIcon = "Detonador Customizado"
	CustomExplosivesActivatorDesc = "Dispositivo explosivo que amplia a sua explosão através da quantidade de explosivos customizados posicionados em suas proximidades. Um único detonador pode explodir se tiver mais do que um detonador na área de ampliação, e as explosões podem ser ampliadas com uma vasta gama de melhorias.\nTambém pode ser acionado por sinal lógico."
	
	CustomExplosives = "Carga de Explosivos Customizados"
	CustomExplosivesIcon = "Carga Customizada"
	CustomExplosivesDesc = "Dispositivos de detonação altamente explosiva unidos para causar uma explosão violenta através de um detonador.\n\n"
	
	CustomExplosivesNuclear = "Carga de Explosivos Nucleares Customizada"
	CustomExplosivesNuclearIcon = "Carga Nuclear"
	CustomExplosivesNuclearDesc = "Melhora a capacidade explosiva do detonador com uma carga nuclear. Requer ao menos oito explosivos customizados comuns e um detonador para funcionar."
	
	CrewQuartersLong = "Quarto longo 3x1 de Tripulação"
