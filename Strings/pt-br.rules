	LogicRoofPanelRoundIcon = "Painel Teto Ci."
	LogicRoofPanelRoundDesc = "Painel circular de luz usando as últimas tecnologia LED (Light Emitting Diode) (Que existiam há 300 anos.) Controlados por lógica. mas podem ser controlado manualmente."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicRoofPanelWedge = "Painel de Teto - Cunha"
	LogicRoofPanelWedgeIcon = "Painel Teto Cu."
	LogicRoofPanelWedgeDesc = "Pequeno painel triangular de luz usando as últimas tecnologia LED (Light Emitting Diode) (Que existiam há 300 anos.) Controlados por lógica. mas podem ser controlado manualmente."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicTBm = "Raio Trator de Lógica (Pequeno)"
	LogicTBmIcon = "RT. Lógico."
	LogicTBmDesc = "Uma versão modificado da turreta de um coletor de recursos que funciona como um pequeno raio trator controlado por lógica. pode ter um alvo ou ter uma direção fixa.\n<bad>Há nenhuma porta pra entrar, requer um port de energia.</bad>"
	
	Background_Dock_Underlay = "Doca de Estutura de fundo \"skipydog\" (Extendível)"
	Background_Dock_UnderlayIcon = "Doca Skipy E."
	Background_Dock_UnderlayDesc = "Uma doca de fundo que pode ligar ou desligar a colisão algums blocos de distancia. Útil pra fazer simples <good>Dobradiças</good> usando várias naves.\n Distancia e todas as cores podem ser customizadas."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	
	Background_Dock_Underlay_Logic = "Doca de Estrutura de fundo \"skipydog\" (Extendível) De lógica"
	Background_Dock_Underlay_LogicIcon = "Doca Skipy. E. L."
	Background_Dock_Underlay_LogicDesc = "Uma versão da doca \"skipydog\" que é controlada por lógica."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	
	Background_Dock = "Doca de Estutura de fundo \"skipydog\" (Grade)"
	Background_DockIcon = "Doca Skipy G."
	Background_DockDesc = "Uma doca de fundo que pode ligar ou desligar a colisão algums blocos de distancia. Útil pra fazer simples <good>Dobradiças</good> usando várias naves.\n todas as cores podem ser customizadas."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicPiston1x1 = "Pequeno pistão de lógica 1x1"
	LogicPiston1x1Icon = "Pistão Lógico (1)"
	LogicPiston1x1Desc = "Um pequeno dispositivo que pode extender ou não uma pequena placa pra fora. não pode empurrar blocos da sua própia nave, mas pode outras naves. Requer um sinal lógico ou inversão manual."
	
	LogicGateBulb = "Lâmpada alternadora Lógica"
	LogicGateBulbIcon = "Lâmpada Lógica"
	LogicGateBulbDesc = "Troca o seu sinal baseado se foi ligado ou se foi ativado manualmente. útil pra contadores binários e como um botão."
	
	ShieldOvercharger = "Artificial Zoltan Shield Overcharger"
	ShieldOverchargerIcon = "Zoltan S. Over."
	ShieldOverchargerDesc = "Generates a weak, extremly penetration resistant bubble shield that recharges quickly and can stack up to 5 layers. Recharge Rate reduces the more Overchargers are nearby."
	
	SylvanChainGun = "\"Rift Waker\" Travelling Merchant's Chaingun"
	SylvanChainGunIcon = "Rift Waker"
	SylvanChainGunDesc = "A modified, much much stronger variant of the chaingun. Uses less ammo, charges slightly slower, extremely resistant when closed, and deals double damage on top of firing two shots at once.\n\n<color r='85' g='43' b='122' a='255'>Heh.</color>"
	
	FTL_defenselaser = "Laser de Defesa"
	FTL_defenselaserIcon = "Laser de Defesa"
	FTL_defenselaserLeftIcon = "Laser de Defesa (L)"
	FTL_defenselaserDesc = "Um dos Lasers mais baratos no mercado, Uma fraca cópia de laser de rajadas. Não é tão potente assim. Não requer tripulantes."
	
	FTL_spetumbeam = "Mini Feixe 'Spetum'"
	FTL_spetumbeamIcon = "Feixe 'Spetum'"
	FTL_spetumbeamLeftIcon = "Feixe 'Spetum'(L)"
	FTL_spetumbeamDesc = "Um minúsculo feixe de rajada que causa um dano respeitável pelo seu tamanho, mas é meio ineficiente com o uso de energia. Não requer tripulantes."
	
	FTL_pikebeam = "Feixe Longo 'Pike'"
	FTL_pikebeamIcon = "Feixe 'Pike'"
	FTL_pikebeamLeftIcon = "Feixe 'Pike' (L)"
	FTL_pikebeamLEftALTIcon = "Feixe 'Pike' (S)"
	FTL_pikebeamDesc = "Um Feixe de longa distancia e duração com dano moderado, com pouca precisão como seu raio move para os lados um pouco."
	
	FTL_dirkpin = "Feixe á Ponta 'Dirk'"
	FTL_dirkpinIcon = "Ponta 'Dirk' "
	FTL_dirkpinLeftIcon = "Ponta 'Dirk' (L)"
	FTL_dirkpinDesc = "Um Feixe especial que acerta um lugar em um único pulso, espalhando dando extra para blocos conectados ao ser destruído, gasta mais energia. Não requer tripulantes."
	
	FTL_burstlaser1 = "Laser em Rajada MkI"
	FTL_burstlaser1Icon = "Laser em Rajada"
	FTL_burstlaser1LeftIcon = "Laser em Rajada (L)"
	FTL_burstlaser1Desc = "Uma alternativa melhor do que o Laser de Defesa, atira dois lasers numa rajada que causa mais dano, não é particulamente efetivo. Não requer tripulantes."
	
	FTL_burstlaser2 = "Laser em Rajada Mk II"
	FTL_burstlaser2Icon = "Rajada Mk2"
	FTL_burstlaser2LeftIcon = "Rajada (L)"
	FTL_burstlaser2LeftALTIcon = "Rajada (S)"
	FTL_burstlaser2Desc = "Um Laser em Rajada potente, atira 3 lasers rapidamente mas tem um tempo pra carregar. Não requer tripulantes."
	
	FTL_burstlaser3 = "Laser em Rajada III"
	FTL_burstlaser3Icon = "Rajada Mk3"
	FTL_burstlaser3LeftIcon = "Rajada Mk3 (L)"
	FTL_burstlaser3LeftALTIcon = "Rajada Mk3 (S)"
	FTL_burstlaser3Desc = "Um Laser em Rajada potente, atirando 5 lasers rapidamente, tendo maior eficiencia pra destruir areas vazias ou blindagem com pouca vida, vide seu dano splash prevenindo dano extra ser perdido e espalhando pra outros blocos se foi destruído."
	
	FTL_basicion = "Canhão Ion Básico"
	FTL_basicionIcon = "Ion Básico"
	FTL_basicionDesc = "Canhões de Ions agem parecido com Disruptores, mas drena energia com o tempo em vez de remover de uma vez. Tem 200 graus de rotação, compacto, Não requer tripulantes."
	
	FTL_ionbar1 = "Canhão Ions em barragem"
	FTL_ionbar1Icon = "Ion I"
	FTL_ionbar1Desc = "Canhões de Ions agem parecido com Disruptores, mas drena energia com o tempo em vez de remover de uma vez. causa um pequeno artodoamento e não causa nenhum dano."
	
	FTL_bombsmall = "Teleportador de bombas por Hiperpropulsão."
	FTL_bombsmallIcon = "Teleportador Bomb."
	FTL_bombsmallDesc = "Essa arma usa protótipos de hiperteleportes que permite teleportação de bombas diretamente para a frente do inimigo, sem utilizar Hipério. Não é eficiente comparado com outras formas de lançamento, mas não pode ser interceptado ou interrompido por núvems de flak\n Usa mísseis adicionais. Não requer tripulantes."
	
	FTL_bombbreach = "Teleportador de Minas de Brecha por Hiperpropulsão."
	FTL_bombbreachIcon = "Mina de Brecha"
	FTL_bombbreachDesc = "Avanços de teleportações de bombas permite teleportação de pequenas minas que pode invadir defesas mais facilmente com poder e penetração. não pode ser interceptado ou interrompido por núvems de flak\nUsa peças de minas adicionais."
	
	FTL_energy1 = "Canhão de energia MkI"
	FTL_energy1Icon = "Energia I"
	FTL_energy1Desc = "Canhões de energia são essentialmente uma combinação de Canhões de Ion e Lasers básicos, pelo custo de rotação, Cadência de disparo, precisão e artodoamento."
	
	FTL_missile_leto = "Lançador de Mísseis 'Leto'"
	FTL_missile_letoIcon = "Mísseis Leto"
	FTL_missile_letoLeftIcon = "Mísseis Leto (L)"
	FTL_missile_letoLeftALTIcon = "Mísseis Leto (S)"
	FTL_missile_letoDesc = "Esse lançador de mísseis minusculo usa pequenas quantidade de energia e partes de mísseis pra lançar um pequeno míssil. Esplosão barata, mas efetiva com o uso de Munição, tem uma leve teleguiação."
	
	FTL_particlelaser1 = "Canhão de Laser de Partícula"
	FTL_particlelaser1Icon = "Canh. Particlula"
	FTL_particlelaser1LeftIcon = "Canh. Particlula (L)"
	FTL_particlelaser1LeftALTIcon = "Canh. Particlula (S)"
	FTL_particlelaser1Desc = "Atira projéteis penetrantes que fritam componentes, causando maior parte do seu dano como o mesmo tipo de dano de ser fundida, levando partes pra falhar como se fossem queimadas.\nÚtil pra deixa uma nave menos danificada em algums casos. Tem o doubro de penetração para blindagem, e pode causar incêndios."
	
	PulseThrusterSmall = "Propulsor Repulsor pequeno"
	PulseThrusterSmallIcon = "Repulsor pequeno"
	PulseThrusterMed = "Propulsor Repulsor padrão"
	PulseThrusterMedIcon = "Repulsor padrão"
	PulseThrusterLarge = "Propulsor Repulsor Thruster"
	PulseThrusterLargeIcon = "Repulsor grande"
	PulseThrusterHuge = "Propulsor Repulsor Thruster"
	PulseThrusterHugeIcon = "Repulsor gigante"
	PulseThrustersDesc = "Versões ineficiente de propulsores que repele o espaço em si pra impulsionar de uma forma menos eficiente. Mas, esse design especial deixa usar mais espaço pra ser usado, que é extremamente útil pra proteger-los ou adicionar outra camada de propulsores."
	
	Pulse_ThrusterHuge4x4 = "Propulsor Repulsor Transportador 4x4"
	Pulse_ThrusterHuge4x4Icon = "Repulsor Transp. (4)"
	Pulse_ThrusterHuge4x4Desc = "Uma combinação de Repulsores e Propulsores Transportadores 4x4 Funciona como as versões combinadas, tendo espaco extendido e ineficiencia."
	Pulse_ThrusterHuge5x5 = "Propulsor Repulsor Transportador 5x5"
	Pulse_ThrusterHuge5x5Icon = "Repulsor Transp. (5)"
	Pulse_ThrusterHuge5x5Desc = "Uma combinação de Repulsores e Propulsores Transportadores 5x5 Funciona como as versões combinadas, tendo espaco extendido e ineficiencia."
	Pulse_ThrusterHuge6x6 = "Propulsor Repulsor Transportador 6x6"
	Pulse_ThrusterHuge6x6Icon = "Repulsor Transp. (6)"
	Pulse_ThrusterHuge6x6Desc = "Uma combinação de Repulsores e Propulsores Transportadores 6x6 Funciona como as versões combinadas, tendo espaco extendido e ineficiencia."
	Pulse_ThrusterHuge7x6 = "Propulsor Repulsor Transportador 7x6"
	Pulse_ThrusterHuge7x6Icon = "Repulsor Transp. (7)"
	Pulse_ThrusterHuge7x6Desc = "Uma combinação de Repulsores e Propulsores Transportadores 7x6 Funciona como as versões combinadas, tendo espaco extendido e ineficiencia."
	Pulse_ThrusterHuge8x7 = "Propulsor Repulsor Transportador 8x7"
	Pulse_ThrusterHuge8x7Icon = "Repulsor Transp. (8)"
	Pulse_ThrusterHuge8x7Desc = "Uma combinação de Repulsores e Propulsores Transportadores 8x7 Funciona como as versões combinadas, tendo espaco extendido e ineficiencia."
	
	//---------------------------------------------
	
	SuperheavyBrick = "Mini-Anchor Cosmic Weights"
	SuperheavyBrickIcon = "Cosmic Weights"
	SuperheavyBrickDesc = "Its just a 2000 ton 1x1 block that is very overpriced. uses some of the heaviest materials for the variety of uses this dead weight can do, such as show off how much weight your ship can push, or just pretend it can."
	
	//---------------------------------------------
	
	Logic_Sensor = "Sensor de inimigos LIDAR no teto"
	Logic_SensorIcon = "Sensor Inimigos LIDAR"
	Logic_SensorDesc = "Um sensor simples de lógica apenas capaz de detectar naves inimigas. A configuração de números define a distancia máxima de alcance e por padrão é 0 e detecta nada. Emite um sinal lógico se algum inimigo é visto na sua linha de vista e alcance, configurável como um prisma de íons.\n<gray>Era pra ter configuração para naves amigáveis, mas por mudanças do código do jogo não foi possivel adicionar essa funcionalidade.</gray>"\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	Logic_Comparator = "Value Comparator"
	Logic_ComparatorIcon = "Comparator"
	Logic_ComparatorDesc = "Can detect some signals from connected parts, Emits a logic signal if value is higher than zero, And emits out from the sides if the value is at 100%. Hover the selection types for technical information on detection."
	
	Logic_Comparator_Resources_Ammo = "Ammo Stockpile Comparator"
	Logic_Comparator_Resources_AmmoIcon = "Ammo Comparator"
	Logic_Comparator_Resources_Build = "Building Stockpile Comparator"
	Logic_Comparator_Resources_BuildIcon = "Building Comparator"
	Logic_Comparator_Resources_Modded = "Modded Stockpile Comparator"
	Logic_Comparator_Resources_ModdedIcon = "Modded Comparator"
	Logic_Comparator_Resources_Ore = "Ore Stockpile Comparator"
	Logic_Comparator_Resources_OreIcon = "Ore Comparator"
	Logic_Comparator_ResourcesDesc = "Can Detect the fullness of a specific resource within the connected block, emits a signal if any amount detected, and on the sides if full. Detection fashion works similar to inserters."
	
	Logic_Gauge_Comparator = "Precise Gauge Comparator"
	Logic_Gauge_ComparatorIcon = "Gauge Comparator"
	Logic_Gauge_ComparatorDesc = "Can detect some signals from connected parts, Emits a logic signal if detected value is higher the percentage configured. Number toggles signify percentage and has a range of 0-99%. Hover the selection types for technical information on detection."
	
	Logic_Gauge_Comparator_Resources_Ammo = "Ammo Stockpile Precise Gauge Comparator"
	Logic_Gauge_Comparator_Resources_AmmoIcon = "Ammo G. Comparator"
	Logic_Gauge_Comparator_Resources_Build = "Building Stockpile Precise Gauge Comparator"
	Logic_Gauge_Comparator_Resources_BuildIcon = "Building G. Comparator"
	Logic_Gauge_Comparator_Resources_Modded = "Modded Stockpile Precise Gauge Comparator"
	Logic_Gauge_Comparator_Resources_ModdedIcon = "Modded G. Comparator"
	Logic_Gauge_Comparator_Resources_Ore = "Ore Stockpile Precise Gauge Comparator"
	Logic_Gauge_Comparator_Resources_OreIcon = "Ore G. Comparator"
	Logic_Gauge_Comparator_ResourcesDesc = "Can Detect the fullness of a specific resource within the connected block. Emits a logic signal if detected value is higher the percentage configured. Detection fashion works similar to inserters."
	
	HeatPipeValveJani = "Heat Pipe Connection Control Valve"
	HeatPipeValveJaniIcon = "Heat Pipe Valve"
	HeatPipeValveJaniDesc = "Condiotionally transfers thermal energy between connected parts, Can be manually toggled to disable the connection between both sides after a short delay to turn the valve.\n If spawned toggled off, the network won't be detached for a entire second due to said delay."
	
	HeatPipeValveJaniTech = "<string id='Parts/HeatPipeValveJaniDesc'/>\n\nAlso comes with a logic variant."
	
	HeatPipeValveJaniLogic = "Logic controlled Heat Pipe Connection Control Valve"
	HeatPipeValveJaniLogicIcon = "L. Heat Pipe Valve"
	HeatPipeValveJaniLogicDesc = "Condiotionally transfers thermal energy between connected parts, Can be Logic controlled to disable the connection between both sides after a short delay to turn the valve.\n If spawned already receiving the logic buff, the network wont be toggled for a entire second due to said delay."
	
	LogicThrusterSmall = "Logic Small Thruster"
	LogicThrusterSmallIcon = "L. Small Thruster"
	LogicThrusterSmallDesc = "A Small Thruster modified to function using a logic signal instead of activating automatically with the ship's autopilot or your own piloting."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicThrusterMed = "Logic Med Thruster"
	LogicThrusterMedIcon = "L. Med Thruster"
	LogicThrusterMedDesc = "A Med Thruster modified to function using a logic signal instead of activating automatically with the ship's autopilot or your own piloting."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
