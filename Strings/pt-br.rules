	LogicRoofPanelSquare = "Painel de Teto - Quadrado"
	LogicRoofPanelSquareIcon = "Painel Teto Q."
	LogicRoofPanelSquareDesc = "Pequeno painel quadrado de luz usando as últimas tecnologia LED (Light Emitting Diode) (Que existiam há 300 anos.) Controlados por lógica. mas podem ser controlado manualmente."\
	"\n<s14><color r='80' g='80' b='220' a='255'>Ported From Advanced Ship Systems by skipydog.</color></s14>"
	
	LogicRoofPanelSquareLarge = "Painel de Teto - Quadrado Grande"
	LogicRoofPanelSquareLargeIcon = "Painel Teto Q. XL"
