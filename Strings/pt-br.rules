	InserterAmmoStack = "Transferidor em Massa de Munições"
	InserterAmmoStackIcon = "Transf. Massa [Munição]"
	InserterStackDesc = "Transferidoes em massa permitem transferencia de mesma capacidade do que uma pilha inteira de um recurso, mas apenas pilhas inteiras, Útil pra mover muitos recursos rapidamente, mas voltará o braço se o local estiver cheio."
	
