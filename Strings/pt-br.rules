	CrewQuartersLonger2 = "Quarto Melhorado de Tripulação"
	CrewQuartersLonger2Icon = "Quarto Melhor 4x"
	CrewQuartersLonger2Desc = "Suporta 14 tripulantes, e só há portas na área da frente."
	
	CrewQuartersOnebyOne = "Quarto Único de Tripulação"
	CrewQuartersOnebyOneIcon = "Quarto Único 1x"
	CrewQuartersOnebyOneDesc = "Quarto minúsculo que suporta uma única cama."
	
	//Radiator = "Radiador"
	//RadiatorIcon = "Radiador"
	//RadiatorDesc = "Faz refrigeração passiva e segura calor com radiadores que estejam conectados ou peças que aceitem calor.\n >O quão vermelho estiver, mais quente estará.<image name='dahell'/>"

	FusionReactorLarge = "Grande Reator de Fusão de Hipério"
	FusionReactorLargeIcon = "Rea. Fus."
	FusionReactorLargeDesc = "Um Reator de Fusão Massivo. Usa constantemente hipério. Consome muita energia ao convertê-lo ao plasma hipérico, e a partir disso começa a produzir energia.\n Produz grandes baterias de capacidade 6x. (Baseado no Mod Space Leviathans)\n\nRequer radiadores para resfriá-lo, e devido à falta de mecanismos de segurança, se você negligenciar a limite de calor o fará <bad>explodir</bad> se sobreaquecer.\n\n Barras Informativas de Progresso: Vermelho: Calor\n Roxo: Plasma"
	
	ReactorAux = "Reator Auxíliar"
	ReactorAuxIcon = "Rea. Aux."
	ReactorAuxDesc = "Um reator gerador de energia auxíliar barato.  Produz baterias de meia-capacidade,  permitindo a tripulação a caminhar com quase a velocidade de corredores pelo o reator.\nPara de produzir energia quando a nave está numa Núvem de Elétrons."
	
	MiningBeam = "Emissor de Laser de Mineração M1"
	MiningBeamIcon = "Emissor Laser Mineração M1"
	MiningBeamDesc = "Atira um Laser de Mineração através do convés, pode ser combinado com outros raios no Prisma de Energia M1.\n<s15><bad>Por limitações Técnicas requer acionamento manual se for reciclar ou minerar algo.</bad></s15>"
	MiningBeamTechDesc = "Sistema baseado em prismas no convés de mineração, houvendo alta eficiencia de combinação.\n<s15><bad>Por limitações Técnicas requer acionamento manual se for reciclar ou minerar algo.</bad></s15>"
	
	MiningPrism = "Prisma de Laser de Mineração M1"
	MiningPrismIcon = "Prisma de Mineração M1"
	MiningPrismDesc = "Prisma de Laser de mineração de Convés, similar ao Prisma de Emissor de Ions. Pode apenas usar os raios do Laser de Mineração M1.\n<s15><bad>Por limitações Técnicas requer acionamento manual se for reciclar ou minerar algo.</bad></s15>"
	
	Corridor_High = "High Corridor"
	Corridor_HighIcon = "Cor. High"
	Corridor_HighDesc = "Fancy High corridor that have 3 variations on appearance.\n\n <image name='sjaniwh'/>"
	
	StationArmor = "Armadura hiperdensa de Estação"
	StationArmorIcon = "[Estação] Armadura"
	StationArmorDesc = "Combinar armadura normal com tritânio traz uma durabilidade impressionante... Com o custo de ser <bad>extremamente pesado</bad> ao ponto de ser essencialmente bem mais útil em proteger estações ou partes muito importantes e sensíveis como os reatores."
	
