	CrewQuartersLongBigDesc = "Quarto massivo da Tripulação, suporta 22 tripulantes e tem muitas saídas.\nLEGACY PART"
	
	CrewQuartersLonger = "Quarto Alongado de Tripulação"
	CrewQuartersLongerIcon = "Quarto 4x"
