			&<Parts/BossRewards/Cursed/wand_small/wand_small.rules>/Part
			
			&<Parts/BossRewards/Cursed/Blood_Pipe_adaptative/heat_pipe_adaptive.rules>/Part
			&<Parts/BossRewards/Cursed/bloodgenerator/blood_generator.rules>/Part
		]
	}
	{	Action = AddMany

