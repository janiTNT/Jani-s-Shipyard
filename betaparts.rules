	{	Action = AddMany

		AddTo = "<builtin_ships/builtins.rules>/Ships"

		ManyToAdd
		[
 			{ File="Ships/Bosses/The Witch's Craft.ship.png"; Tags=[janibossship, janibossBrimstone] Tier=20;  Difficulty=3; }
			{ File="Ships/Bosses/Godslayer Guardian.ship.png"; Tags=[janibossship, janibossCosmilite] Tier=16;  Difficulty=3; }
			{ File="Ships/Bosses/Sol Profanatus.ship.png"; Tags=[janibossship, janibossProfaned] Tier=20;  Difficulty=3; }
