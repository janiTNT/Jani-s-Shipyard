Part : <./data/ships/base_part.rules>/Part
{
	Size = [1, 1]
	Density = 10
	MaxHealth = 160000 *4*4
	IsCrewSalvageable = false
	Flammable = false
	CreatePartPerTileWhenDestroyed = ""
	CreatePartPerTileWhenGrabbed = ""
	UnderlyingPartPerTile = ""
	AllowedDoorLocations = []
	IsRotateable = false
	IgnoreRotationForMirroredSelection = true
	CrewSpeedFactor = 0
	TypeCategories = [asteroid]
	InitialPenetrationResistance = 160 * 4^2
	ContinuingPenetrationResistance = 160 * 4^2

	SalvageProgressMediaEffectsTimeout = 1.5
	SalvageProgressMediaEffects
	[
		&<./data/ships/common/particles/salvage_progress_asteroid_quad.rules>
		
		: /BASE_SOUNDS/AudioExterior
		{
			Sound = "../common/sounds/asteroid_damage_loop.wav"
			Volume = 1.5
			SpeedOverIntensity = [0.5, 2] // Intensity over progress
			VolumeOverIntensity = 1
			RampUpTime = .2
			RampDownTime = .5
			MaxConcurrent = 0
			
			DynamicVolume
			{
				MinDistance = 0
				MaxDistance = 10
				DistanceFalloff = 2

				MinZoom = 1
				MaxZoom = 70
				ZoomFalloff = 5
			}
		}
	]

	Components : ^/0/Components
	{
		SalvagedEffects
		{
			Type = DeathEffects
			Location = [.5, .5]
			WhenSalvaged = true

			MediaEffects
			[
				&<salvage_complete_asteroid_pebbles.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/ships/common/sounds/asteroid_deconstruct_big_01.wav",
									"./data/ships/common/sounds/asteroid_deconstruct_big_02.wav",
									"./data/ships/common/sounds/asteroid_deconstruct_big_03.wav"]
					Volume = 1.2
					SpeedVariation = .1
				}
			]
		}
		
		DeathEffects : SalvagedEffects
		{
			WhenSalvaged = false
		}
	}
}