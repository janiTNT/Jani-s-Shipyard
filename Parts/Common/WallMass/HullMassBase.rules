Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/WallMass"
	IconNameKey = "Parts/WallMassIcon"
	ID = janiTNT.multiblock.wallmass
	EditorParentParts = [ "janiTNT.multiblock.wallmass" ]
	DescriptionKey = "Parts/WallMassDesc"
	Resources
	[
		[steel, 4]
	]
	AIValueFactor = 0
	Size = [1, 1]
	IsRotateable = false
	SelectionTypeID = "armor"
	MaxHealth = 1000
	TypeCategories = [armor]//trust
	Flammable = false
	CrewSpeedFactor = 0
	IsWalled = true
	IsSelfDestructible = false
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = true
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "floor1.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 500
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [.5, .5]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
	}
}