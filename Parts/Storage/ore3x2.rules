Part : <base3x2.rules>/Part
{
	NameKey = "Parts/AutoOStorage3x2"
	IconNameKey = "Parts/AutoOStorage3x2Icon"
	ID = janiTNT.AutoStorage_ore_3x2 // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroups []
	EditorParentParts = [ ["janiTNT.AutoStorage_ammo_3x2", -1] ]
	TypeCategories : ^/0/TypeCategories []
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "icon6.png"
			SampleMode = Linear
		}
		Size = [64, 42.66]
	}
	Components : ^/0/Components
	{

		OreType
		{
			Type = UIToggle
			ToggleID = "resource_conveyor_mode_ore"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		sulfurToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 0
		}
		sulfurComponents
		{
			Type = ToggledComponents
			Toggle = sulfurToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/sulfur.rules>/Components
		}
		
		ironToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 1
		}
		ironComponents
		{
			Type = ToggledComponents
			Toggle = ironToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/iron.rules>/Components
		}
		
		copperToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 2
		}
		copperComponents
		{
			Type = ToggledComponents
			Toggle = copperToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/copper.rules>/Components
		}
		
		tritaniumToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 3
		}
		tritaniumComponents
		{
			Type = ToggledComponents
			Toggle = tritaniumToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/tritanium.rules>/Components
		}
		
		carbonToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 4
		}
		carbonComponents
		{
			Type = ToggledComponents
			Toggle = carbonToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/carbon.rules>/Components
		}
		
		goldToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 5
		}
		goldComponents
		{
			Type = ToggledComponents
			Toggle = goldToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/gold.rules>/Components
		}
		
		uraniumToggle
		{
			Type = ModeToggle
			Mode = OreType
			OnMode = 6
		}
		uraniumComponents
		{
			Type = ToggledComponents
			Toggle = uraniumToggle
			IncludeInBlueprints = false
			Components = &<Types3x2/uranium.rules>/Components
		}
	}
}