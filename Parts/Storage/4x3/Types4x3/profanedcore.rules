Resource = &ResourceFile/ID
StackSize = &ResourceFile/MaxStackSize
ResourceFile = &<../../../../Resources/Profaned Core/profaned_core.rules>
Components
{	
	Consumer : &<hyperium.rules>/Components/Consumer
	{
		ResourceType = &~/Resource
		Storage = ProfanedStorage
	}
	
	ProfanedStorage : &<hyperium.rules>/Components/HyperiumStorage
	{
		ResourceType = &~/Resource
		MaxResources = (&~/StackSize) * (&<hyperium.rules>/StorageSize)
		ReceiveResourceMediaEffects = &~/ResourceFile/StackReceiveMediaEffects
		GiveResourceMediaEffects = &~/ResourceFile/StackPickupMediaEffects
	}
	
	FillSprites : &<hyperium.rules>/Components/FillSprites
	{
		RangeHigh = (&~/StackSize) * (&<hyperium.rules>/StorageSize) / 2
		ResourceStorage = ProfanedStorage
	}
	
	FillSprites2 : &<hyperium.rules>/Components/FillSprites2
	{
		RangeLow = (&~/StackSize) * (&<hyperium.rules>/StorageSize) / 2
		RangeHigh = (&~/StackSize) * (&<hyperium.rules>/StorageSize)
		ResourceStorage = ProfanedStorage
	}
	
	IconGraphics : &<hyperium.rules>/Components/IconGraphics
	{
		Floor
		{
			Layer = "doodads_low"
			DamageLevels
			[
				{
					File = "../../../../Resources/Profaned Core/stack5.png"
					Size = [1, 1]
				}
			]
		}
	}
}