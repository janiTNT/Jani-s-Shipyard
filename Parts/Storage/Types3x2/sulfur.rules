Resource = &ResourceFile/ID
StackSize = &ResourceFile/MaxStackSize
ResourceFile = &<./data/resources/sulfur/sulfur.rules>
Components
{	
	Consumer : &<hyperium.rules>/Components/Consumer
	{
		ResourceType = &~/Resource
		Storage = SulfurStorage
	}
	
	SulfurStorage : &<hyperium.rules>/Components/HyperiumStorage
	{
		ResourceType = &~/Resource
		MaxResources = (&~/StackSize) * (&<hyperium.rules>/StorageSize)
		ReceiveResourceMediaEffects = &~/ResourceFile/StackReceiveMediaEffects
		GiveResourceMediaEffects = &~/ResourceFile/StackPickupMediaEffects
	}
	
	FillSprites : &<hyperium.rules>/Components/FillSprites
	{
		ResourceStorage = SulfurStorage
	}
	
	IconGraphics : &<hyperium.rules>/Components/IconGraphics
	{
		Floor
		{
			Layer = "doodads_low"
			DamageLevels
			[
				{
					File = "./data/resources/sulfur/sulfur_stack_5.png"
					Size = [1, 1]
				}
			]
		}
	}
	
	DestroyedEffects2
	{
		Type = DeathEffects
		FactorHitEffectsWith = SulfurStorage
		HitEffects // Scaled with stack size.
		[
			{
				Type = ExplosiveDamage
				TotalDamage = { BaseValue = 6000* (&<hyperium.rules>/StorageSize); EffectScaleExponent = 1 }
				Radius = 3 + (((&<hyperium.rules>/StorageSize) ^ 0.5)/2)
				Delay = .05
				StatusType = cosmoteer.fire
				StatusChancePerNDamage = 50%
				StatusValue = 1
				StatusValueType = Interpolated
				NDamage = 1000
				CrewKillChance = 10%
				Filter
				{
					OperationalHealth = true
					StructuralHealth = false
					Friendlies = true
				}
			}
			{
				Type = ExplosiveDamage
				TotalDamage = { BaseValue = 1200 * (&<hyperium.rules>/StorageSize); EffectScaleExponent = 1 }
				Radius = 2 + (((&<hyperium.rules>/StorageSize) ^ 0.5)/2)
				Delay = .05
				Filter
				{
					OperationalHealth = false
					StructuralHealth = true
					Friendlies = true
					Crew = false
				}
			}
		]
		MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
		Location = &<hyperium.rules>/Components/IconGraphics/Location
	}
}