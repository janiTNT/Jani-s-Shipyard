Resource = janitnt.circuit3
StackSize = (&<../../../Resources/Circuits/processing_unit.rules>/MaxStackSize)
Components
{	
	Consumer : &<hyperium.rules>/Components/Consumer
	{
		ResourceType = &~/Resource
		Storage = ProcessingUnitStorage
	}
	
	ProcessingUnitStorage : &<hyperium.rules>/Components/HyperiumStorage
	{
		ResourceType = &~/Resource
		MaxResources = (&~/StackSize) * (&<hyperium.rules>/StorageSize)
		ReceiveResourceMediaEffects = &<./data/resources/coil/coil.rules>/StackReceiveMediaEffects
	}
	
	FillSprites : &<hyperium.rules>/Components/FillSprites
	{
		ResourceStorage = ProcessingUnitStorage
	}
	
	IconGraphics : &<hyperium.rules>/Components/IconGraphics
	{
		Floor
		{
			Layer = "doodads_low"
			DamageLevels
			[
				{
					File = "../../../Resources/Circuits/processing_unit_stack5.png"
					Size = [1, 1]
				}
			]
		}
	}
}