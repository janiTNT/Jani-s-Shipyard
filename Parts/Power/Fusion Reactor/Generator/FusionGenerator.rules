NO_COOLANT_PENALTY = 500%

Part : <./data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/PowerStorage"
	IconNameKey = "Parts/PowerStorageIcon"
	ID = janiTNT.reactorstorage // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	//EditorGroup = "Power"
	EditorParentParts = [ "janiTNT.FusionReactorLarge" ]
	DescriptionKey = "Parts/PowerStorageDesc"
	Resources
	[
		[steel, 32]
		[coil, 22]
	]
	Size = [3, 5]
	MaxHealth = 4000
	TypeCategories = [provides_power, storage]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "reactor_output_template.png"
			SampleMode = Linear
		}
		Size = [56, 56]
	}
	Components : ^/0/Components
	{
		Port_Fusion_Up0
		{
			Type = NetworkPort
			Types = [ fusionconfined, fusion_in ]
			CompatibleTypes = [ fusion_out, fusion_passthrough ]
			Location = [0,0]
			Direction = Up
			RouteSource = NetworkedFusionStorage
			RouteEndpoint = NetworkedFusionStorage  
			BlueprintRouteSource = BlueprintNetworkNode
			//BlueprintRouteEndpoint = BlueprintNetworkNode
			Overlay
			{
				OverlayIcon = "FusionPortIn"
				RouteLine = "FusionLine"
				DrawRouteHub = false
				RouteDrawMode = Connected
				IconDrawMode = Always
				ConnectedEdgeIcon = "FusionPortDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 0, 255, 61]
			}
		}
		Port_Fusion_Up1 : Port_Fusion_Up0
		{
			Location = [2,0]
		}
		
		Port_Fusion_Left0 : Port_Fusion_Up0
		{
			Location = [0,2]
			Direction = Left
			Types = [ fusionconfined, fusion_out ]
			CompatibleTypes = [ fusion_in, fusion_passthrough ]
			Overlay
			{
				OverlayIcon = "FusionPortOut"
				RouteLine = "FusionLine"
				DrawRouteHub = false
				RouteDrawMode = Connected
				IconDrawMode = Always
				ConnectedEdgeIcon = "FusionPortDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 0, 255, 61]
			}
		}
		Port_Fusion_Left1 : Port_Fusion_Left0
		{
			Location = [0,3]
		}
		
		Port_Fusion_Right0 : Port_Fusion_Left0
		{
			Location = [2,2]
			Direction = Right
		}
		Port_Fusion_Right1 : Port_Fusion_Right0
		{
			Location = [2,3]
		}
		
		Port_Fusion_Down : Port_Fusion_Left0
		{
			Location = [1,4]
			Direction = Down
		}
		
		Port_Coolant_Down0
		{
			Type = NetworkPort
			Types = [ hot_coolant_fusion ]
			Location = [0,4]
			Direction = Down
			RouteSource = NetworkHotCoolantSystemInput
			//RouteEndpoint = NetworkedFusionStorage  
			BlueprintRouteSource = BlueprintNetworkNodeCoolant
			//BlueprintRouteEndpoint = BlueprintNetworkNodeCoolant
			Overlay
			{
				OverlayIcon = "HotCoolantPortOut"
				RouteLine = "HotCoolantLine"
				DrawRouteHub = false
				RouteDrawMode = Never
				IconDrawMode = Always
				//ConnectedEdgeIcon = "FusionPortDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 0, 255, 61]
			}
		}
		Port_Coolant_Down1 : Port_Coolant_Down0
		{
			Location = [2,4]
		}
		
		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkedFusionStorage, NetworkFusionOutput, 0]
						[NetworkedFusionStorage, NetworkFusionOutput, 0]
						[NetworkedFusionStorage, NetworkFusionOutput, 0]
						[NetworkedFusionStorage, NetworkFusionOutput, 0]
						[NetworkHotCoolantOutput, NetworkFusionOutput, 0]
						[NetworkedHotCoolantReceiver, NetworkFusionOutput, 0]
					]
				}
			]
		}
		
		NetworkHotCoolantSystemInput
		{
			Type = NetworkResourceInput
			ResourceType = fake
			Mode = DistributeProportionallyByAvailable
			Categories = [ hot_coolant_fusion_storage ]
		}
		
		NetworkHotCoolantOutput
		{
			Type = NetworkResourceOutput
			ResourceType = fake
			Mode = DistributeProportionallyByAvailable
			Categories = [ hot_coolant_fusion_ultraheated ]
		}
		
		NetworkedHotCoolantReceiver
		{
			Type = NetworkResourceStore
			ResourceType = fake
			ResourceStorage = MultiCoolantStorage
			Categories = [ hot_coolant_fusion_ultraheated ]
		}
		
		OverflowHeatStorage : &<./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverflowHeatStorage
		{
			//ProvidedValuePerResource = (&<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO)
			ProvidedValuePerResource = ((&<../../Cooling Plant/bigplant.rules>/Part/Components/ConversionHeatProducer/HEAT_PER_INTERVAL)/(&<../../Cooling Plant/bigplant.rules>/Part/Components/ResourceConverter/From/1/Quantity)) * (&~/NO_COOLANT_PENALTY)
		}
	
		MultiCoolantStorage
		{
			Type = MultiResourceStorage
			ResourceType = fake
			ResourceStorages = [ NetworkHotCoolantSystemInput, OverflowHeatStorage ]
			AddMode = InOrder
			RemoveMode = InReverseOrder
		}
		
		OverheatEffects : &<./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverheatEffects
		{
			Location = [1.5, 2.5]
		}
		
		NetworkFusionOutput
		{
			Type = NetworkResourceOutput
			ResourceType = janitnt.reactorplasma
			Mode = DistributeProportionallyByAvailable
			Categories = [ fusion_receiver ]
		}
		
		BlueprintNetworkNodeCoolant = &BlueprintNetworkNode
		
		BlueprintNetworkNode
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
		
		NetworkedFusionStorage
		{
			Type = NetworkResourceStore
			ResourceType = janitnt.reactorplasma
			ResourceStorage = PlasmaStorage
			Categories = [ thermal_storage ]
		}
		
		PlasmaProgressBar
		{
			Type = ProgressBar
			//OperationalToggle = IsOperational
			ShowProgressFor = PlasmaStorage
			LowColor = [80, 25, 128]
			HighColor = [190, 50, 255]
			FullColor = [190, 130, 255]
			Height = 10
		}
		
		BatteryProgressBar
		{
			Type = ProgressBar
			//OperationalToggle = IsOperational
			ShowProgressFor = BatteryStorage
			LowColor = [0, 255, 40]
			HighColor = [0, 255, 0]
			FullColor = [52, 255, 52]
			Height = 5
		}

		PlasmaStorage
		{
			Type = ResourceStorage
			ResourceType = janitnt.reactorplasma
			MaxResources = 800 * 50
			InitToMaxResources = 0
			//IgnoreResourcesForInitToMax = true
		}
		
		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = PlasmaStorage
			From
			[
				{
					Storage = PlasmaStorage
					Quantity = 100 * 50
					MinQuantityForConversion = 100 * 50
				}
			]
			To
			[
				{
					Storage = BatteryStorage
					Quantity =  { BaseValue=6000; BuffType=ElectronDebuff; BuffMode=Multiply; }
					MinQuantityForConversion = { BaseValue=6000; BuffType=ElectronDebuff; BuffMode=Multiply; }
				}
			]
			//MinFromQuantityForConversion = 1000
			//PLEASE EDIT FOR STATS
			
			//heat = 2000 per second
			
			//ALSO EDIT EXPECTED AMMO GEN 
			Interval = .25
		}
		
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 8000 * 6
			StartingResources = 0
			SuppliesResources = true
			MinResourcesPickUp = 6000
			MaxResourcesPickUp = 6000
			InitPickUp = 5001
			PickUpRate = 1000 / 1.5
			ExpectedResourceGenerationRate = { BaseValue = 6000 / (&../../BatteryProducer/Interval); BuffType=ElectronDebuff; BuffMode=Multiply; }
			ExpectedResourceGenerationToggle = PlasmaStorage
			DropResourcesWhenDestroyed = false
			DropResourcesWhenRemoved = false
		}
		
		Graphics
		{
			Type = Graphics
			Location = [1.5, 2.5]
			//OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "reactor_output_template.png"
						Size = [3, 5]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "walls_stolen.png"
			UVRotation = 2
			Size = [3, 5]
		}
	}
	Stats
	{
		PowerGeneration = (&~/Part/Components/BatteryProducer/To/0/Quantity/BaseValue) / (&~/Part/Components/BatteryProducer/Interval) / 1000
		BatterySize = (&~/Part/Components/BatteryStorage/MaxResourcesPickUp) / 1000
		BatteryFillTime = 1000 / (&~/Part/Components/BatteryStorage/PickUpRate)
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
	}
}