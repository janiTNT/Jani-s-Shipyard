		PlasmaProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = BatteryStorage
					Quantity = 250
					MinQuantityForConversion = 250
				}
				{
					Storage = HyperiumSplitter
					Quantity = 1
				}
				{
					Storage = NetworkCoolantOutput
					Quantity = 100
					MinQuantityForConversion = 100
				}
			]
			To
			[
				{
					Storage = PlasmaGeneratingStorages
					Quantity = { BaseValue = (200 * 50); BuffType=FusionReactorConnectivityBuff; BuffMode=Multiply; }
				}
				{
					Storage = NetworkHotCoolantInput
					Quantity = 100
					MinQuantityForConversion = 100
				}
			]
			//MinFromQuantityForConversion = 1000
			//PLEASE EDIT FOR STATS
			
			//heat = 1000 per second
			
			//ALSO EDIT EXPECTED AMMO GEN 
			Interval = .25
		}
		
		PlasmaGeneratingStorages
		{
			Type = MultiResourceStorage
			ResourceType = janitnt.reactorplasma
			ResourceStorages = [ NetworkPlasmaInput, PlasmaStorage ]
			AddMode = InOrder
		}
		
