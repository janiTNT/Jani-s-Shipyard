				[2, 0]
				[2, 1]
				[2, 2]//OH GOD KILL ME KILL ME KILL AAHHHHH I'M IN HORRIBLE PAIN I HATE LIFE
				[2, 3]
				[2, 4]
				[2, 5]
				
				[3, 0]
				[3, 1]//AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
				[3, 2]
				[3, 3]
				[3, 4]
				[3, 5]
				
				[4, 0]
				[4, 1]
				[4, 2]
				[4, 3]
				[4, 4]
				[4, 5]
				
//				[5, 0]
				[5, 1]
				[5, 2]
				[5, 3]
				[5, 4]
//				[5, 5]
				//Hey i managed to do all of it! hooray!
			]
			Layer = "doodads_low"
			SpriteInset = [20/64, 20/64, 20/64, 20/64]
		}
		HyperiumConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = hyperium
			Storage = HyperiumStorage
			DefaultPriority = &/PRIORITIES/Ftl_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		HyperiumSplitter
		{
		    Type = InlineResourceConverter
		    ResourceType = hyperium
		    FromStorage = HyperiumStorage
		    FromQuantity = 1
		    ToQuantity = 800
		}
		
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 16000
			ToggleOnResources = 7001
			ToggleOffResources = 0
			DropResourcesWhenDestroyed = false
			DropResourcesWhenRemoved = false
		}
		//0 ammo = off
		//toggleon = invert, make false
		//if below 1000 invert again and make it supply again
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			//ResupplyThreshold = 7001
			//OperationalToggle = TurnOffRefeeding
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		
		NetworkPlasmaInput
		{
			Type = NetworkResourceInput
			ResourceType = janitnt.reactorplasma
			Mode = DistributeProportionallyByAvailable
		}
		
		BufferMover
		{
			Type = ResourceConverter
			OperationalToggle = PlasmaStorage
			From
			[
				{
					Storage = PlasmaStorage
					Quantity = { BaseValue = (200 * 50); BuffType=FusionReactorConnectivityBuff; BuffMode=Multiply; }
					MinQuantityForConversion = { BaseValue = (200 * 50); BuffType=FusionReactorConnectivityBuff; BuffMode=Multiply; }
				}
			]
			To
			[
				{
					Storage = NetworkPlasmaInput
					Quantity = { BaseValue = (200 * 50); BuffType=FusionReactorConnectivityBuff; BuffMode=Multiply; }
					MinQuantityForConversion = { BaseValue = (200 * 50); BuffType=FusionReactorConnectivityBuff; BuffMode=Multiply; }
				}
			]
			Interval = .25
		}
		
		PlasmaStorage
		{
			Type = ResourceStorage
			ResourceType = janitnt.reactorplasma
			MaxResources = 8000 * 50
			ToggleOnResources = 600 * 50
			ToggleOffResources = 0
			StartingResources = 0
			InitToMaxResources = 500 * 50
			InitToMaxResourcesPVP = 500 * 50
			DropResourcesWhenDestroyed = false
			DropResourcesWhenRemoved = false
		}
		
		HasPlasma
		{
			Type = MultiResourceStorage
			ResourceType = janitnt.reactorplasma
			ResourceStorages = [ PlasmaStorage ]
			ToggleOnResources = 1
			ToggleOffResources = 0
			DropResourcesWhenDestroyed = false
			DropResourcesWhenRemoved = false
		}
		
