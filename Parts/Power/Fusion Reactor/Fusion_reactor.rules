		DestroyedEffects2 // A separate destroyed effects for the base destruction that doesn't get scale with ammo.
		{
			Type = DeathEffects
			Location = [3, 3]
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
		}/* 
		OverheatTrigger
		{
			Type = ThresholdTrigger
			AmountFrom = &<./Data/ships/terran/base_part_terran_overclock.rules>/Part/HEAT_TARGET_STORAGE
			MinAmount = .94
		} */
		DestroyedEffects
		{
			Type = DeathEffects
			Location = [3, 3]
			FactorMediaEffectsIntensityWith = PlasmaStorage
			FactorHitEffectsWith = PlasmaStorage
			IncludeWhenUnderConstruction = false
			MediaEffects : &/JANI_COMMON/RadExplodeBig
			[
				&<./Data/ships/terran/reactor_large/particles/reactor_explode_flash_large.rules>
				&<./Data/common_effects/particles/explosions/big_part_explode_debris.rules>
				&<./Data/common_effects/particles/explosions/huge_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/ships/terran/reactor_large/destroyed/reactor_destroyed_01.wav", "./data/ships/terran/reactor_large/destroyed/reactor_destroyed_02.wav", "./data/ships/terran/reactor_large/destroyed/reactor_destroyed_03.wav"]
					Volume = 2
					Speed = 0.6
					SpeedVariation = .25 * (&Speed)
				}

				: /BASE_SHAKE
				{
					ShakeAmount = 80
					Duration = 5
				}
			]
			HitEffects
			[
				{
					Type = GridStatusApplication
					StatusType = cosmoteer.heat
					HitPartSourceRectType = Normal
					StatusValue = 0
					StatusValuePool
					{
						BaseValue = 80000 * 4 //Bonus Heat Application
						EffectScaleExponent = 1
					}
					MaxCost = 4 //higher range
					EmptyTileCost = Infinity
					ValueFalloff = 4
					FalloffPadding = 1
					Filter
					{
						Self = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = {BaseValue = 5000000, EffectScaleExponent = 1}
					Radius = {BaseValue = 80, EffectScaleExponent = 0.5} 
					//StrongerExplode
					Delay = 0.2
					ExpandDuration = 4
					ExpandStartRadius = 1
					ExpandLoss = 100%
					ImpulsePerNDamage = 10
					NDamage = 1000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = {BaseValue = 300000, EffectScaleExponent = 1}
					Radius = {BaseValue = 50, EffectScaleExponent = 0.5} 
					Delay = .5
					ExpandDuration = 4
					ExpandStartRadius = 2
					ExpandLoss = 100%
					ImpulsePerNDamage = 5
					NDamage = 1000
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]
		}
