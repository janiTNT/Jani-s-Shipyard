		BlueprintNetworkNodeFusion
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
		Port_Fusion_Up0
		{
			Type = NetworkPort
			Types = [ fusionconfined, fusion_out, fusion_passthrough ]
			CompatibleTypes = [ fusion_in, fusionconfined ]
			Location = [1,0]
			Direction = Up
			RouteSource = NetworkPlasmaInput
			RouteEndpoint = NetworkPlasmaInput  
			BlueprintRouteSource = BlueprintNetworkNodeFusion
			//BlueprintRouteEndpoint = BlueprintNetworkNodeFusion
			Overlay
			{
				OverlayIcon = "FusionPortPassThrough"
				RouteLine = "FusionLine"
				DrawRouteHub = false
				RouteDrawMode = Connected
				IconDrawMode = Always
				ConnectedEdgeIcon = "FusionPortDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 0, 255, 61]
			}
		}
		Port_Fusion_Up1 : Port_Fusion_Up0
		{
			Location = [4,0]
		}
		Port_Fusion_Down1 : Port_Fusion_Up0
		{
			Direction = Down
			Location = [1,5]
		}
		Port_Fusion_Down2 : Port_Fusion_Down1
		{
			Direction = Down
			Location = [4,5]
		}
		
