Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/CRAM_barrelend"
	IconNameKey = "Parts/CRAM_barrelendIcon"
	ID = janiTNT.CRAM_end // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	//OtherIDs = [big_cannon]
	EditorGroup = "WeaponsProjectile"
	DescriptionKey = "Parts/CRAM_barrelendDesc"
	Resources
	[
		[steel, 32]
	]
	TypeCategories = [CRAM_barrel, barrel_heavy, CRAM_barrel_slim]
	Size = [1, 1]
	UnderlyingPartPerTile = ""
	//PhysicalRect = [0, 1, 3, 2]
	//SaveRect = &PhysicalRec
	SelectionPriority = 1
	CreatePartPerTileWhenDestroyed = ""
	CreatePartPerTileWhenGrabbed = ""
	SelectionTypeByRotation = true
	Flammable = false
	SelectionTypeID = "cannons"
	AllowedContiguity = [Bottom]
		
	SalvageProgressMediaEffects
	CreateUnderlyingWhenDestroyed = false
	
	MaxHealth = 3000
	HealthType = Structural
	InitialPenetrationResistance = 0
	IsExternal = true
	ExternalWalls = [None]
	InternalWalls = [All]
	IsWalled = false
	ProhibitAbove = 2
	CrewSpeedFactor = 0
	ProhibitRects
	[
		[default, [-2, -2, 2, 3]]
		[default, [1, -2, 2, 3]]
	]
	ReceivableBuffs : ^/0/ReceivableBuffs [JaniCRAM_ReverseBarrelGauge]
	GenerateRectCollider = false
	/*AllowedDoorLocations
	[
		[-1, 1]
		[-1, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[3, 2]
		[3, 1]
	]*/
	AllowedDoorLocations = []
	EditorIcon
	{
		Texture
		{
			File = "BarrelEnd.png"
			SampleMode = Linear
		}
		Size = [80, 80]
	}
	Components : ^/0/Components
	{
		DistanceBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = JaniCRAM_BarrelMass
			BuffAmount = { BaseValue=2; BuffType=JaniCRAM_BarrelMass; BuffMode=Add; }
			BuffArea = [0, 1, 1, 1]
			//OperationalToggle = DistanceBuffToggle
			//ChainsFromBuffType = JaniCRAM_BarrelMass
			Criteria
			{
				Rot = 0
				Category = CRAM_barrel_slim
			}
		}
		
		EmitterProxy
		{
			Type = Graphics
			ChainedTo = Offset //we dont expect it to go here
		}
		
		PositionProxy
		{
			Type = ChainableProxy
			//Location = [0, 1]
			//ResourceType = bullet
			PartLocation = [0, 1]
			ComponentID = Offset
			PartCriteria
			{
				//Category = railgun_ammo
				Rot = 0
				Category = CRAM_barrel_slim
				//Left = 0
				//Right = 1
				//Top = 1
			}
		}
		
		Offset
		{
			Type = Graphics
			ChainedTo = PositionProxy
			Location = [0, -1]
			IncludeWhenUnderConstruction = false
		}
		
		HeavyBarrelConnection
		{
			Type = ComponentPresenceToggle
			PartLocation = [0, 1]
			ComponentID = PositionProxy
			PartCriteria
			{
				Category = barrel_heavy
				Rot = 0
			}
		}
		
