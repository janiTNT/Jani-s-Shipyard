ID = "janiTNT.burst1asershot_overclock"
Range = 210
IdealRange = [60, 200]
IdealRadius = [5, 50]
Speed = 190
ReceivableBuffs = [ElectronBuff]

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 300
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=2500; BuffType=ElectronBuff; BuffMode=Multiply; }
					Radius = { BaseValue=3; BuffType=ElectronBuff; BuffMode=Multiply; }
					Filter
					{
						Ships = true
						Shields = true
						Bullets = false
						Crew = false
					}
				}
				{
					Type = Impulse;
					Impulse = 2;
				}
			]
			
			MediaEffectsScale = 1.5
			MediaEffects
			[
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_hit.rules>
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_flash.rules>
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_sparks.rules>
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_spikes.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
					Volume = .4
					SpeedVariation = .4
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=600; BuffType=ElectronBuff; BuffMode=Multiply; }
				}
				{
					Type = Impulse;
					Impulse = 1;
				}
			]

			MediaEffectsScale = 0.75
			MediaEffects
			[
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_hit_struct.rules>
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_flash.rules>
				&<./data/shots/laser_bolt_small/particles/laser_bolt_small_sparks_struct.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
					Volume = .3
					SpeedVariation = .4
				}
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = AnimatedSprite
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "./data/shots/laser_bolt_small/laser_bolt_small.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.9, 1.9]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 60
		}
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [6.5, 6.5]
			VertexColor = [255, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
	
	MediaEffects
	{
		Type = MediaEffects
		Offset = [-0.02, 0]
		Rotation = 180d
		MediaEffectsScale = 0.25
		MediaEffects
		[
			: &/JANI_COMMON/TrailBase/Particles
			{
				Def : ^/0/Def
				{
					Updaters : ^/0/Updaters
					[
						{
							Type = Lifetime
							LifeInOut = life
							Lifetime = 0.2
							Name = Lifetime
							Enabled = true
							UpdateAfterInit = false
						}
						{
							Type = Operator
							DataType = Vector2
							AIn = location
							BIn = velocity
							ResultOut = location
							Operator = AddDt
							Name = "Apply velocity"
							Enabled = true
							UpdateAfterInit = false
						}
						{
							Type = Lerp
							LerpIn = life
							DataOut = color
							Invert = false
							ValueType = Color
							FromValue
							{
								Rf = 1
								Gf = 0.1
								Bf = 0.1
								Af = 0.5
							}
							ToValue
							{
								Rf = 0.8
								Gf = 0
								Bf = 0.8
								Af = 0
							}
							Name = ActualColorLerp
							Enabled = true
							UpdateAfterInit = true
						}
					]
					Renderer : ^/0/Renderer
					{
						BaseSize
						{
							X = 5
							Y = 1
						}
					}
				}
				EmitterDef : ^/0/EmitterDef
				{
					EmitPerSecond = 60
				}
			}
		]
	}
}