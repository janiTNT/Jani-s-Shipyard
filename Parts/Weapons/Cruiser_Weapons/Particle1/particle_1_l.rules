Part : <particle_1.rules>/Part
{
	NameKey = "Parts/FTL_particlelaser1"
	IconNameKey = "Parts/FTL_particlelaser1LeftIcon"
	ID = janiTNT.FTL_particle_lasermk1_L // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroups//null
	EditorParentParts = [ "janiTNT.FTL_particle_lasermk1" ]
	ProhibitRects
	[
		[fighter, [-1, -1, 1, 1]]// TO ENSURE COMPATIBILITY
	]
	EditorIcon
	{
		Texture
		{
			File = "icon_l.png"
			SampleMode = Linear
		}
		Size = [80, 160/3*(1/(1.125))]
	}
	Components : ^/0/Components
	{
		Collider  : &<particle_1.rules>/Part/Components/Collider
		{
			Type = CircleCollider
			Location = [.5, -0.5]
		}
		
		Turret : &<particle_1.rules>/Part/Components/Turret
		{
			Location = [.5, -0.5]
			Rotation = -180d
		}
		
		TurretHolder : &<particle_1.rules>/Part/Components/TurretHolder
		{
			Location = [.5, -.5]
		}
	}
}