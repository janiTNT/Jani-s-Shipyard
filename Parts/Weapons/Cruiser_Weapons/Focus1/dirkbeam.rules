Range = 200
IdealRange = 150
Width = .15 // smaller so it fits
HitEffectsScaleOverRange = [1, 1]
MediaEffectsScaleOverRange = [0.5, 0.5]
ReceivableBuffs = [ElectronBuff]

CrewCollisions = {Enemies=true; Junk=true}
HitCrew = &HitOperational

BeamMediaEffects
[
	// The beam itself.
	{
		Type = Beam
		BeamSprite
		{
			Texture
			{
				File = ./data/common_effects/particles/noise_gradient.png
				SampleMode = Linear
				MipLevels = max
				UVMode = Wrap
			}
			_noiseTexture
			{
				File = ./data/common_effects/particles/noise_voronoi.png
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			Shader = "./data/shots/ion_beam/ion_beam.shader"
			_extraBeginLength = 0.5
			_extraEndLength = 0.25
			_sizePulseFactor = 2
			_sizePulseInterval = .1
			_sizePulseUOffsetFactor = -.03
			_endCapSize = 4
			Size = [100%, 1.5]
			VertexColor = [255, 255, 255, 217]
			_baseColor = [1, 0, 0.53, 1]
			_halfHighlightColor = [0.5*1.25, 0.22*1.25, 0.21*1.25, 1]
			TargetBlendMode
			{
				SourceRgbFactor = InverseDestColor
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		FadeInTime = .02
		FadeOutTime = .35
		RandomTimeOffset = [0, 1]
		Bucket = IonBeam
	}

	// Beam lighting.
	{
		Type = Beam
		BeamSprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Shader = "./Data/common_effects/fancy_beam_light.shader"
			Size = [100%, 6]
			_extraBeginLength = (&Size/1) * 4
			_extraEndLength = (&Size/1) / 2
			VertexColor = [255, 0, 0, 255]
			_z = 0.4
			_litReflectiveStrength = 12
			_litAdditiveStrength = 0
			_unlitAdditiveStrength = 0.25
			_nrmlStrengthLimit = 1.0
			TargetBlendMode
			{
				SourceRgbFactor = InverseDestColor
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Upper4
		IsLight = true
		FadeInTime = .02
		FadeOutTime = .25
	}

	/*: /BASE_SOUNDS/AudioExterior
	{
		Sound = "./data/shots/ion_beam/ion_beam.wav"
		Volume = 1 * 6
		MaxConcurrent = 1
		MaxConcurrentVolume = 1
		RampUpTime = .25
		RampDownTime = .25

		DynamicVolume : ^/0/DynamicVolume
		{
			UseCustomShapeForDistance = true
		}
		DynamicFilter : ^/0/DynamicFilter
		{
			UseCustomShapeForDistance = true
		}
	}*/
]

HitShield = &HitOperational
HitOperational
{
	HitEffects
	[
		{
			Type = ExplosiveDamage
			TotalDamage = { BaseValue=1750; BuffType=ElectronBuff; BuffMode=Multiply; }
			Radius = { BaseValue=3; BuffType=ElectronBuff; BuffMode=Multiply; }
            Slices = 1
			DamageType = default
			Filter
			{
				OperationalHealth = true
				StructuralHealth = false
			}
		}
		{
			Type = Impulse
			Impulse = 20
			Filter
			{
				Friendlies = true
			}
		}
	]

	MediaEffects
	[
		&<./data/shots/ion_beam/particles/ion_beam_hit.rules>

		&<./data/shots/ion_beam/particles/ion_beam_hit_sparks.rules>

		&<./data/shots/ion_beam/particles/ion_beam_hit_spikes.rules>

		/*: /BASE_SOUNDS/AudioExterior
		{
			Sound = "./data/shots/ion_beam/ion_beam_hit.wav"
			Volume = .5 
			MaxConcurrent = 1
			MaxConcurrentVolume = 1
			RampUpTime = .25
			RampDownTime = .25
		}*/
		
		: /BASE_SOUNDS/AudioExterior
		{
			Sound = "./data/shots/laser_bolt_large/laser_bolt_large_hit.wav"
			Volume = .8
			Speed = 1.5
			SpeedVariation = .25
		}
		
		: /BASE_SOUNDS/AudioExterior
		{
			RandomSounds = ["./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
							"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
							"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
							"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
			Volume = 0.75
			Speed = .3
			SpeedVariation = .15
		}

		: /BASE_SHAKE
		{
			ShakeAmount = .05
			Duration = .5

			Filter
			{
				ExcludePartCategories = [ion_beam_prism]
			}
		}
	]
}

HitStructural
{
	HitEffects
	[
		{
			Type = Damage
			Damage = { BaseValue=1000; BuffType=ElectronBuff; BuffMode=Multiply; }
			Filter
			{
				OperationalHealth = false
				StructuralHealth = true
			}
		}
		{
			Type = Impulse
			Impulse = 10
		}
	]
}