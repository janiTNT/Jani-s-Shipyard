ID = "janiTNT.small_drone_laser"
Range = 200
IdealRange = 250
Speed = 250

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.15
		Density = 0.0001
		//LinearDamping = 4
	}

	Targetable
	{
		Type = Targetable
		Health = 200
		TargetCategory = "laser"
		
		OnDeath = &../Hit/HitFriendly
	}
	
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 20d
		Delay = 0
		ModifiesLinearVelocity = true
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational
		
		HitShield = &HitOperational
		HitOperational
		{
			HitEffects
			[	
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue=1000; BuffType=ElectronBuff; BuffMode=Multiply; }
					Radius = { BaseValue=1.5; BuffType=ElectronBuff; BuffMode=Multiply; }
					Slices = 1
					DamageType = default
				}
				{
					Type = Impulse;
					Impulse = 10;
				}
			]

			MediaEffects
			[
				&<./Data/shots/laser_bolt_small/particles/laser_bolt_small_sparks.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
					Volume = .3
					SpeedVariation = .4
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 3000
				}
				{
					Type = Impulse;
					Impulse = 5;
				}
			]

			MediaEffects
			[
				&<./Data/shots/laser_bolt_small/particles/laser_bolt_small_hit_struct.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
					Volume = .3
					SpeedVariation = .4
				}
			]
		}
		HitFriendly
		{
			MediaEffects
			[
				&<./Data/shots/laser_bolt_small/particles/laser_bolt_small_hit_struct.rules>
				
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav",
									"./data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"]
					Volume = .1
					SpeedVariation = .4
				}
			]
		}
		PenetratingOperational
		{
		}
		PenetratingStructural = &PenetratingOperational
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}
	Sprite1
	{
		Type = AnimatedSprite
		RenderBucket = BulletLower1
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "./data/shots/laser_bolt_small/laser_bolt_small.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.75, 1.75/1.5]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 80
		}
	}
	
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.15
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [5, 5]
			VertexColor = [255, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}
