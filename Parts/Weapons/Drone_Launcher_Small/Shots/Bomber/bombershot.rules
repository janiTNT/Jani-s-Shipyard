ID = "janiTNT.Bomber_bomb_small"
Range = 0
IdealRange = 0
Speed = 130

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = .15
		Density = 2
		LinearDamping = 0.2
		//AngularDamping = 1
		//CollidesWithBullets = true
		//FrameOfReferenceDuration = 0.1
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 5
		OnDeath
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = { BaseValue = 25000; EffectScaleExponent = 1 }
					Radius = 4
					ImpulsePerNDamage = 10
					NDamage = 500
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 8000
					Radius = 4
					ImpulsePerNDamage = 1
					NDamage = 500
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
					}
				}
			]

			MediaEffectsScale = 1
			MediaEffects
			[
				//&<./data/shots/missile_he/particles/missile_he_hit.rules>
				//&<./data/shots/missile_he/particles/missile_he_flash.rules>
				//&<./data/shots/missile_he/particles/missile_he_smoke.rules>
				
				&<./data/shots/bullet_deck/particles/bullet_hit_deck.rules>
				//&<./data/shots/bullet_deck/particles/bullet_hit_deck_sparks.rules>
				&<./data/shots/bullet_deck/particles/bullet_smoke_deck.rules>
				&<./data/shots/bullet_deck/particles/bullet_flash_deck.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./data/shots/missile_he/sounds/launcher_rocket_impact_01.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_02.wav",
									"./data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"]
					SpeedVariation = .1
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = .75
				}
			]
		}

	}

	Sprite
	{
		Type = Sprite
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "../../../Cruiser_weapons/Bomb1/bomb.png"
				MipLevels = max
			}
			Size = [1, 1]
		}

		NormalsTexture
		{
			File = "../../../Cruiser_weapons/Bomb1/bomb_n.png"
			MipLevels = max
		}
	}

	LightsSprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper1
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "./data/shots/missile_he/missile_he_light.png"
					MipLevels = max
					SampleMode = Linear
				}
				Size = [3, 3]
				TargetBlendMode = Add
			}
			FrameCount = 4
			FrameSize = [98, 98]
			FramesPerRow = 4
			FramesPerSecond = 60
		}
	}

	Targetable
	{
		Type = Targetable
		Health = 600
		TargetCategory = "missile"

		// No AOE damage when shot down.
		OnDeath = &../Hit/HitFriendly
	}

	Hit
	{
		Type = SimpleHit

		HitShield = &HitOperational
		HitOperational = &../DeathByLifetime/OnDeath
		HitStructural = &HitOperational

		HitFriendly  
		{
			MediaEffects = &../HitOperational/MediaEffects
		}
	}
}