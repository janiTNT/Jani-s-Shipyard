ID = "janiTNT.smallbomberdrone.1"
Range = &<basebomber.rules>/Range
IdealRange = &<basebomber.rules>/IdealRange
Speed = 20

Components : &<basebomber.rules>/Components
{
	Boostback
	{
		Type = Acceleration
		Acceleration = 0
	}
	Repulsion
	{
		Type = Acceleration
		Acceleration = 0
	}
	DeathByEnemyProximity : &<basebomber.rules>/Components/DeathByEnemyProximity
	{
		StartDelay = 3
		OnDeath : &<basebomber.rules>/Components/DeathByEnemyProximity/OnDeath
		{
			HitEffects : &<basebomber.rules>/Components/DeathByEnemyProximity/OnDeath/HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<bomber2.rules>
					Count = 1
					Spread = [0d, 0d]
					Arc = [0d, 0d]
					Distance = 0
					InheritVelocity = true
					HealthFactor = { BaseValue=1; EffectScaleExponent=1; }
				}
			]
			MediaEffects = &<basebomber.rules>/Components/DeathByEnemyProximity/OnDeath/MediaEffects
		}
	}
	Hit : &<basebomber.rules>/Components/Hit
	{
		SourcePartCollisionDelay = 1
	}
}