		CircuitGraphics
		{
			Type = Graphics
			Location = [1.5, 2]
			AnimationSpeedFactor = BeltSpeedFactor
			ResetAnimationTrigger = ResourceConverter
			OperationalDoodad
			{
				Layer = "walls" //Wall layer so the processor is show on top of the exit belt which use the doodad_low layer and under the crew sprite
				DamageLevels
				[
					{
						AnimationFiles
						[
							"advancedcircuit1.png"
							"advancedcircuit2.png"
							"advancedcircuit3.png"
							"advancedcircuit4.png"
							"advancedcircuit5.png"
							"advancedcircuit6.png"
							"advancedcircuit7.png"
							"advancedcircuit8.png"
							"advancedcircuit9.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.166666667 / 2
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
