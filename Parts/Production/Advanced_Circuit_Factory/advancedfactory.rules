OVERCLOCK
{
	HEAT_PER_CONVERSION = 500
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 125%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <./data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/FactoryAdvancedCircuit"
	IconNameKey = "Parts/FactoryAdvancedCircuitIcon"
	ID = janiTNT.advanced_circuit_factory // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Production"
	DescriptionKey = "Parts/FactoryAdvancedCircuitDesc"
	Resources
	[
		[steel, 84]
		[coil2, 18]
		[processor, 2]
	]
	Size = [3, 3]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 9000
	TypeCategories = [provides_advanced_circuit, uses_hypercoils, uses_coil2, uses_electronic_circuit, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	AllowedDoorLocations
	[
		//[-1, 1]
		[-1, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[3, 2]
		[3, 1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, Coil2Prereq, ElectronicCircuitStorage, BatteryStorage, NonJunkToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		Coil2Storage
		{
			Type = TypedResourceGrid
			ResourceType = coil2
			GridRect = [0, 2, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [15/64, 6/64, 2/64, 9/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}
		Coil2Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = coil2
			Storage = Coil2Storage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		ElectronicCircuitStorage
		{
			Type = TypedResourceGrid
			ResourceType = janitnt.circuit1
			GridRect = [2, 1, 1, 2]
			Layer = "doodads_low"
			SpriteInset = [2/64, 14/64, 8/64, 6/64]
			ToggleOnResources = 2
			ToggleOffResources = 0
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}

		ElectronicCircuitConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = janitnt.circuit1
			Storage = ElectronicCircuitStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		AdvancedCircuitStorage
		{
			Type = TypedResourceGrid
			ResourceType = janitnt.circuit2
			GridRect = [1, 2, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			RandomSpriteRotation = true
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}
		
		Coil2Prereq
		{
			Type = MultiToggle
			Toggles = [Coil2Storage, Coil2Splitter]
			Mode = Any
		}
		AnimationToggle
		{
			Type = MultiToggle
			Toggles = [Coil2Loader, ResourceConverter]
			Mode = Any
		}
		
		Coil2Loader
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = Coil2Storage
			FromQuantity = 1
			ToStorage = LoadedCoil2
			ToQuantity = 1
			Interval
			{
				BaseValue = 1
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		
		LoadedCoil2
		{
			Type = ResourceStorage
			OperationalToggle = IsOperational
			ResourceType = fake
			MaxResources = 1
		}
		Coil2Splitter
		{
		    Type = InlineResourceConverter
		    ResourceType = fake
		    FromStorage = LoadedCoil2
		    FromQuantity = 1
		    ToQuantity = 10
			ToggleOnResources = &../ResourceConverter/From/0/Quantity
			ToggleOffResources = (&ToggleOnResources) - 1
		}

		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
			    {
			        Storage = Coil2Splitter
			        Quantity = 1
			    }
			    {
			        Storage = ElectronicCircuitStorage
			        Quantity = 2
			    }
			    {
			        Storage = BatteryStorage
			        Quantity
			        {
			        	BaseValue = 500
			        	Modifiers
			        	[
			        		: ~/MODIFIERS/OVERCLOCK_LERP
			        		{
			        			MinValue = &../../BaseValue
			        			MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			        		}
			        	]
			        }
			        MinQuantityForConversion = 1
			    }
			]
			ToStorage = AdvancedCircuitStorage
			ToQuantity = 1
			Interval
			{
				BaseValue = 4
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}

		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [1.5, 1.5]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./data/ships/terran/factory_ammo/bullet_create.wav"
					Volume = .1
					Speed = 0.5
					SpeedVariation = .05
				}
			]
		}
		
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}

		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 2]
		}
		Port_Thermal_Down2 : Port_Thermal_Down0
		{
			Location = [2, 2]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [2, 1]
			Direction = Right
		}
		Port_Thermal_Right1 : Port_Thermal_Right0
		{
			Location = [2, 2]
			Direction = Right
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		BeltSpeedFactor
        {
        	Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
        }

		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			DoodadToggle = AnimationToggle
			AnimationSpeedFactor = BeltSpeedFactor
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 3]
					}
				]
			}
			ToggleOnDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				Offset = [-7/64, -0.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.125
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				Offset = [-7/64, -0.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				Offset = [-7/64, -0.5]
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [3, 3]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [-45/64, -43/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		CoilBeltAndRoboticArmGraphics
		{
			Type = Graphics
			Location = [.75, 2]
			ResetAnimationTrigger = Coil2Loader
			//OperationalToggle = CoilLoader
			AnimationSpeedFactor = BeltSpeedFactor
			OperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						AnimationFiles
						[
							"coil2belt2.png"
							"coil2belt3.png"
							"coil2belt4.png"
							"coil2belt5.png"
							"coil2belt6.png"
							"coil2belt7.png"
							"coil2belt8.png"
							"coil2belt9.png"
							"coil2belt10.png"
							"coil2belt11.png"
							"coil2belt12.png"
							"coil2belt13.png"
							"coil2belt14.png"
							"coil2belt15.png"
							"coil2belt1.png"
						]
						Size = [1, 2]
						AnimationInterval = 0.1
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			/* NonOperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						File = "coilbelt1.png"
						Size = [1, 2]
					}
				]
			} */
		}
		
		CircuitBeltAndRoboticArmGraphics
		{
			Type = Graphics
			Location = [2, 1]
			ResetAnimationTrigger = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			OperationalToggle = ResourceConverter
			OperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						AnimationFiles
						[
							"circuitbelt1.png"
							"circuitbelt2.png"
							"circuitbelt3.png"
							"circuitbelt4.png"
							"circuitbelt5.png"
							"circuitbelt6.png"
							"circuitbelt7.png"
							"circuitbelt8.png"
							"circuitbelt9.png"
							"circuitbelt1.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.1
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						File = "circuitbelt2.png"
						Size = [2, 2]
					}
				]
			}
		}

		Graphics2
		{
			Type = Graphics
			Location = [24/64, .5]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [109/64, 21/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		CircuitGraphics
		{
			Type = Graphics
			Location = [1.5, 2]
			AnimationSpeedFactor = BeltSpeedFactor
			ResetAnimationTrigger = ResourceConverter
			OperationalDoodad
			{
				Layer = "walls" //Wall layer so the processor is show on top of the exit belt which use the doodad_low layer and under the crew sprite
				DamageLevels
				[
					{
						AnimationFiles
						[
							"advancedcircuit1.png"
							"advancedcircuit2.png"
							"advancedcircuit3.png"
							"advancedcircuit4.png"
							"advancedcircuit5.png"
							"advancedcircuit6.png"
							"advancedcircuit7.png"
							"advancedcircuit8.png"
							"advancedcircuit9.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.166666667 / 2
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [1.5, 1.5]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof1.png"
						"./data/ships/terran/factory_coil/roof2.png"
						"./data/ships/terran/factory_coil/roof3.png"
						"./data/ships/terran/factory_coil/roof4.png"
						"./data/ships/terran/factory_coil/roof5.png"
						"./data/ships/terran/factory_coil/roof6.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals1.png"
						"./data/ships/terran/factory_coil/roof_normals2.png"
						"./data/ships/terran/factory_coil/roof_normals3.png"
						"./data/ships/terran/factory_coil/roof_normals4.png"
						"./data/ships/terran/factory_coil/roof_normals5.png"
						"./data/ships/terran/factory_coil/roof_normals6.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof1_33.png"
						"./data/ships/terran/factory_coil/roof2_33.png"
						"./data/ships/terran/factory_coil/roof3_33.png"
						"./data/ships/terran/factory_coil/roof4_33.png"
						"./data/ships/terran/factory_coil/roof5_33.png"
						"./data/ships/terran/factory_coil/roof6_33.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals1_33.png"
						"./data/ships/terran/factory_coil/roof_normals2_33.png"
						"./data/ships/terran/factory_coil/roof_normals3_33.png"
						"./data/ships/terran/factory_coil/roof_normals4_33.png"
						"./data/ships/terran/factory_coil/roof_normals5_33.png"
						"./data/ships/terran/factory_coil/roof_normals6_33.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof1_66.png"
						"./data/ships/terran/factory_coil/roof2_66.png"
						"./data/ships/terran/factory_coil/roof3_66.png"
						"./data/ships/terran/factory_coil/roof4_66.png"
						"./data/ships/terran/factory_coil/roof5_66.png"
						"./data/ships/terran/factory_coil/roof6_66.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals1_66.png"
						"./data/ships/terran/factory_coil/roof_normals2_66.png"
						"./data/ships/terran/factory_coil/roof_normals3_66.png"
						"./data/ships/terran/factory_coil/roof_normals4_66.png"
						"./data/ships/terran/factory_coil/roof_normals5_66.png"
						"./data/ships/terran/factory_coil/roof_normals6_66.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
			]
			ClosedDamageLevels
			[
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof6.png"
						"./data/ships/terran/factory_coil/roof5.png"
						"./data/ships/terran/factory_coil/roof4.png"
						"./data/ships/terran/factory_coil/roof3.png"
						"./data/ships/terran/factory_coil/roof2.png"
						"./data/ships/terran/factory_coil/roof1.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals6.png"
						"./data/ships/terran/factory_coil/roof_normals5.png"
						"./data/ships/terran/factory_coil/roof_normals4.png"
						"./data/ships/terran/factory_coil/roof_normals3.png"
						"./data/ships/terran/factory_coil/roof_normals2.png"
						"./data/ships/terran/factory_coil/roof_normals1.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof6_33.png"
						"./data/ships/terran/factory_coil/roof5_33.png"
						"./data/ships/terran/factory_coil/roof4_33.png"
						"./data/ships/terran/factory_coil/roof3_33.png"
						"./data/ships/terran/factory_coil/roof2_33.png"
						"./data/ships/terran/factory_coil/roof1_33.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals6_33.png"
						"./data/ships/terran/factory_coil/roof_normals5_33.png"
						"./data/ships/terran/factory_coil/roof_normals4_33.png"
						"./data/ships/terran/factory_coil/roof_normals3_33.png"
						"./data/ships/terran/factory_coil/roof_normals2_33.png"
						"./data/ships/terran/factory_coil/roof_normals1_33.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
				{
					AnimationFiles
					[
						"./data/ships/terran/factory_coil/roof6_66.png"
						"./data/ships/terran/factory_coil/roof5_66.png"
						"./data/ships/terran/factory_coil/roof4_66.png"
						"./data/ships/terran/factory_coil/roof3_66.png"
						"./data/ships/terran/factory_coil/roof2_66.png"
						"./data/ships/terran/factory_coil/roof1_66.png"
					]
					NormalsAnimationFiles
					[
						"./data/ships/terran/factory_coil/roof_normals6_66.png"
						"./data/ships/terran/factory_coil/roof_normals5_66.png"
						"./data/ships/terran/factory_coil/roof_normals4_66.png"
						"./data/ships/terran/factory_coil/roof_normals3_66.png"
						"./data/ships/terran/factory_coil/roof_normals2_66.png"
						"./data/ships/terran/factory_coil/roof_normals1_66.png"
					]
					Size = [3, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
					MirrorU = true
				}
			]
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [1.5, 1.5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					OffSet = [0.75, -0.25]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
					OffSet = [0.75, -0.25]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
					OffSet = [0.75, -0.25]
				}
				{
					File = "batteries4.png"
					Size = [1, 1]
					OffSet = [0.75, -0.25]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// No coils.
				{
					Toggle = Coil2Prereq
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// No Circuits
				{
					Toggle = ElectronicCircuitStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}
		
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}
	}

	Stats
	{
		Interval = (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AdvancedCircuitProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&Interval)
		AdvancedCircuitCapacity = (&~/Part/Components/AdvancedCircuitStorage/GridRect/2) * (&~/Part/Components/AdvancedCircuitStorage/GridRect/3) * (&<../../../resources/Circuits/advanced_circuit.rules>/MaxStackSize)
		Coil2Capacity = (&~/Part/Components/Coil2Storage/GridRect/2) * (&~/Part/Components/Coil2Storage/GridRect/3) * (&<./Data/resources/coil2/coil2.rules>/MaxStackSize)
		Coil2PerCircuit = ((&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/Coil2Splitter/ToQuantity)) / (&~/Part/Components/ResourceConverter/ToQuantity) 
		Coil2PerSecond = ((&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/Coil2Splitter/ToQuantity)) / (&Interval) 
		AdvancedCircuitCoil2Usage = [&../Coil2PerCircuit, &../Coil2PerSecond]
		ElectronicCircuitCapacity = (&~/Part/Components/ElectronicCircuitStorage/GridRect/2) * (&~/Part/Components/ElectronicCircuitStorage/GridRect/3) * (&<../../../resources/Circuits/electronic_circuit.rules>/MaxStackSize)
		ElectronicCircuitPerAdvancedCircuit = (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity) 
		ElectronicCircuitPerSecond = (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&Interval) 
		AdvancedCircuitElectronicCircuitUsage = [&../ElectronicCircuitPerAdvancedCircuit, &../ElectronicCircuitPerSecond]
		PowerPerCircuit = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&Interval) / 1000
		AdvancedCircuitPowerUsage = [&../PowerPerCircuit, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/FactoryAdvancedCircuitOverclockDesc"
		Stats
		{
			AdvancedCircuitProduction = (&~/Part/Stats/AdvancedCircuitProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
			AdvancedCircuitCoil2Usage = [(&~/Part/Stats/AdvancedCircuitCoil2Usage/0), (&~/Part/Stats/AdvancedCircuitCoil2Usage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			AdvancedCircuitElectronicCircuitUsage = [(&~/Part/Stats/AdvancedCircuitElectronicCircuitUsage/0), (&~/Part/Stats/AdvancedCircuitElectronicCircuitUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			POWER_PER_ITEM = (&~/Part/Stats/AdvancedCircuitPowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			POWER_PER_SECOND = (&~/Part/Stats/AdvancedCircuitPowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
			AdvancedCircuitPowerUsage = [&../POWER_PER_ITEM, &../POWER_PER_SECOND]
			CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_ITEM = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR);
			AdvancedCircuitHeatGeneration = [&../HEAT_PER_ITEM, &../HEAT_PER_SECOND]
		}
	}
}

MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}