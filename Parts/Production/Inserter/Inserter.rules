OVERCLOCK = &<inserter_base.rules>/OVERCLOCK
Part : <./Data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/InserterAmmo"
	IconNameKey = "Parts/InserterAmmoIcon"
	ID = janiTNT.AmmoInserter // Part IDs  somthing something
	OtherIDs = [juanTNT.DroneAutoChute]//Heh.
	EditorGroups = ["Production"]
	DescriptionKey = "Parts/InserterDesc"
	Resources = &<inserter_base.rules>/Resources
	//sus
	Size = [1, 1]
	MaxHealth = 1000
	IsFlippable = true
	IsRotateable = true
	TypeCategories = [Inserter, uses_power, Port_IN, logic]
	ReceivableBuffs : ^/0/ReceivableBuffs [PowerportBuff, Logic, InserterSpeedBoost]
	AllowedDoorLocations
	[
		[-1, 0]
		//[0, 1]
		[1, 0]
	]
	//IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "Icon.png"
			SampleMode = Linear
		}
		Size = [32, 56]
	}
	Components : &<inserter_base.rules>/Components
	{
		AmmoType
		{
			Type = UIToggle
			ToggleID = "resource_conveyor_mode_ammo"
			Default = 1
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		hyperiumToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 0
		}
		hyperiumComponents
		{
			Type = ToggledComponents
			Toggle = hyperiumToggle
			IncludeInBlueprints = true
			Components = &<hyperium.rules>/Components
		}
		
		bulletToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 1
		}
		bulletComponents
		{
			Type = ToggledComponents
			Toggle = bulletToggle
			IncludeInBlueprints = true
			Components = &<bullet.rules>/Components
		}
		
		missile_part_heToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 2
		}
		missile_part_heComponents
		{
			Type = ToggledComponents
			Toggle = missile_part_heToggle
			IncludeInBlueprints = true
			Components = &<missile_part_he.rules>/Components
		}
		
		missile_part_empToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 3
		}
		missile_part_empComponents
		{
			Type = ToggledComponents
			Toggle = missile_part_empToggle
			IncludeInBlueprints = true
			Components = &<missile_part_emp.rules>/Components
		}
		
		missile_part_nukeToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 4
		}
		missile_part_nukeComponents
		{
			Type = ToggledComponents
			Toggle = missile_part_nukeToggle
			IncludeInBlueprints = true
			Components = &<missile_part_nuke.rules>/Components
		}
		
		mine_partToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 5
		}
		mine_partComponents
		{
			Type = ToggledComponents
			Toggle = mine_partToggle
			IncludeInBlueprints = true
			Components = &<mine_part.rules>/Components
		}
		
		missile_part_thermalToggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 6
		}
		missile_part_thermalComponents
		{
			Type = ToggledComponents
			Toggle = missile_part_thermalToggle
			IncludeInBlueprints = true
			Components = &<missile_part_thermal.rules>/Components
		}
		
		janitnt.circuit1Toggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 100
		}
		janitnt.circuit1Components
		{
			Type = ToggledComponents
			Toggle = janitnt.circuit1Toggle
			IncludeInBlueprints = true
			Components = &<electronic_circuit.rules>/Components
		}
		
		janitnt.circuit2Toggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 101
		}
		janitnt.circuit2Components
		{
			Type = ToggledComponents
			Toggle = janitnt.circuit2Toggle
			IncludeInBlueprints = true
			Components = &<advanced_circuit.rules>/Components
		}
		
		/* janitnt.circuit3Toggle
		{
			Type = ModeToggle
			Mode = AmmoType
			OnMode = 102
		}
		janitnt.circuit3Components
		{
			Type = ToggledComponents
			Toggle = janitnt.circuit3Toggle
			IncludeInBlueprints = true
			Components = &<processing_unit.rules>/Components
		} */
	}

	Stats
	{
		InserterPowerUsage = [&../PowerPerTransfer, &../PowerPerSecond]
		PowerPerTransfer = - (&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) / 1000
		PowerPerSecond = - (&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) / ((1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue))*2) / 1000
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		InserterHandSize = 1
		
		InserterSwingSpeed = [(1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)) * 2, 1/((1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)) * 2)]

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	//	EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
	//	HeatUsageContinuous = (&~/Part/Components/HeatDrain/FromQuantity) / (&~/Part/Components/HeatDrain/Interval) / 1000
	}
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/InserterBaseOverclock"
		Stats
		{
			HeatGeneration = (&~/OVERCLOCK/REGENERATION/RECHARGING_HEAT_PER_SECOND)
		}
		StatsByCategory
		[
			{
				NameKey = "StatCategories/InserterFastInsertion"
				Stats
				{
					InserterPowerUsage = [&../PowerPerTransfer, &../PowerPerSecond]
					PowerPerTransfer = - ((&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) * (&~/OVERCLOCK/SPEEDBOOST/POWER_FACTOR)) / 1000
					PowerPerSecond = - ((&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) * (&~/OVERCLOCK/SPEEDBOOST/POWER_FACTOR)) / ((1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)/(&~/OVERCLOCK/SPEEDBOOST/SPEED_FACTOR))*2) / 1000
					InserterSwingSpeed = [(1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)/(&~/OVERCLOCK/SPEEDBOOST/SPEED_FACTOR)) * 2, 1/((1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)/(&~/OVERCLOCK/SPEEDBOOST/SPEED_FACTOR)) * 2)]
				}
			}
			{
				NameKey = "StatCategories/InserterPowerRegeneration"
				Stats
				{
					PowerGeneration = - (&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) / (&~/OVERCLOCK/REGENERATION/RECHARGE_TIME_PER_SWING) / 1000
				}
			}
		]
	}
}