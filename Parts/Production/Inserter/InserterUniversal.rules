Part : <./Data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/Inserter"
	IconNameKey = "Parts/InserterIcon"
	ID = janiTNT.UnifiedInserter // Part IDs  somthing something
	DescriptionKey = "Parts/InserterDesc"
	EditorGroups = ["Production"]
	Resources = &<inserter_base.rules>/Resources
	//sus
	Size = [1, 1]
	MaxHealth = 1000
	IsFlippable = true
	IsRotateable = true
	TypeCategories = [Inserter, uses_power, Port_IN, logic]
	ReceivableBuffs : ^/0/ReceivableBuffs [PowerportBuff, Logic, InserterSpeedBoost]
	AllowedDoorLocations
	[
		[-1, 0]
		//[0, 1]
		[1, 0]
	]
	//IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "Icon.png"
			SampleMode = Linear
		}
		Size = [32, 56]
	}
	Components : &<inserter_base.rules>/Components
	{	
		MultiModeTypes
		{
			Type = UIToggle
			ToggleID = "resource_conveyor_category"
			Default = 2
		}
		ammoTypeToggle
		{
			Type = ModeToggle
			Mode = MultiModeTypes
			OnModes = [ 0 ]
		}
		buildTypeToggle
		{
			Type = ModeToggle
			Mode = MultiModeTypes
			OnModes = [ 1 ]
		}
		oreTypeToggle
		{
			Type = ModeToggle
			Mode = MultiModeTypes
			OnModes = [ 2 ]
		}
		AmmoType
		{
			Type = UIToggle
			//OperationalToggle = ammoTypeToggle
			ToggleID = "resource_conveyor_mode_ammo"
			Default = 1
			VisibilityToggle = ammoTypeToggle
		}
		BuildType
		{
			Type = UIToggle
			//OperationalToggle = buildTypeToggle
			ToggleID = "resource_conveyor_mode_material"
			Default = 0
			VisibilityToggle = buildTypeToggle
		}
		OreType
		{
			Type = UIToggle
			//OperationalToggle = oreTypeToggle
			ToggleID = "resource_conveyor_mode_ore"
			Default = 0
			VisibilityToggle = oreTypeToggle
		}

		steelToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 0
		}
		steelComponents
		{
			Type = ToggledComponents
			Toggle = steelToggle
			IncludeInBlueprints = true
			Components = &<steel.rules>/Components
		}
		
		coilToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 1
		}
		coilComponents
		{
			Type = ToggledComponents
			Toggle = coilToggle
			IncludeInBlueprints = true
			Components = &<coil.rules>/Components
		}
		
		coil2Toggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 2
		}
		coil2Components
		{
			Type = ToggledComponents
			Toggle = coil2Toggle
			IncludeInBlueprints = true
			Components = &<coil2.rules>/Components
		}
		
		tristeelToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 3
		}
		tristeelComponents
		{
			Type = ToggledComponents
			Toggle = tristeelToggle
			IncludeInBlueprints = true
			Components = &<tristeel.rules>/Components
		}
		
		diamondToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 4
		}
		diamondComponents
		{
			Type = ToggledComponents
			Toggle = diamondToggle
			IncludeInBlueprints = true
			Components = &<diamond.rules>/Components
		}
		
		processorToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 5
		}
		processorComponents
		{
			Type = ToggledComponents
			Toggle = processorToggle
			IncludeInBlueprints = true
			Components = &<processor.rules>/Components
		}
		
		enriched_uraniumToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 6
		}
		enriched_uraniumComponents
		{
			Type = ToggledComponents
			Toggle = enriched_uraniumToggle
			IncludeInBlueprints = true
			Components = &<enriched_uranium.rules>/Components
		}
		
		goldiumToggle
		{
			Type = ModeToggle
			Mode = BuildType
			OnMode = 7
		}
		goldiumComponents
		{
			Type = ToggledComponents
			Toggle = goldiumToggle
			IncludeInBlueprints = true
