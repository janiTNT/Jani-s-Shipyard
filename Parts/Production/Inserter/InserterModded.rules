Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/InserterModded"
	IconNameKey = "Parts/InserterModdedIcon"
	ID = janiTNT.ModdedInserter // Part IDs  somthing something
	EditorGroups []
	EditorParentParts = [ ["janiTNT.AmmoInserter", -1] ]
	DescriptionKey = "Parts/InserterDesc"
	Resources = &<inserter_base.rules>/Resources
	//sus
	Size = [1, 1]
	MaxHealth = 1000
	IsFlippable = true
	IsRotateable = true
	TypeCategories = [Inserter, uses_power, Port_IN, logic]
	ReceivableBuffs : ^/0/ReceivableBuffs [PowerportBuff, Logic]
	AllowedDoorLocations
	[
		[-1, 0]
		//[0, 1]
		[1, 0]
	]
	//IgnoreRotationForMirroredSelection = true
	EditorIcon
	{
		Texture
		{
			File = "Icon.png"
			SampleMode = Linear
		}
		Size = [32, 92]
	}
	Components : &<inserter_base.rules>/Components
	{	
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4//TROLLER
		}
		
		ModType
		{
			Type = UIToggle
			ToggleID = "resource_conveyor_mode_modded"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		
		cosmiliteToggle
		{
			Type = ModeToggle
			Mode = ModType
			OnMode = 0
		}
		cosmiliteComponents
		{
			Type = ToggledComponents
			Toggle = cosmiliteToggle
			IncludeInBlueprints = true
			Components = &<cosmilite.rules>/Components
		}
		
		astralToggle
		{
			Type = ModeToggle
			Mode = ModType
			OnMode = 1
		}
		astralComponents
		{
			Type = ToggledComponents
			Toggle = astralToggle
			IncludeInBlueprints = true
			Components = &<astral.rules>/Components
		}
		
		profanedcoreToggle
		{
			Type = ModeToggle
			Mode = ModType
			OnMode = 2
		}
		profanedcoreComponents
		{
			Type = ToggledComponents
			Toggle = profanedcoreToggle
			IncludeInBlueprints = true
			Components = &<profanedcore.rules>/Components
		}
		
		cursedpagesToggle
		{
			Type = ModeToggle
			Mode = ModType
			OnMode = 3
		}
		cursedpagesComponents
		{
			Type = ToggledComponents
			Toggle = cursedpagesToggle
			IncludeInBlueprints = true
			Components = &<cursedpages.rules>/Components
		}
		
		ConvertProxy
		{
			Type = ToggleProxy
			ComponentID = ResourceConverter
		}
		
		ConvertProxy2
		{
			Type = TriggerProxy
			ComponentID = ResourceConverter
		}
	}

	Stats = &<Inserter.rules>/Part/Stats
}