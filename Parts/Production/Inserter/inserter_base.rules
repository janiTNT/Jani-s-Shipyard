OVERCLOCK
{
	MODE_SWITCH_TIME = 1
	SPEEDBOOST
	{
		SPEED_FACTOR = 200%
		POWER_FACTOR = 150%
		HEAT_PER_WORK = 300
		//HEAT_PER_SECOND = 50
	}
	REGENERATION
	{
		RECHARGE_USAGE_RATIO = 65%
		RECHARGE_TIME_PER_SWING = (2 *(1/(&<hyperium.rules>/Components/MovingTween/AccumulationRate/Basevalue)))  / (&RECHARGE_USAGE_RATIO)
		RECHARGING_HEAT_PER_SECOND = 300
	}
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Resources
[
	[steel, 8]
	[coil, 6]
	[janitnt.circuit1, 8]
]

Components : &<./data/ships/terran/base_part_terran_overclock.rules>/Part/Components
{
	IsOperational
	{
		Type = MultiToggle
		Toggles = [NonJunkToggle, PowerToggle, BatteryStorage, LogicDisable, ScorchedToggle]
		Mode = All
	}
	
	NonJunkToggle
	{
		Type = JunkToggle
		OnWhenJunk = false
	}

	CommandConsumptionToggle
	{
		Type = MultiToggle
		Toggles = [PowerToggle, ScorchedToggle]
		Mode = All
	}
	
	ScorchedToggle
	{
		Type = StatusToggle
		StatusType = cosmoteer.scorched
		MinStatusValue = 1
		Invert = true
	}
	
	CommandConsumer
	{
		Type = CommandConsumer
		OperationalToggle = CommandConsumptionToggle
		CommandPoints = 4
	}
	
	LogicDisable
	{
		Type = MultiToggle
		Toggles = [LogicSignal]
		Invert = true
		Mode = All
	}
	LogicSignal
	{
		Type = BuffToggle
		BuffType = Logic
	}

	PowerToggle
	{
		Type = UIToggle
		ToggleID = "on_off"
		Default = 1
		RequiresCommand = false
	}
	
	Overclock_InserterModeToggle
	{
		Type = UIToggle
		ToggleID = "overclock_jani_inserters"
		Default = 0
		VisibilityToggle = OverclockModeToggle
	}
	Overclock_SpeedboostModeToggle
	{
		Type = ModeToggle
		Mode = Overclock_InserterModeToggle
		OnModes = [ 0 ]
	}
	Overclock_RechargeModeToggle : Overclock_SpeedboostModeToggle
	{
		OnModes = [ 1 ]
	}
	Overclock_SpeedBoostModeRawValue
	{
		Type = ValueTween
		IsOnToggle = Overclock_SpeedboostModeToggle
		OnTweenDuration = &~/OVERCLOCK/MODE_SWITCH_TIME
		OffTweenDuration = &OnTweenDuration
	}
	// Inheritors can override this component to change how overclock responds to being toggled on/off.
	OverclockStateValue
	{
		Type = ValueTween
		IsOnToggle = OverclockModeToggle
		OnTweenDuration = 1;
		OffTweenDuration = 1;
	}
	Overclock_SpeedBoostModeValue
	{
		Type = MultiValue
		Values = [ Overclock_SpeedBoostModeRawValue, OverclockStateValue ]
		Mode = Min
	}
	
	OverclockSpeedBoostToggle
	{
		Type = ThresholdToggle
		ValueFrom = Overclock_SpeedBoostModeValue
		MinAmount = 0.05
		MaxAmount = 1
	}
	
	OverclockSpeedboostTriggerHigh
	{
		Type = ThresholdTrigger
		AmountFrom = Overclock_SpeedBoostModeValue
		MinAmount = 1
		MaxAmount = 1
	}
	
	OverclockSpeedboostTriggerLow : OverclockSpeedboostTriggerHigh
	{
		MinAmount = 0
		MaxAmount = 0
	}
	
	OverclockSpeedboostHeatGenerationToggle
	{
		Type = TriggeredToggle
		OnTrigger = OverclockSpeedboostTriggerHigh
		OffTrigger = OverclockSpeedboostTriggerLow
	}
	
	Overclock_SpeedboostModeBuff
	{
		Type = SelfBuffProvider
		OperationalToggle = OverclockSpeedBoostToggle
		BuffType = InserterSpeedBoost
		BuffMultiplier = Overclock_SpeedBoostModeValue
	}

	BatteryStorage
	{
		Type = ResourceStorage
		ResourceType = battery
		MaxResources = 2000
		ReceiveResourceMediaEffects = &/COMMON_EFFECTS/BatteryDeliver
	}
	
	HeatPowerConsumeProxy
	{
		Type = TriggerProxy
		ProxyToggle = OverclockSpeedboostHeatGenerationToggle
		ComponentID = ConsumePowerTrigger
	}
	
	Overclock_WorkHeatProducer
	{
		Type = ResourceChange
		ResourceStorage = &<./data/ships/terran/base_part_terran_overclock.rules>/Part/HEAT_TARGET_STORAGE
		Trigger = HeatPowerConsumeProxy
		Amount = (&~/OVERCLOCK/SPEEDBOOST/HEAT_PER_WORK) * (&~/HEAT_TO_RESOURCE)
	}

	Overclock_RechargeHeatProducer
	{
		Type = ResourceConverter
		OperationalToggle = Overclock_BatteryProducer
		HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/REGENERATION/RECHARGING_HEAT_PER_SECOND) * (&Interval))
		ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
		ToStorage = &<./data/ships/terran/base_part_terran_overclock.rules>/Part/HEAT_TARGET_STORAGE
		Interval = 0.5
	}
	
	Port_Thermal_Left : &<./data/ships/terran/base_part_terran_overclock.rules>/Part/BASE_THERMAL_PORT
	{
		Location = [0, 0]
		Direction = Left
	}
	Port_Thermal_Right : Port_Thermal_Left
	{
		Direction = Right
	}
	
	OverclockRechargeTrueToggle
	{
		Type = MultiToggle
		Toggles = [Overclock_RechargeModeToggle, OverclockModeToggle]
		Mode = All
		IncludeInBlueprints = true
	}
	
	OverclockSpeedboostStatsToggle
	{
		Type = MultiToggle
		Toggles = [Overclock_SpeedboostModeToggle, OverclockModeToggle]
		Mode = All
	}
	
	Overclock_BatteryProducer
	{
		Type = ResourceConverter
		OperationalToggle = OverclockRechargeTrueToggle
		ToStorage = BatteryStorage
		BATCH_COUNT = 2
		ToQuantity = -(&<hyperium.rules>/Components/PowerDrainOnTransfer/Amount/BaseValue) * (&BATCH_COUNT)
		Interval = (&~/OVERCLOCK/REGENERATION/RECHARGE_TIME_PER_SWING) * (&BATCH_COUNT)
	}
	
	PortBuffToggle
	{
		Type = BuffToggle
		BuffType = PowerportBuff
	}
	ToggledBatteryConsumer
	{
		Type = ToggledComponents
		Toggle = PortBuffToggle
		Invert = true
		IncludeInBlueprints = true
		Components
		{
			BatteryConsumer
			{
				Type = ResourceConsumer
				ResourceType = battery
				Storage = BatteryStorage
				DefaultPriority = &/PRIORITIES/Factory_Supply
				ResupplyThreshold = 500
				OperationalToggle = PowerToggle
			}
		}
	}
	
	HandStorageProxy
	{
		Type = ToggleProxy
		ComponentID = HandStorageToggle
	}
	
	ConvertProxy
	{
		Type = ToggleProxy
		ComponentID = ResourceConverter
	}
	
	ConvertProxy2
	{
		Type = TriggerProxy
		ComponentID = ResourceConverter
	}
	
	ConvertEffects
	{
		Type = TriggeredEffects
		Trigger = ConvertProxy2
		Location = [.5, .5]
		MediaEffects = &/COMMON_EFFECTS/AmmoDeliver
	}
	
	FromProxyProxified
	{
		Type = ToggleProxy
		ComponentID = FromProxy
	}
	
	IndicativesLights
	{
		Type = Graphics
		Location = [.5, .5]
		OperationalToggle = FromProxyProxified
		DoodadToggle = FromProxyProxified
		//ShowToggledDoodadsWhenNotOperational = false
		OperationalDoodad
		{
			Layer = "doors"
			DamageLevels
			[
				{
					File = "indicatives_in3.png"
					Size = [1, 1]
				}
			]
		}
		NonOperationalDoodad
		{
			Layer = "doors"
			DamageLevels
			[
				{
					File = "indicatives_in1.png"
					Size = [1, 1]
				}
			]
		}
	}
	
	ToProxy1proxified
	{
		Type = ToggleProxy
		ComponentID = ToProxyValue
	}
	ToProxy2proxified
	{
		Type = ToggleProxy
		ComponentID = ToProxyExists
	}
	ArmValueProxy
	{
		Type = ValueProxy
		ComponentID = MovingTween
	}
	
	
	ToProxyAble
	{
		Type = MultiToggle
		Toggles = [ToProxy1proxified, ToProxy2proxified]
		Mode = All
	}
	
	IndicativesLights2
	{
		Type = Graphics
		Location = [.5, .5]
		OperationalToggle = ToProxyAble
		//ShowToggledDoodadsWhenNotOperational = false
		OperationalDoodad
		{
			Layer = "doors"
			DamageLevels
			[
				{
					File = "indicatives_out3.png"
					Size = [1, 1]
				}
			]
		}
		NonOperationalDoodad
		{
			Layer = "doors"
			DamageLevels
			[
				{
					File = "indicatives_out1.png"
					Size = [1, 1]
				}
			]
		}
	}
	
	ArmValueSprites
	{
		Type = ValueSprites
		Location = [(-9/64)+.5, .5]
		ValueFrom = ArmValueProxy
		Layer = "fire"
		HasZeroValueSprite = true
		ValueLevels
		[
			{File = "arm1.png"; Size = [1, 3]}
			{File = "arm2.png"; Size = [1, 3]}
			{File = "arm3.png"; Size = [1, 3]}
			{File = "arm4.png"; Size = [1, 3]}
			{File = "arm5.png"; Size = [1, 3]}
			{File = "arm6.png"; Size = [1, 3]}
			{File = "arm7.png"; Size = [1, 3]}
			{File = "arm8.png"; Size = [1, 3]}
			{File = "arm9.png"; Size = [1, 3]}
			{File = "arm10.png"; Size = [1, 3]}
			{File = "arm11.png"; Size = [1, 3]}
		]
	}
	
