						ClampAnimation = true
					}
				]
				ClosedDamageLevels
				[
					{
						AnimationFiles = &~/Components/NormalArmComponents/Components/ArmGraphics/ClosedDamageLevels/0/AnimationFiles
						Size = [1, 3]
						AnimationInterval = (1/10) / (&~/OVERCLOCK/SPEEDBOOST/SPEED_FACTOR)
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
		}
