OVERCLOCK = &<inserter_base.rules>/OVERCLOCK
Resource = hyperium
ResourceStorage = HyperiumStorage
ResourceFile = &<./data/resources/hyperium/hyperium.rules>
CarrySize = (&ResourceFile/MaxPerNugget)
LightColor = [75, 245, 255]
//CarrySize = 1
Components
{	
	MovingTween
	{
		Type = ValueAccumulator
		AccumulatingToggle = HandStorage
		AccumulationRate
		{
			BaseValue = 1
			Modifiers
			[
				{
					Type = BuffRemap
					BuffType = InserterSpeedBoost
					ModificationMode = Multiply
					RemapFrom = [0, 1]
					RemapTo = [1, &~/OVERCLOCK/SPEEDBOOST/SPEED_FACTOR]
				}
			]
		}
		DissipationRate = &AccumulationRate
		BaseValue = 0
		MinValue = 0
		MaxValue = 1
	}/* 
	MovingTween
	{
		Type = ValueTween
		OffValue = 0
		OnValue = 1
		OnTweenDuration = 1
		OffTweenDuration = 1
		IsOnToggle = HandStorage
	} */
	
	HandRest
	{
		Type = ThresholdToggle
		ValueFrom = MovingTween
		MinAmount = 0
		MaxAmount = 0
	}
	
	HandExtend
	{
		Type = ThresholdToggle
		ValueFrom = MovingTween
		MinAmount = 1
		MaxAmount = 1
	}
	
	CollectPermission
	{
		Type = MultiToggle
		Toggles = [IsOperational, FromProxy, HandRest]
		Mode = All
	}
	
	HandStorageToggle
	{
		Type = ToggleProxy
		ComponentID = HandStorage
	}
	
	ConsumePowerTrigger
	{
		Type = ToggleTrigger
		Toggle = HandRest
		TriggerWhenOff = false
		TriggerWhenOn = true
	}
	
	PowerDrainOnTransfer
	{
		Type = ResourceChange
		Trigger = ConsumePowerTrigger
		ResourceStorage = BatteryStorage
		Amount
		{
			BaseValue = -500
			Modifiers
			[
				{
					Type = BuffRemap
					BuffType = InserterSpeedBoost
					ModificationMode = Multiply
					RemapFrom = [0, 1]
					RemapTo = [1, &~/OVERCLOCK/SPEEDBOOST/POWER_FACTOR]
				}
			]
		}
	}
	
	HandStorage
	{
		Type = ResourceStorage
		ResourceType = &~/Resource
		MaxResources = (&~/CarrySize)
		InitToMaxResources = 0
		ToggleOnResources = (&~/CarrySize)
		ToggleOffResources = 0
		DropResourcesWhenDestroyed = true
		DropResourcesWhenRemoved = true
	}
	
	InsertPermission
	{
		Type = MultiToggle
		Toggles = [IsOperational, ToProxyValue, HandStorage, HandExtend, ToProxyExists]
		Mode = All
	}
	
	ToProxyValue
	{
		Type = ThresholdToggle
		ValueFrom = ToProxy
		MinAmount = 1
		MaxAmount = 1
		Invert = true
	}
	
	ToProxyExists
	{
		Type = ComponentPresenceToggle
		PartLocation = [0, -1]
		ComponentID = &~/ResourceStorage
	}
	
	FromProxy
	{
		Type = ResourceStorageProxy
		ResourceType = &~/Resource
		PartLocation = [0, 1]
		//PartCriteria
		//{
		//	Category = thermal
		//}
		ComponentID = &~/ResourceStorage
	}
	
	ToProxy
	{
		Type = ResourceStorageProxy
		ResourceType = &~/Resource
		PartLocation = [0, -1]
		//PartCriteria
		//{
		//	Category = thermal
		//}
		ComponentID = &~/ResourceStorage
	}
	
	From_Into_Hand
	{
		Type = ResourceConverter
		OperationalToggle = CollectPermission
		From
		[
			{
				Storage = FromProxy
				Quantity = 1
				MinQuantityForConversion = 1
			}
		]
		To
		[
			{
				Storage = HandStorage
				Quantity = 1
				MinQuantityForConversion = 1
			}
		]
		Interval = 1 / ((&/Simulation/PhysicsUpdatesPerSecond)*(&~/CarrySize))
	}
	
	Hand_Into_To
	{
		Type = ResourceConverter
		OperationalToggle = InsertPermission
		From
		[
			{
				Storage = HandStorage
				Quantity = 1
				MinQuantityForConversion = 1
			}
		]
		To
		[
			{
				Storage = ToProxy
				Quantity = 1
				MinQuantityForConversion = 1
			}
		]
		Interval = 1 / ((&/Simulation/PhysicsUpdatesPerSecond)*(&~/CarrySize))
	}
	
	MoveTriggerDeploying
	{
		Type = ToggleTrigger
		Toggle = HandRest
		TriggerWhenOff = true
		TriggerWhenOn = false
	}
	MoveTriggerRetract
	{
		Type = ToggleTrigger
		Toggle = HandExtend
		TriggerWhenOff = true
		TriggerWhenOn = false
	}
	TriggerInsert
	{
		Type = ToggleTrigger
		Toggle = InsertPermission
		TriggerWhenOff = false
		TriggerWhenOn = true
	}
	TriggerCollect
	{
		Type = ToggleTrigger
		Toggle = CollectPermission
		TriggerWhenOff = false
		TriggerWhenOn = true
	}
	DeployEffects
	{
		Type = TriggeredEffects
		Trigger = MoveTriggerDeploying
		FactorMediaEffectsWith = Overclock_SpeedBoostModeValue
		Location = [0.5, 0.5]
		MediaEffects
		[
			: /BASE_SOUNDS/AudioInteriorDetail
			{
				RandomSounds = ["sounds/googe servo low true1.wav"]
				Volume = 1
				Db = -15
				Speed = 1
				//IntensityBounds = [0, 2]
				VolumeOverIntensity = 1
				SpeedOverIntensity = [1, 2]
				SpeedVariation = .05
			}
		]
	}
	InsertEffects
	{
		Type = TriggeredEffects
		Trigger = TriggerInsert
		Location = [0.5, -0.5]
		MediaEffects = &~/ResourceFile/StackReceiveMediaEffects
	}
	RetractEffects
	{
		Type = TriggeredEffects
		Trigger = MoveTriggerRetract
		FactorMediaEffectsWith = Overclock_SpeedBoostModeValue
		Location = [0.5, 0.5]
		MediaEffects
		[
			: /BASE_SOUNDS/AudioInteriorDetail
			{
				RandomSounds = ["sounds/googe servo low true2.wav"]
				Volume = 1
				Db = -15
				Speed = 1
				//IntensityBounds = [0, 2]
				VolumeOverIntensity = 1
				SpeedOverIntensity = [1, 2]
				SpeedVariation = .05
			}
		]
	}
	CollectEffects
	{
		Type = TriggeredEffects
		Trigger = TriggerCollect
		Location = [0.5, 1.5]
		MediaEffects = &~/ResourceFile/StackPickupMediaEffects
	}
	
	Graphics
	{
		Type = Graphics
		Location = [.5, .5]
		OperationalToggle = IsOperational
		OperationalLighting
		{
			Layer = "lights_add"
			DamageLevels
			[
				{
					File = "lights.png"
					Size = [1, 1]
					VertexColor = &~/LightColor
				}
			]
		}
	}
}