						"roof_normals5_66.png"
						"roof_normals6_66.png"
					]
					Size = [3, 2]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				} */
			]
			ClosedDamageLevels
			[
				{
					AnimationFiles
					[
						"roof6.png"
						"roof5.png"
						"roof4.png"
						"roof3.png"
						"roof2.png"
						"roof1.png"
					]
					NormalsAnimationFiles
					[
						"roof_n6.png"
						"roof_n5.png"
						"roof_n4.png"
						"roof_n3.png"
						"roof_n2.png"
						"roof_n1.png"
					]
					Size = [3, 2]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}/*
				{
					AnimationFiles
					[
						"roof6_33.png"
						"roof5_33.png"
						"roof4_33.png"
						"roof3_33.png"
						"roof2_33.png"
						"roof1_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals6_33.png"
						"roof_normals5_33.png"
						"roof_normals4_33.png"
