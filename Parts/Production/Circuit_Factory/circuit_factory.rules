OVERCLOCK
{
	HEAT_PER_CONVERSION = 100
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 125%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <./data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/FactoryElectronicCircuit"
	IconNameKey = "Parts/FactoryElectronicCircuitIcon"
	ID = janiTNT.electronic_circuit_factory // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Production"
	DescriptionKey = "Parts/FactoryElectronicCircuitDesc"
	Resources
	[
		[steel, 40]
		[coil, 15]
		[processor, 1]
	]
	Size = [3, 2]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 6000
	TypeCategories = [provides_electronic_circuit, uses_coils, uses_steel, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	AllowedDoorLocations
	[
		[-1, 1]
		[0, 2]
		[1, 2]
		[2, 2]
		[3, 1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 48]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, CoilPrereq, SteelPrereq, BatteryStorage, NonJunkToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		CoilStorage
		{
			Type = TypedResourceGrid
			ResourceType = coil
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [15/64, 6/64, 2/64, 9/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}
		CoilConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = coil
			Storage = CoilStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		SteelStorage
		{
			Type = TypedResourceGrid
			ResourceType = steel
			GridRect = [2, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [2/64, 6/64, 15/64, 9/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}

		SteelConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = steel
			Storage = SteelStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		ElectronicCircuitStorage
		{
			Type = TypedResourceGrid
			ResourceType = janitnt.circuit1
			GridRect = [1, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 12/64, 8/64, 4/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			RandomSpriteRotation = true
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}

		SteelPrereq
		{
			Type = MultiToggle
			Toggles = [SteelStorage, SteelSplitter]
			Mode = Any
		}
		CoilPrereq
		{
			Type = MultiToggle
			Toggles = [CoilStorage, CoilSplitter]
			Mode = Any
		}
		AnimationToggle
		{
			Type = MultiToggle
			Toggles = [SteelLoader, CoilLoader, ResourceConverter]
			Mode = Any
		}

		SteelLoader
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = SteelStorage
			FromQuantity = 1
			ToStorage = LoadedSteel
			ToQuantity = 1
			Interval
			{
				BaseValue = 1
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		
		LoadedSteel
		{
			Type = ResourceStorage
			OperationalToggle = IsOperational
			ResourceType = fake
			MaxResources = 1
		}
		SteelSplitter
		{
		    Type = InlineResourceConverter
		    ResourceType = fake
		    FromStorage = LoadedSteel
		    FromQuantity = 1
		    ToQuantity = 5
			ToggleOnResources = &../ResourceConverter/From/1/Quantity
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		
		CoilLoader
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = CoilStorage
			FromQuantity = 1
			ToStorage = LoadedCoil
			ToQuantity = 1
			Interval
			{
				BaseValue = 1
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		
		LoadedCoil
		{
			Type = ResourceStorage
			OperationalToggle = IsOperational
			ResourceType = fake
			MaxResources = 1
		}
		CoilSplitter
		{
		    Type = InlineResourceConverter
		    ResourceType = fake
		    FromStorage = LoadedCoil
		    FromQuantity = 1
		    ToQuantity = 5
			ToggleOnResources = &../ResourceConverter/From/0/Quantity
			ToggleOffResources = (&ToggleOnResources) - 1
		}

		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
			    {
			        Storage = CoilSplitter
			        Quantity = 1
			    }
			    {
			        Storage = SteelSplitter
			        Quantity = 1
			    }
			    {
			        Storage = BatteryStorage
			        Quantity
			        {
			        	BaseValue = 50
			        	Modifiers
			        	[
			        		: ~/MODIFIERS/OVERCLOCK_LERP
			        		{
			        			MinValue = &../../BaseValue
			        			MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			        		}
			        	]
			        }
			        MinQuantityForConversion = 1
			    }
			]
			ToStorage = ElectronicCircuitStorage
			ToQuantity = 1
			Interval
			{
				BaseValue = 0.5
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}

		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [1.5, 1]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./data/ships/terran/factory_ammo/bullet_create.wav"
					Volume = .1
					Speed = 1.25
					SpeedVariation = .05
				}
			]
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		BeltSpeedFactor
        {
        	Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
        }

		Graphics
		{
			Type = Graphics
			Location = [1.5, 1]
			OperationalToggle = IsOperational
			DoodadToggle = AnimationToggle
			AnimationSpeedFactor = BeltSpeedFactor
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 2]
					}
				]
			}
			ToggleOnDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.125
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "walls"		//walls layer so its over the batteries and under the crew layer
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [3, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [-45/64, -23/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		CoilBeltAndRoboticArmGraphics
		{
			Type = Graphics
			Location = [.5, 1]
			ResetAnimationTrigger = CoilLoader
			//OperationalToggle = CoilLoader
			AnimationSpeedFactor = BeltSpeedFactor
			OperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						AnimationFiles
						[
							"coilbelt2.png"
							"coilbelt3.png"
							"coilbelt4.png"
							"coilbelt5.png"
							"coilbelt6.png"
							"coilbelt7.png"
							"coilbelt8.png"
							"coilbelt9.png"
							"coilbelt10.png"
							"coilbelt11.png"
							"coilbelt12.png"
							"coilbelt13.png"
							"coilbelt14.png"
							"coilbelt15.png"
							"coilbelt16.png"
							"coilbelt17.png"
							"coilbelt18.png"
							"coilbelt1.png"
						]
						Size = [1, 2]
						AnimationInterval = 0.0789473684
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			/* NonOperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						File = "coilbelt1.png"
						Size = [1, 2]
					}
				]
			} */
		}
		
		SteelBeltAndRoboticArmGraphics
		{
			Type = Graphics
			Location = [2.5, 1]
			ResetAnimationTrigger = SteelLoader
			AnimationSpeedFactor = BeltSpeedFactor
			// OperationalToggle = SteelLoader
			OperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						AnimationFiles
						[
							"steelbelt2.png"
							"steelbelt3.png"
							"steelbelt4.png"
							"steelbelt5.png"
							"steelbelt6.png"
							"steelbelt7.png"
							"steelbelt8.png"
							"steelbelt9.png"
							"steelbelt10.png"
							"steelbelt11.png"
							"steelbelt12.png"
							"steelbelt13.png"
							"steelbelt14.png"
							"steelbelt15.png"
							"steelbelt16.png"
							"steelbelt17.png"
							"steelbelt18.png"
							"steelbelt1.png"
						]
						Size = [1, 2]
						AnimationInterval = 0.0789473684
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			/* NonOperationalDoodad
			{
				Layer = "doodads_high"	//doodads_high layer so the robotic arm sprites are draw over the resources sprites and crew
				DamageLevels
				[
					{
						File = "steelbelt1.png"
						Size = [1, 2]
					}
				]
			} */
		}

		Graphics2
		{
			Type = Graphics
			Location = [1.5, 1]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [45/64, -23/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		CircuitGraphics
		{
			Type = Graphics
			Location = [1.5, 1]
			OperationalToggle = IsOperational
			DoodadToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			ToggleOnDoodad
			{
				Layer = "doors" //doors layer so the processor is show on top of the exit belt which use the doodad_low layer and under the crew sprite, and higher than walls
				DamageLevels
				[
					{
						AnimationFiles
						[
							"circuit1.png"
							"circuit2.png"
							"circuit3.png"
							"circuit4.png"
							"circuit5.png"
							"circuit6.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.166666667 / 2
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [1.5, 1]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"roof1.png"
						"roof2.png"
						"roof3.png"
						"roof4.png"
						"roof5.png"
						"roof6.png"
					]
					NormalsAnimationFiles
					[
						"roof_n1.png"
						"roof_n2.png"
						"roof_n3.png"
						"roof_n4.png"
						"roof_n5.png"
						"roof_n6.png"
					]
					Size = [3, 2]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}/* 
				{
					AnimationFiles
					[
						"roof1_33.png"
						"roof2_33.png"
						"roof3_33.png"
						"roof4_33.png"
						"roof5_33.png"
						"roof6_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1_33.png"
						"roof_normals2_33.png"
