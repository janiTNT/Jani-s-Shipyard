		BatterySprites
		{
			Type = ResourceSprites
			Location = [1.5, 1]
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					OffSet = [-0.5, 0]
				}
				{
					File = "batteries2.png"
					Size = [2, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}
		
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// No coils.
				{
					Toggle = CoilPrereq
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// No steel.
				{
					Toggle = SteelPrereq
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}
		
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}

		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 1]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 1]
		}
		Port_Thermal_Down2 : Port_Thermal_Down0
		{
			Location = [2, 1]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [2, 1]
			Direction = Right
		}
		
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}

		Blueprints
		{
			Type = BlueprintSprite
			//File = "blueprints.png"
			File = "blueprints.png"
			Size = [3, 2]
		}
	}

	Stats
	{
		Interval = (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		ElectronicCircuitProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&Interval)
		ElectronicCircuitCapacity = (&~/Part/Components/ElectronicCircuitStorage/GridRect/2) * (&~/Part/Components/ElectronicCircuitStorage/GridRect/3) * (&<../../../resources/Circuits/electronic_circuit.rules>/MaxStackSize)
		CoilCapacity = (&~/Part/Components/CoilStorage/GridRect/2) * (&~/Part/Components/CoilStorage/GridRect/3) * (&<./Data/resources/coil/coil.rules>/MaxStackSize)
		CoilPerCircuit = ((&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/CoilSplitter/ToQuantity)) / (&~/Part/Components/ResourceConverter/ToQuantity) 
		CoilPerSecond = ((&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/CoilSplitter/ToQuantity)) / (&Interval) 
		ElectronicCircuitCoilUsage = [&../CoilPerCircuit, &../CoilPerSecond]
		SteelCapacity = (&~/Part/Components/SteelStorage/GridRect/2) * (&~/Part/Components/SteelStorage/GridRect/3) * (&<./Data/resources/steel/steel.rules>/MaxStackSize)
		SteelPerCircuit = ((&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/SteelSplitter/ToQuantity)) / (&~/Part/Components/ResourceConverter/ToQuantity) 
		SteelPerSecond = ((&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/SteelSplitter/ToQuantity)) / (&Interval) 
		ElectronicCircuitSteelUsage = [&../SteelPerCircuit, &../SteelPerSecond]
		PowerPerCircuit = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&Interval) / 1000
		ElectronicCircuitPowerUsage = [&../PowerPerCircuit, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/FactoryElectronicCircuitOverclockDesc"
		Stats
		{
			ElectronicCircuitProduction = (&~/Part/Stats/ElectronicCircuitProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
			ElectronicCircuitCoilUsage = [(&~/Part/Stats/ElectronicCircuitCoilUsage/0), (&~/Part/Stats/ElectronicCircuitCoilUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			ElectronicCircuitSteelUsage = [(&~/Part/Stats/ElectronicCircuitSteelUsage/0), (&~/Part/Stats/ElectronicCircuitSteelUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			POWER_PER_ITEM = (&~/Part/Stats/ElectronicCircuitPowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			POWER_PER_SECOND = (&~/Part/Stats/ElectronicCircuitPowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
			ElectronicCircuitPowerUsage = [&../POWER_PER_ITEM, &../POWER_PER_SECOND]
			CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_ITEM = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR);
			ElectronicCircuitHeatGeneration = [&../HEAT_PER_ITEM, &../HEAT_PER_SECOND]
		}
	}
}

MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}