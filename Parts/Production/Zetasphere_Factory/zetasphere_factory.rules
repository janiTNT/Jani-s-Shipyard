Part : <./data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ZetasphereFactory"
	IconNameKey = "Parts/ZetasphereFactoryIcon"
	ID = janiTNT.Zetasphere_Factory // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Production"
	DescriptionKey = "Parts/ZetasphereFactoryDesc"
	Resources
	[
		[steel, 180]
		[coil2, 100]
		[janitnt.zetasphere, 1]
	]
	Size = [4, 4]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 16000
	TypeCategories
	[
	provides_zetaspheres
	uses_steel
	uses_power
	]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[1, -1]
		[2, -1]
		[-1, 1]
		[-1, 2]
		[1, 4]
		[2, 4]
		[4, 1]
		[4, 2]
	]
	BlockedTravelCells
	[
		[1, 1]
		[1, 2]
		[2, 1]
		[2, 2]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, SteelStorage, BatteryStorage]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 8
		}
		
		SteelStorage
		{
			Type = ResourceStorage
			ResourceType = steel
			MaxResources = 800
			DelayBeforeReadyToUse = 0
			UITileRect = [1.5 + 7/64, 1 + 7/64, 1 - 14/64, 1 - 14/64]//fix
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/MetalDeliver
			DropResourcesWhenDestroyed = true
			AllowExternalPickupAndDelivery = false
			/* DeliveryLocation = [1, 2.2]
			PickUpLocation = [1, 2.2]
			ExternalDeliveryLocation = [64/64, 53/64]
			ExternalPickUpLocation = [64/64, 53/64] */
		}
		SteelConsumer
		{
			Type = ResourceConsumer
			ResourceType = steel
			Storage = SteelStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		
		ZetasphereStorage
		{
			Type = ResourceStorage
			ResourceType = janitnt.zetasphere
			MaxResources = 1
			UITileRect = [1.5 + 7/64, 2 + 7/64, 1 - 14/64, 1 - 14/64]//fix
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/MetalDeliver
			DropResourcesWhenDestroyed = true
			SuppliesResources = true
			AllowExternalPickupAndDelivery = false
			SupplyToggleButtonOffset = [0, .4]
			InitToMaxResources = 0
			/* DeliveryLocation = [1, 2.2]
			PickUpLocation = [1, 2.2]
			ExternalDeliveryLocation = [64/64, 53/64]
			ExternalPickUpLocation = [64/64, 53/64] */
		}
		
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 12000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/BatteryDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}
		
		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
			    {
			        Storage = SteelStorage
			        Quantity = 800
			    }
			    {
			        Storage = BatteryStorage
			        Quantity = 12000
			        MinQuantityForConversion = 1
			    }
			]
			ToStorage = ZetasphereStorage
			ToQuantity = 1
			Interval = 0.75
			CheckResourceLimits = true
		}

		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [2, 2]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					//Sound = "../factory_ammo/bullet_create.wav"
					//Volume = .75
					Sound = "./data/common_effects/sounds/metal_deliver.wav"
					Volume = 0.8
					Speed = .1
					SpeedVariation = .05
				}
			]
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			DoodadToggle = ResourceConverter
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
				]
			}
			ToggleOnDoodad
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"blastlight1.png"
							"blastlight2.png"
							"blastlight3.png"
							"blastlight4.png"
							"blastlight5.png"
							"blastlight6.png"
							"blastlight5.png"
							"blastlight4.png"							
							"blastlight3.png"							
							"blastlight2.png"							
							"blastlight1.png"							
						]
						Size = [3, 3]
						AnimationInterval = 0.75 / 11
						AnimationStartTime = WhenSpawned
						ClampAnimation = true
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [-1, 1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.125
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [4, 4]
					}
				]
			}
			OperationalRoofLighting//Placeholder
			{
				Layer = "roof_lights_fancy"
				Offset = [-85/64, -57/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [6, 6]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 80*1.4]
					}
				]
			}
		}
		
		RoofDoorOpenToggle//Placeholder
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite//Placeholder
		{
			Type = OpenCloseSprite
			Location = [2, 2]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels = &<./Data/ships/terran/factory_tristeel/factory_tristeel.rules>/Part/Components/RoofDoorSprite/OpenDamageLevels
			ClosedDamageLevels = &<./Data/ships/terran/factory_tristeel/factory_tristeel.rules>/Part/Components/RoofDoorSprite/ClosedDamageLevels
		}

		Graphics2
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [-1, -1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [1, 1]
						UVRotation = 1
						AnimationInterval = 0.125
					}
				]
			}
			OperationalLighting
			{
				Layer = "doodads_low"
				Offset = [1, -1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [1, 1]
						UVRotation = 2
						AnimationInterval = 0.125
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "doodads_low"
				Offset = [1, 1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [1, 1]
						UVRotation = 3
						AnimationInterval = 0.125
					}
				]
			}
		}
		
		ZetasphereSprite
		{
			Type = ResourceSprites
			Location = [2, 2]
			ResourceStorage = ZetasphereStorage
			Layer = "doodads_low"
			ResourceLevels
			[
				{
					File = "../../../Resources/Zetasphere/zetasphere.png"
					Size = [1, 1]
				}
			]
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [3.5, 2]
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			RangeLow = 0
			RangeHigh = 3000
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
			]
		}
		BatterySprites2
		{
			Type = ResourceSprites
			Location = [2, 3.5]
			Rotation = 90d
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			RangeLow = 3000
			RangeHigh = 6000
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
			]
		}
		BatterySprites3
		{
			Type = ResourceSprites
			Location = [.5, 2]
			Rotation = 180d
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			RangeLow = 6000
			RangeHigh = 9000
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
			]
		}
		BatterySprites4
		{
			Type = ResourceSprites
			Location = [2, .5]
			Rotation = 270d
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			RangeLow = 9000
			RangeHigh = 12000
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			//ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
			Location = [2, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Layer = "indicators"
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}
				//No Steel.
				{
					Toggle = SteelStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "icon.png"
			Size = [4, 4]
		}
	}

	Stats
	{
		PowerPerSteel = 750 / 1 / 1000
		PowerPerSecond = 750 / 3 / 1000
		SteelPowerUsage = [&../PowerPerSteel, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}
}