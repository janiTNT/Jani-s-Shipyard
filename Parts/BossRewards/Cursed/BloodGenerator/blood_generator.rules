Part : <./data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/ThermalDilationPump"
	IconNameKey = "Parts/ThermalDilationPumpIcon"
	ID = cosmoteer.thermal_dilation_pump123
	EditorGroup = "Defenses"
	//EditorParentParts = [ ["cosmoteer.resonance_beam_turret", -1] ]
	DescriptionKey = "Parts/ThermalDilationPumpDesc"
	Resources
	[
		[steel, 16]
		[coil2, 2]
		[diamond, 1]
	]
	Size = [2, 2]
	IsRotateable = true
	SelectionPriority = 0
	MaxHealth = 4000
	ReceivableBuffs : ^/0/ReceivableBuffs [ ThermalActivity ]
	TypeCategories = [ uses_power, thermal_pump ]
	AllowedDoorLocations
	[
		[-1, 1]
		[2, 1]
		[0, 2]
		[1, 2]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [56, 56]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ScorchedToggle]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 2
		}
		
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}
		
		/* PowerDrain
		{
			Type = ResourceConverter
			OperationalToggle = IsUtilized
			FromStorage = BatteryStorage
			FromQuantity 
			{
				BaseValue = 50
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			MinFromQuantityForConversion = 1
			Interval = 0.4
		} */
		
		Port_TopLeft
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ thermal, thermal_out ]
			IncompatibleTypes = [ thermal_out ]
		}
		
		Port_TopRight : Port_TopLeft
		{
			Location = [1, 0]
		}
		
		NetworkHeatInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			Categories = [ thermal_storage ]
		}
		
		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Simple
					Routes
					[
						[NetworkHeatInput, Port_TopLeft, 0]
						[NetworkHeatInput, Port_TopRight, 0]
					]
				}
			]
		}
		
		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1, 1]
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
		}
		
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			//DoodadToggle = IsUtilized
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
			/* ToggleOnDoodad
			{
				Layer = "doodads_low"
				Offset = [0, 12/64]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.1
					}
				]
			} */
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofLighting = &<./data/ships/terran/factory_ammo/factory_ammo.rules>/Part/Components/Graphics/OperationalRoofLighting
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite = &<./data/ships/terran/factory_ammo/factory_ammo.rules>/Part/Components/RoofDoorSprite

		Left_Pipe_Components
		{
			Type = ToggledComponents
			Toggle = Port_TopLeft
			Components
			{
				Left_Pipes_Graphics
				{
					Type = Graphics
					Location = [0.5, 0.5]
					OperationalToggle = IsOperational
					Floor
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								File = "connection.png"
								Size = [1, 1]
							}
						]
					}
					Roof
					{
						Layer = "roof_doodads"
						Offset = [0, -0.5]
						DamageLevels
						[
							{
								File = "pipe_connector_roof.png"
								NormalsFile = "pipe_connector_roof_normals.png"
								Size = [1, 1]
								UVRotation = 2
							}
						]
					}
				}
			}
		}

		Right_Pipe_Components
		{
			Type = ToggledComponents
			Toggle = Port_TopRight
			Components
			{
				Right_Pipes_Graphics
				{
					Type = Graphics
					Location = [1.5, 0.5]
					OperationalToggle = IsOperational
					Floor
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								File = "connection.png"
								Size = [1, 1]
								MirrorU = true
							}
						]
					}
					Roof
					{
						Layer = "roof_doodads"
						Offset = [0, -0.5]
						DamageLevels
						[
							{
								File = "pipe_connector_roof.png"
								NormalsFile = "pipe_connector_roof_normals.png"
								Size = [1, 1]
								UVRotation = 2
							}
						]
					}
				}
			}
		}
		
		BatterySprites
		{
			Type = ResourceSprites
			Location = [1, 1]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					Offset = [0, 0]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
			]
		}
		
		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Layer = "indicators"
			Indicators
			[
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}
		
		Left_Pipe_Connected_Blueprints
		{
			Type = BlueprintSprite
			Offset = [-0.5, 0]
			Toggle = Port_BottomLeft
			File = "blueprints_connected.png"
			Size = [1, 2]
		}
/*		Left_Pipe_Unconnected_Blueprints
		{
			Type = BlueprintSprite
			Offset = [-0.5, 0]
			Toggle = Port_BottomLeft
			Invert = true
			File = "blueprints_unconnected.png"
			Size = [1, 2]
		}
*/		Right_Pipe_Connected_Blueprints
		{
			Type = BlueprintSprite
			Offset = [0.5, 0]
			Toggle = Port_BottomRight
			File = "blueprints_connected.png"
			Size = [1, 2]
			MirrorU = true
		}
/*		Right_Pipe_Unconnected_Blueprints
		{
			Type = BlueprintSprite
			Offset = [0.5, 0]
			Toggle = Port_BottomRight
			Invert = true
			File = "blueprints_unconnected.png"
			Size = [1, 2]
			MirrorU = true
		}
*/

		//------------------------ PIPE CONNECTOR ------------------------
		Dont_Draw_Pipe_Connector_Into_This_Part { Type = Graphics }	//When this fake component is present, the Heat Pipes dont draw a Pipe Conector to this part.

		//Draw a Pipe Connector Down Left if possible
		PipeConnectorTopLeft_DrawToggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_DrawToggle
		{
			PartLocation = [0, -1]
		}
		PipeConnectorTopLeft_Toggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Toggle
		{
			Toggles = [Port_TopLeft, {Toggle = PipeConnectorTopLeft_DrawToggle, invert = true}]
		}
		PipeConnectorTopLeft_Components : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Components
		{
			Toggle = PipeConnectorTopLeft_Toggle
			Components
			{
				PipesConnectorTopLeft_Graphics : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Components/Components/PipesConnectorUp_Graphics
				{
					Location = [0.5, -.5]
				}
			}
		}

		//Draw a Pipe Connector Down Right if possible
		PipeConnectorTopRight_DrawToggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_DrawToggle
		{
			PartLocation = [1, -1]
		}
		PipeConnectorTopRight_Toggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Toggle
		{
			Toggles = [Port_TopRight, {Toggle = PipeConnectorTopRight_DrawToggle, invert = true}]
		}
		PipeConnectorTopRight_Components : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Components
		{
			Toggle = PipeConnectorTopRight_Toggle
			Components
			{
				PipesConnectorTopRight_Graphics : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorUp_Components/Components/PipesConnectorUp_Graphics
				{
					Location = [1.5, -.5]
				}
			}
		}
		//---------------------- END PIPE CONNECTOR ----------------------
	}
	
	Stats
	{
		//ThermalDilation = (&~/Part/Components/BasePumpDilation/OnValue) * 100 * 2
//		ThermalPumpMultiEfficiency = (&~/Part/Components/MultiUtilizationEfficiencyFactor/Value) * 100
		//TurretExtraHeatGeneration = (&~/Part/Components/AdditionalTurretHeatGeneration_Active/Value) * 2
		
		//PowerUsageContinuous = (&~/Part/Components/PowerDrain/FromQuantity/BaseValue) / (&~/Part/Components/PowerDrain/Interval) / 1000 * 2
		//PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		//RecPower = &PowerUsageContinuous
	}
	
	//StatsNotesKey = "Stats/ThermalDilationPumpNotes"
}