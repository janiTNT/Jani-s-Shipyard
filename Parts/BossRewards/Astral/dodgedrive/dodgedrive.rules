		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 2]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1]
				}
				
				// No hyperium.
				{
					Toggle = VerySecretHyperiumStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = RealBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}/* 

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 4]
		} */
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/RealBatteryStorage/MaxResources) / 1000

		RecPower = (&../StatsByCategory/1/Stats/BoostedPowerUsageContinuous) / 10 // assume its gonna be used only 10% continuously
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/BoostOff"
			Stats
			{
				ThrusterForce = 0
			}
		}
		{
			NameKey = "StatCategories/BoostOn"
			Stats
			{
				ThrusterForce = &~/Part/BoostedThrusterForce
				ThrusterRampUp = &~/Part/BoostedThrustIncreaseTime
				ThrusterRampDown = &~/Part/BoostedThrustDecreaseTime
				ThrusterPowerUsage = 0
				JSThrusterHyperiumUsage = 0
				BoostedPowerUsageContinuous = -(&~/Part/BoostedPowerDrain) / (&~/Part/BoostedDrainInterval) / 1000
				JSBoostedHyperiumUsageContinuous = -(&~/Part/BoostedHyperiumDrain) / (&~/Part/BoostedDrainInterval)
			}
		}
	]
}