Part : <./data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/AstralConveyor"
	IconNameKey = "Parts/AstralConveyorIcon"
	ID = janiTNT.astralconveyor // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "JSBossParts"
	DescriptionKey = "Parts/AstralConveyorDesc"
	ForceBrushCompatibility = true
	Resources
	[
		[steel, 4]
		[coil, 2]
		[astralbar, 2]
	]
	AIValueFactor = 0
	Size = [1, 1]
	MaxHealth = 500
	AllowedDoorLocations
	[
		[0, 1]
		[0, -1]
	]
	CrewSpeedFactor
	{
		Up = 3.5
		Left = .015
		Right = .015
		Down = .075
	}
	CrewCongestedSpeedFactor
	{
		Up = 1.0
		Left = .01
		Right = .01
		Down = .01
	}
	CrewFireSpeedFactor
	{
		Up = 2
		Left = .25
		Right = .25
		Down = .25
	}
	DamageResistances
	{
		fire = 80%
	}
	/* 
	BlockedTravelCellDirections
	[
		{
			Key = [0, 0]
			Value = [Right, Left]
		}
	] */
	TypeCategories = [corridor, jani_astral]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	IsRotateable = true
	IsWalled = false
	GeneratorRequiresDoor = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		WallsBlend : /JANI_COMMON/Walls/FactoryWalls
		{
			Type = BlendSprite
			Location = [.5, .5]
			BlendsWithCategories = [corridor]
		}

		Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [1, 1]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"conveyor1.png"
							"conveyor2.png"
							"conveyor3.png"
							"conveyor4.png"
							"conveyor5.png"
							"conveyor6.png"
							"conveyor7.png"
							"conveyor8.png"
						]
						Size = [1, 1]
						AnimationInterval = .0333 / 2
						AnimationStartTime = Zero
					}
				]
			}
			Roof = &<./data/ships/terran/corridor/corridor.rules>/Part/Components/Graphics/Roof
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [.5, .5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}

		BlueprintWalls : /JANI_COMMON/Walls/FactoryWallsBlueprints
		{
			Location = [.5, .5]
			BlendsWithCategories = [corridor]
		}
	}

	Stats
	{
		CrewSpeed = [] // Suppress display.
		CrewSpeedFwd = (&~/Part/CrewSpeedFactor/Up) * 100
		CrewSpeedAcr = (&~/Part/CrewSpeedFactor/Left) * 100
		CrewSpeedRev = (&~/Part/CrewSpeedFactor/Down) * 100
	}
}