				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/SmallPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyed
			Location = [.5, 1.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [.5, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2]
				}

				// Out of canisters.
				{
					Toggle = TrueTHERMALMissileStorage
					Delay = &~/Part/Components/Weapon/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoThermalMissiles
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}

		HeatDissipationValue
		{
			Type = StaticValue
			Value = (&~/Part/Stats/HeatDissipation)
		}
		HeatDissipationStatProvider
		{
			Type = StatProvider
			Stat = HeatDissipation
			ValueFrom = HeatDissipationValue
		}
	}

	Stats
	{
		//PowerCapacity = (&~/Part/Components/TrueTHERMALMissileStorage/MaxResources) / 1000


		HeatCapacity = (&~/Part/Components/HeatBuffer/MaxResources)  / (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
		HeatDissipation = (&../StatsByCategory/0/Stats/HeatCapacity) * (&../StatsByCategory/0/Stats/ROF)
		MissilePartCapacity = [(&~/Part/Components/TrueTHERMALMissileStorage/MaxResources) + 1, &0]
		//RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		//RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/SingleCanisterThermal"
			Stats
			{
				HeatCapacity = (&~/STATS/CanisterCapacity)
				HeatSpreadDistance = &~/Part/Components/BulletEmitter/Bullet/Components/Hit/HitOperational/HitEffects/0/MaxCost
				ROF = 1 / (&~/Part/Components/Weapon/FireInterval)
				ShotLaunchSpeed = &~/Part/Components/BulletEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/BulletEmitter/Bullet/Components/Targetable/Health
				MissileParts = &~/Part/Components/LoadedMissile/MaxResources
				Lifetime = &~/Part/Components/BulletEmitter/Bullet/Components/DeathByLifetime/Lifetime
			}
		}
	]
}