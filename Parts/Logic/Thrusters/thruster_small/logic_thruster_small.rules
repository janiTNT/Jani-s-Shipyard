Part : <./data/ships/terran/thruster_small/thruster_small.rules>/Part
{
	NameKey = "Parts/LogicThrusterSmall"
	IconNameKey = "Parts/LogicThrusterSmallIcon"
	ID = skipydog.logic_thruster_small // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = []
	EditorGroup = "Logic"
	DescriptionKey = "Parts/LogicThrusterSmallDesc"
	TypeCategories = [thruster, uses_power, logic]
	SelectionTypeID = "logic_thrusters"
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic,  RampUpJani, RampUpJaniFinal]
	Components : ^/0/Components
	{
		Triggered
		{
			Type = MultiToggle
			Toggles = [IsOperational, XorFinal]
			Mode = All
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}

		MainThruster : <./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/MainThruster
		{
			SoftOperationalToggle = IsOperational
			MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
		}
		LateralThruster : MainThruster
		{
			Rotation = 0d
			MinActivation = 0
			MaxActivation = 0
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			AllowAutoFire = false
		}
		
		RampUpBuff
		{
			Type = SelfBuffProvider
			BuffType = RampUpJani  //used as divide by the fixed weapon fire rate
			BuffAmount = 1
			OperationalToggle = Triggered
		}	
		EngineBuffMultiplier
		{
			Type = BuffableValue
			Value = { BaseValue=1; BuffType=Engine; BuffMode=Multiply; }
		}
		RampUpJaniFinalBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = RampUpJaniFinal
			BuffAmount = { BaseValue=0; BuffType=RampUpJani; BuffMode=Add; }
			BuffMultiplier = EngineBuffMultiplier
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}
	}
}