OVERCLOCK = &<./data/ships/terran/thruster_small/thruster_small.rules>/OVERCLOCK

Part : <./data/ships/terran/thruster_small/thruster_small.rules>/Part
{
	NameKey = "Parts/LogicThrusterSmall"
	IconNameKey = "Parts/LogicThrusterSmallIcon"
	ID = skipydog.logic_thruster_small // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = []
	EditorGroup = "Logic"
	DescriptionKey = "Parts/LogicThrusterSmallDesc"
	TypeCategories = [thruster, uses_power, logic]
	SelectionTypeID = "logic_thrusters"
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic,  RampUpJani, RampUpJaniFinal, LogicAlternativeA, LogicAlternativeD]
	Components : ^/0/Components
	{
		OverclockActivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 1
			OverrideTrigger = OverclockActivateTrigger
			ResetTrigger = OverclockDeactivateTrigger
		}
		OverclockDeactivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 0
			OverrideTrigger = OverclockDeactivateTrigger
			ResetTrigger = OverclockActivateTrigger
		}
		OverclockActivateTrigger
		{
			Type = DelayTrigger
			Trigger = OverclockActivateTriggerPre
			Delay = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
		}
		OverclockDeactivateTrigger
		{
			Type = DelayTrigger
			Trigger = OverclockDeactivateTriggerPre
			Delay = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
		}
		OverclockActivateTriggerPre
		{
			Type = ToggleTrigger
			Toggle = LogicAlternativeDSignal
			TriggerWhenOff = false
			AllowOperationalBypass = true
		}
		OverclockDeactivateTriggerPre
		{
			Type = ToggleTrigger
			Toggle = LogicAlternativeDSignal
			TriggerWhenOn = false
			TriggerWhenOff = true
			AllowOperationalBypass = true
		}
		LogicAlternativeDSignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeD
		}
		Triggered
		{
			Type = MultiToggle
			Toggles = [IsOperational, XorFinal]
			Mode = All
		}
		LogicAlternativeASignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeA
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}

		MainThruster : <./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/MainThruster
		{
			SoftOperationalToggle = IsOperational
			MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
		}
		
		RampUpBuff
		{
			Type = SelfBuffProvider
			BuffType = RampUpJani  //used as divide by the fixed weapon fire rate
			BuffAmount = 1
			OperationalToggle = Triggered
		}	
		EngineBuffMultiplier
		{
			Type = BuffableValue
			Value = &<./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/MainThruster/MaxActivation
		}
		RampUpJaniFinalBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = RampUpJaniFinal
			BuffAmount = { BaseValue=0; BuffType=RampUpJani; BuffMode=Add; }
			BuffMultiplier = EngineBuffMultiplier
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}
	}
}