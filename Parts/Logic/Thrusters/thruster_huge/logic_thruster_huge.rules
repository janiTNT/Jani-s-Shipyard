OVERCLOCK = &<./data/ships/terran/thruster_huge/thruster_huge.rules>/OVERCLOCK

Part : <./data/ships/terran/thruster_huge/thruster_huge.rules>/Part
{
	NameKey = "Parts/LogicThrusterHuge"
	IconNameKey = "Parts/LogicThrusterHugeIcon"
	ID = skipydog.logic_thruster_huge // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = []
	EditorParentParts = [ ["skipydog.logic_thruster_small", -1] ]
	DescriptionKey = "Parts/LogicThrusterHugeDesc"
	//EditorGroup = "Logic"
	TypeCategories = [thruster, uses_power, logic]
	SelectionTypeID = "logic_thrusters"
	ThrustIncreaseTime = 0
	ThrustRecoveryTime = 0
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, RampUpJani, RampUpJaniFinal]
	Components : ^/0/Components
	{
		Triggered
		{
			Type = MultiToggle
			Toggles = [IsOperational, XorFinal]
			Mode = All
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}

		MainThruster
		{
			Type = Thruster
			Location = [1.5, 3.5]// Relative to upper-left corner of unrotated part.
			Rotation = 90d// Relative to unrotated part.
			SoftOperationalToggle = IsOperational
			Force = &../../ThrusterForce
			MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			ActivationIncreaseTime = 0
			ActivationRecoveryTime = 0
			FuelStorage = BatteryStorage
			FuelUsagePerSecond = &../../FuelUsage
		}
		
		RampUpBuff
		{
			Type = SelfBuffProvider
			BuffType = RampUpJaniFinal  //used as divide by the fixed weapon fire rate
			BuffAmount = 1
			BuffMultiplier = RampUpTween
		}
		RampUpTween
		{
			Type = ValueAccumulator
			AccumulatingToggle = Triggered
			AccumulationRate = 
			{
				BaseValue = 1 / (&<./data/ships/terran/thruster_huge/thruster_huge.rules>/Part/ThrustIncreaseTime/BaseValue)
				Modifiers
				[
					{
						Type = Buff
						BuffType = Engine
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
					}
				]
			}
			DissipationRate = (&/Simulation/PhysicsUpdatesPerSecond) * (&<./data/ships/terran/thruster_huge/thruster_huge.rules>/Part/ThrustIncreaseTime/BaseValue) // &<./data/ships/terran/thruster_huge/thruster_huge.rules>/Part/ThrustDecreaseTime
			BaseValue = 0
			MinValue = 0
			MaxValue = &<./data/ships/terran/thruster_huge/thruster_huge.rules>/Part/Components/MainThruster/MaxActivation
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 5]
			Offset = [0, .5]
		}
	}
}