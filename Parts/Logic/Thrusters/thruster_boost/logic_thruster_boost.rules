OVERCLOCK = &<./data/ships/terran/thruster_boost/thruster_boost.rules>/OVERCLOCK

Part : <./data/ships/terran/thruster_boost/thruster_boost.rules>/Part
{
	NameKey = "Parts/LogicThrusterBoost"
	IconNameKey = "Parts/LogicThrusterBoostIcon"
	ID = janiTNT.logic_thruster_boost // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = []
	//EditorParentParts = [ ["skipydog.logic_thruster_small", -1] ]
	DescriptionKey = "Parts/LogicThrusterBoostDesc"
	EditorGroup = "Logic"
	TypeCategories = [thruster, uses_power, logic]
	SelectionTypeID = "logic_thrusters"
	ThrustIncreaseTime = 0
	ThrustRecoveryTime = 0
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, RampUpJani, RampUpJaniFinal, LogicAlternativeA, LogicAlternativeB, LogicAlternativeOverclock]
	Components : ^/0/Components
	{
		OverclockActivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 1
			OverrideTrigger = OverclockActivateTrigger
			ResetTrigger = OverclockDeactivateTrigger
		}
		OverclockDeactivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 0
			OverrideTrigger = OverclockDeactivateTrigger
			ResetTrigger = OverclockActivateTrigger
		}
		SwitchingTimeTween
		{
			Type = ValueTween
			OffValue = 0
			OnValue = 1
			OnTweenDuration = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
			OffTweenDuration = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
			IsOnToggle = LogicAlternativeOverclockSignal
		}
		OverclockActivateTrigger
		{
			Type = ThresholdTrigger
			AmountFrom = SwitchingTimeTween
			MinAmount = 1
			MaxAmount = 1
		}
		OverclockDeactivateTrigger
		{
			Type = ThresholdTrigger
			AmountFrom = SwitchingTimeTween
			MinAmount = 0
			MaxAmount = 0
		}
		LogicAlternativeOverclockSignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeOverclock
		}
		LogicAlternativeBSignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeB
		}
		
		BoostActivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = BoostToggle
			TargetMode = 1
			OverrideTrigger = BoostActivatorTrigger
			ResetTrigger = BoostDeactivatorTrigger
		}
		BoostActivatorTrigger
		{
			Type = TriggerProxy
			ProxyToggle = IsOperational
			ComponentID = BoostActivatorTriggerPre
		}
		BoostActivatorTriggerPre
		{
			Type = ToggleTrigger
			
			Toggle = LogicAlternativeBSignal
			TriggerWhenOff = false
			AllowOperationalBypass = true
		}
		BoostDeactivatorTrigger
		{
			Type = ToggleTrigger
			Toggle = LogicAlternativeBSignal
			TriggerWhenOn = false
			TriggerWhenOff = true
			AllowOperationalBypass = true
		}
		
		Triggered
		{
			Type = MultiToggle
			Toggles = [IsOperational, XorFinal]
			Mode = All
		}
		LogicAlternativeASignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeA
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}
		
		BoostOffComponents : ^/0/BoostOffComponents
		{
			Components : ^/0/Components
			{
				MainThruster
				{
					Type = Thruster
					Location = [1, 4.5]// Relative to upper-left corner of unrotated part.
					Rotation = 90d// Relative to unrotated part.
					SoftOperationalToggle = IsOperational
					Force = &~/Part/ThrusterForce
					MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
					MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
					MinUncommandedActivation = &MinActivation
					MaxUncommandedActivation = &MaxActivation
					ActivationIncreaseTime = 0
					ActivationRecoveryTime = 0
					FuelStorage = RealBatteryStorage
					FuelUsagePerSecond
					{
						BaseValue = &~/Part/FuelUsage
						Modifiers
						[
							{
								Type = BuffRemap
								BuffType = Overclock
								ModificationMode = Multiply
								RemapFrom = [0, 1]
								RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
							}
						]
					}
					AllowAutoFire = false
				}
				RampUpBuff
				{
					Type = SelfBuffProvider
					BuffType = RampUpJaniFinal  //used as divide by the fixed weapon fire rate
					BuffAmount = 1
					BuffMultiplier = RampUpTween
				}
				RampUpTween
				{
					Type = ValueAccumulator
					AccumulatingToggle = Triggered
					AccumulationRate = 
					{
						BaseValue = 1 / (&<./data/ships/terran/thruster_boost/thruster_boost.rules>/Part/ThrustIncreaseTime/BaseValue)
						Modifiers
						[
							{
								Type = Buff
								BuffType = Engine
								ModificationMode = Multiply
							}
							{
								Type = BuffRemap
								BuffType = Overclock
								ModificationMode = Multiply
								RemapFrom = [0, 1]
								RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
							}
						]
					}
					DissipationRate = (&/Simulation/PhysicsUpdatesPerSecond) * (&<./data/ships/terran/thruster_boost/thruster_boost.rules>/Part/ThrustIncreaseTime/BaseValue) // &<./data/ships/terran/thruster_boost/thruster_boost.rules>/Part/ThrustDecreaseTime
					BaseValue = 0
					MinValue = 0
					MaxValue = &<./data/ships/terran/thruster_boost/thruster_boost.rules>/Part/Components/BoostOffComponents/Components/MainThruster/MaxActivation
				}
			}
		}
		
		BoostOnComponents : ^/0/BoostOnComponents
		{
			Components : ^/0/Components
			{
				MainThrusterBoosted
				{
					Type = Thruster
					Location = [1, 4.5]// Relative to upper-left corner of unrotated part.
					Rotation = 90d// Relative to unrotated part.
					SoftOperationalToggle = IsOperational
					Force = &~/Part/BoostedThrusterForce
					MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
					MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
					MinUncommandedActivation = &MinActivation
					MaxUncommandedActivation = &MaxActivation
					ActivationIncreaseTime = 0
					ActivationRecoveryTime = 0
					FuelStorage = RealBatteryStorage
					FuelUsagePerSecond : ~/Part/Components/BoostOffComponents/Components/MainThruster/FuelUsagePerSecond
					{
						BaseValue = &~/Part/BoostedFuelUsage
						Modifiers
						[
							: ../^/0/Modifiers/0 {
								RemapTo = [1, (&~/OVERCLOCK/BOOST_BASE_POWER_USAGE_FACTOR)]
							}
							: 0 {
								BuffType = BoostOverclockPowerRamp
								RemapTo = [1, (&~/OVERCLOCK/BOOST_MAX_POWER_USAGE_FACTOR)]
							}
						]
					}
					AllowAutoFire = false
				}
				RampUpBuff
				{
					Type = SelfBuffProvider
					BuffType = RampUpJaniFinal  //used as divide by the fixed weapon fire rate
					BuffAmount = 1
					BuffMultiplier = EngineBuffMultiplier
					OperationalToggle = Triggered
				}
				EngineBuffMultiplier
				{
					Type = BuffableValue
					Value = &<./data/ships/terran/thruster_boost/thruster_boost.rules>/Part/Components/BoostOnComponents/Components/MainThrusterBoosted/MaxActivation
				}
			}
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 5]
		}
	}
	StatsNotesKey = "Stats/ThrusterBoostLogicNotes"
}