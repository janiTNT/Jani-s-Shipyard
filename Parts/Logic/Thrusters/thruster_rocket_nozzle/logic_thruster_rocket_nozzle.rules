Part : <./data/ships/terran/thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part
{
	NameKey = "Parts/LogicThrusterRocketNozzle"
	IconNameKey = "Parts/LogicThrusterRocketNozzleIcon"
	ID = janiTNT.logic_thruster_rocket_nozzle // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = []
	//EditorParentParts = [ ["skipydog.logic_thruster_small", -1] ]
	DescriptionKey = "Parts/LogicThrusterRocketNozzleDesc"
	EditorGroup = "Logic"
	TypeCategories = [thruster, uses_power, logic]
	SelectionTypeID = "logic_thrusters"
	ThrustIncreaseTime = 0
	ThrustRecoveryTime = 0
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, RampUpJani, RampUpJaniFinal, LogicAlternativeA, LogicAlternativeD]
	Components : ^/0/Components
	{
		OverclockActivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 1
			OverrideTrigger = OverclockActivateTrigger
			ResetTrigger = OverclockDeactivateTrigger
		}
		OverclockDeactivator
		{
			Type = UIToggleModeOverride
			TargetUIToggle = OverclockModeToggle
			TargetMode = 0
			OverrideTrigger = OverclockDeactivateTrigger
			ResetTrigger = OverclockActivateTrigger
		}
		OverclockActivateTrigger
		{
			Type = DelayTrigger
			Trigger = OverclockActivateTriggerPre
			Delay = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
		}
		OverclockDeactivateTrigger
		{
			Type = DelayTrigger
			Trigger = OverclockDeactivateTriggerPre
			Delay = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
		}
		OverclockActivateTriggerPre
		{
			Type = ToggleTrigger
			Toggle = LogicAlternativeDSignal
			TriggerWhenOff = false
			AllowOperationalBypass = true
		}
		OverclockDeactivateTriggerPre
		{
			Type = ToggleTrigger
			Toggle = LogicAlternativeDSignal
			TriggerWhenOn = false
			TriggerWhenOff = true
			AllowOperationalBypass = true
		}
		LogicAlternativeDSignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeD
		}
		Triggered
		{
			Type = MultiToggle
			Toggles = [IsOperational, XorFinal]
			Mode = All
		}
		LogicAlternativeASignal
		{
			Type = BuffToggle
			BuffType = LogicAlternativeA
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicAlternativeASignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}
		
		MainThruster
		{
			Type = Thruster
			Location = [1.5, 4.5]// Relative to upper-left corner of unrotated part.
			Rotation = 90d// Relative to unrotated part.
			SoftOperationalToggle = IsOperational
			Force = &../../ThrusterForce
			MinActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MaxActivation = { BaseValue=0; BuffType=RampUpJaniFinal; BuffMode=Add; }
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			ActivationIncreaseTime = 0
			ActivationRecoveryTime = 0
			FuelStorage = CombinedBatteryStorage
			FuelUsagePerSecond = &../../FuelUsage
		}

		RampUpBuff
		{
			Type = SelfBuffProvider
			BuffType = RampUpJaniFinal  //used as divide by the fixed weapon fire rate
			BuffAmount = 1
			BuffMultiplier = RampUpTween
		}
		RampUpTween
		{
			Type = ValueAccumulator
			AccumulatingToggle = Triggered
			AccumulationRate = { BaseValue=1 / (&<./data/ships/terran/thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part/ThrustIncreaseTime/BaseValue); BuffType=RocketRampUpFinal; BuffMode=Divide; }
			DissipationRate = { BaseValue=1 / (&<./data/ships/terran/thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part/ThrustDecreaseTime/BaseValue); BuffType=RocketThrust; BuffMode=Multiply; }
			BaseValue = 0
			MinValue = 0
			MaxValue = &<./data/ships/terran/thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part/Components/MainThruster/MaxActivation
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 6]
			Offset = [0, .5]
		}
	}
}