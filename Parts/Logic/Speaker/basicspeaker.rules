					//IntensityTweenDuration = 0.1
					ParentToShip = true
					UpdateMediaBuffs = true
					MediaEffects
					[
						: /BASE_SOUNDS/AudioExterior
						{
							Sound = "sounds/315594__modularsamples__whoopie-bass-c3.wav" // funky sample
							Volume = { BaseValue=1; BuffType=SpeakerVolumeBuff; BuffMode=Multiply; }
							VolumeOverIntensity = [1, 1]
							SpeedOverIntensity = [0, 99+12]
							IntensityBounds = [0, 99+12]
							Speed = 1 / 2^2 // c2
							MaxConcurrent = 0
							RampDownTime = .05
							OnlyWhenInSight = false
							MaxConcurrentVolume = 4
							//IgnoreIntensity = true
						}
					]
				}
				GlobalWhoopieBassSoundEffects : &WhoopieBassSoundEffects
				{
					OperationalToggle = GlobalRangeToggled
					MediaEffects
					[
						//: /BASE_SOUNDS/AudioExteriorLongRange
						{
							Type = Audio
							Sound = "sounds/315594__modularsamples__whoopie-bass-c3.wav" // funky sample
							Volume = { BaseValue=1; BuffType=SpeakerVolumeBuff; BuffMode=Multiply; }
							VolumeOverIntensity = [1, 1]
							SpeedOverIntensity = [0, 99+12]
							IntensityBounds = [0, 99+12]
							Speed = 1 / 2^2 // c2
							MaxConcurrent = 0
							RampDownTime = .05
