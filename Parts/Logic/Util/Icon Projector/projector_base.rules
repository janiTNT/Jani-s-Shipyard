Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Icon_Projector"
	IconNameKey = "Parts/Logic_Icon_ProjectorIcon"
	ID = janiTNT.icon_projector // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Logic"
	DescriptionKey = "Parts/Logic_Icon_ProjectorDesc"
	Resources
	[
		[steel, 4]
		[janitnt.circuit1, 8]
	]
	Size = [1, 1]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	TypeCategories = [sensor, logic, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs 
	[
	Logic
	] 
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [{Toggle = XorFinal, invert = true}, CommandToggle]
			Mode = All
		}

		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [LogicSignal, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}
		
		CommandToggle
		{
			Type = CommandToggle
		}
		
		ColorPicker
		{
			Type = UIColor
			ColorID = "projector_color"
			Default = White
		}
		
		WidthValue
		{
			Type = UIToggle
			ToggleID = "advships_width_value"
			Default = 0
			AvailableChoices = [0, 1, 2, 3]
		}
		
		Width1Toggle
		{
			Type = ModeToggle
			Mode = WidthValue
			OnMode = 0
		}
		Width2Toggle
		{
			Type = ModeToggle
			Mode = WidthValue
			OnMode = 1
		}
		Width3Toggle
		{
			Type = ModeToggle
			Mode = WidthValue
			OnMode = 2
		}
		Width4Toggle
		{
			Type = ModeToggle
			Mode = WidthValue
			OnMode = 3
		}
		
		BaseGraphics : ^/0/BaseGraphics
		{
			Roof
			{
				Layer = "roofs"
				RandomUVRotation = true
				DamageLevels
				[
					{
						File = "roof1.png"
						NormalsFile = "roof_n1.png"
						Size = [1, 1]
					}
					{
						File = "roof2.png"
						NormalsFile = "roof_n2.png"
						Size = [1, 1]
					}
					{
						File = "roof3.png"
						NormalsFile = "roof_n3.png"
						Size = [1, 1]
					}
				]
			}
		}
		
		LightBeamToggle
		{
			Type = MultiToggle
			Toggles = [{Toggle = ZeroLengthToggle_L, invert = true}, IsOperational]
			Mode = All
		}
		
		GraphicsColored
		{
			Type = Graphics
			Location = [0.5, 0.49] //how fun
			OperationalToggle = LightBeamToggle
			GetColorFrom = ColorPicker
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				Offset = [0, -1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lightbeam1.png"
							"lightbeam2.png"
							"lightbeam3.png"
							"lightbeam4.png"
						]
						AnimationInterval = 0.1
						Size = [1, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				Offset = [0, -1]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lightbeam1.png"
							"lightbeam2.png"
							"lightbeam3.png"
							"lightbeam4.png"
						]
						AnimationInterval = 0.1
						Size = [1, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, 0]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lightbeam_fancy1.png"
							"lightbeam_fancy2.png"
							"lightbeam_fancy3.png"
							"lightbeam_fancy4.png"
						]
						AnimationInterval = 0.1
						Size = [1, 4]
						Z = 0.5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*3, 255*3, 255*3]
					}
				]
			}
		}
		GraphicsColoredStatic
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			DoodadToggle = ZeroLengthToggle_L
			GetColorFrom = ColorPicker
			ShowToggledDoodadsWhenNotOperational = false
			ToggleOnDoodad
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"top projection1.png"
							"top projection2.png"
							"top projection3.png"
							"top projection4.png"
						]
						AnimationInterval = 0.1
						Size = [0.5, 0.5]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "internal light.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		
		RotationSelect
		{
			Type = UIToggle
			ToggleID = "projector_rotation"
			Default = 0
			AlwaysAllowInBuildMode = true
		}
		
		Rot0
		{
			Type = ModeToggle
			Mode = RotationSelect
			OnMode = 0
		}
		Rot1 : &Rot0
		{
			OnMode = 1
		}
		Rot2 : &Rot0
		{
			OnMode = 2
		}
		Rot3 : &Rot0
		{
			OnMode = 3
		}
		
		LengthSelect
		{
			Type = UIToggle
			ToggleID = "advships_length_value"
			Default = 0
			AlwaysAllowInBuildMode = true
		}
		
		ZeroLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 0
		}
		ZeroLength_L
		{
			Type = ToggledComponents
			Toggle = ZeroLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (0)]
					Rotation = 0d
				}
			}
		}
		OneLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 1
		}
		OneLength_L
		{
			Type = ToggledComponents
			Toggle = OneLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (1)]
					Rotation = 0d
				}
			}
		}
		TwoLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 2
		}
		TwoLength_L
		{
			Type = ToggledComponents
			Toggle = TwoLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (2)]
					Rotation = 0d
				}
			}
		}
		ThreeLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 3
		}
		ThreeLength_L
		{
			Type = ToggledComponents
			Toggle = ThreeLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (3)]
					Rotation = 0d
				}
			}
		}
		FourLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 4
		}
		FourLength_L
		{
			Type = ToggledComponents
			Toggle = FourLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (4)]
					Rotation = 0d
				}
			}
		}
		FiveLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 5
		}
		FiveLength_L
		{
			Type = ToggledComponents
			Toggle = FiveLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (5)]
					Rotation = 0d
				}
			}
		}
		SixLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 6
		}
		SixLength_L
		{
			Type = ToggledComponents
			Toggle = SixLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (6)]
					Rotation = 0d
				}
			}
		}
		SevenLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 7
		}
		SevenLength_L
		{
			Type = ToggledComponents
			Toggle = SevenLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (7)]
					Rotation = 0d
				}
			}
		}
		EightLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 8
		}
		EightLength_L
		{
			Type = ToggledComponents
			Toggle = EightLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (8)]
					Rotation = 0d
				}
			}
		}
		NineLengthToggle_L
		{
			Type = ModeToggle
			Mode = LengthSelect
			OnMode = 9
		}
		NineLength_L
		{
			Type = ToggledComponents
			Toggle = NineLengthToggle_L
			Components
			{
				PositionProxy
				{
					Type = Graphics
					Location = [0.5, 0.5 - (9)]
					Rotation = 0d
				}
			}
		}
		
		PositionImport
		{
			Type = ChainableProxy
			ComponentID = PositionProxy
		}

		Rot0Components
		{
			Type = ToggledComponents
			Toggle = Rot0
			IconRotation = 0d
			Components
			{
				RotationProxy
				{
					Type = Graphics
					ChainedTo = PositionImport
					Location = [0, 0]
					Rotation = &../../:/IconRotation
				}
			}
		}
		Rot1Components : &Rot0Components
		{
			Toggle = Rot1
			IconRotation = 90d
		}
		Rot2Components : &Rot0Components
		{
			Toggle = Rot2
			IconRotation = 180d
		}
		Rot3Components : &Rot0Components
		{
			Toggle = Rot3
			IconRotation = 270d
		}
		
		ChainedProxy
		{
			Type = ChainableProxy
			ComponentID = RotationProxy
		}
		
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		
		IconOverrideToggle
		{
			Type = UIToggle
			ToggleID = "projector_image_shipoverride"
			Default = 0
		}
		
		IsOverridingIcon
		{
			Type = MultiToggle
			Toggles = [IsOperational, IconOverrideToggle]
			Mode = All
		}
		
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
	}
}
