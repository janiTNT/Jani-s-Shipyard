Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Icon_Projector"
	IconNameKey = "Parts/Logic_Icon_ProjectorIcon"
	ID = janiTNT.icon_projector // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Logic"
	DescriptionKey = "Parts/Logic_Icon_ProjectorDesc"
	Resources
	[
		[steel, 4]
		[janitnt.circuit1, 8]
	]
	Size = [1, 1]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	TypeCategories = [sensor, logic, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs 
	[
	Logic
	] 
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : <projector_base.rules>/Part/Components
	{
		IconToggle
		{
			Type = UIToggle
			ToggleID = "projector_image_choices"
			Default = 0
		}
		
		Icon0Toggle
		{
			Type = ModeToggle
			Mode = IconToggle
			OnMode = 0
		}
		
		Icon0Components
		{
			Type = ToggledComponents
			Toggle = Icon0Toggle
			Graphic = "./Data/roof_decals/icons/faction_cabal.png"
			Components
			{
				Projection1
				{
					Type = Graphics
					Location = [0, 0]
					ChainedTo = ChainedProxy
					OperationalToggle = IsOperational
					DoodadToggle = Width1Toggle
					ShowToggledDoodadsWhenNotOperational = false
					GetColorFrom = ColorPicker
					Size = 1
					ToggleOnDoodad
					{
						Layer = "roof_doodads"
						DamageLevels
						[
							{
								File = &../../../../../:/Graphic
								Size = [(&../../../../:/Size), (&../../../../:/Size)]
							}
						]
					}
				}
				Projection2 : &Projection1
				{
					DoodadToggle = Width2Toggle
					Size = 2
				}
				Projection3 : &Projection1
				{
					DoodadToggle = Width3Toggle
					Size = 3
				}
				Projection4 : &Projection1
				{
					DoodadToggle = Width4Toggle
					Size = 4
				}
				ProjectingCustomShipIcon
				{
					Type = CustomShipIcon
					OperationalToggle = IsOverridingIcon
					Icon
					{
						Size = [48, 48]
						Texture
						{
							File = &../../../../Graphic
							SampleMode = Linear
							MipLevels = max
						}
					}
					Weight = 1
					PulseInterval = 1
					PulseColor = [255, 255, 255, 64]
					ShowAtZoom = 5
				}
			}
		}
		
		Icon1Toggle : &Icon0Toggle
		{
			OnMode = 1
		}
		
		Icon1Components : &Icon0Components
		{
			Toggle = Icon1Toggle
			Graphic = "./Data/roof_decals/icons/faction_fringe.png"
			Components : &^/0/Components
			{
				ProjectingCustomShipIcon : &^/0/ProjectingCustomShipIcon
				{
					Icon : &^/0/Icon
					{
						Texture : &^/0/Texture
						{
							File = &../../../../Graphic // for some reason bugged
						}
					}
				}
			}
		}
		
		Icon2Toggle : &Icon0Toggle
		{
			OnMode = 2
		}
		
		Icon2Components : &Icon0Components
		{
			Toggle = Icon2Toggle
			Graphic = "./Data/roof_decals/icons/faction_imperium.png"
			Components : &^/0/Components
			{
				ProjectingCustomShipIcon : &^/0/ProjectingCustomShipIcon
				{
					Icon : &^/0/Icon
					{
						Texture : &^/0/Texture
