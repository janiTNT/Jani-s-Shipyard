Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Hull_Sensor"
	IconNameKey = "Parts/Logic_Hull_SensorIcon"
	ID = janiTNT.hull_sensor // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Logic"
	DescriptionKey = "Parts/Logic_Hull_SensorDesc"
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 2]
	]
	Size = [1, 1]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	//SelectionTypeID = "comparator"
	TypeCategories = [sensor, logic, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs 
	[
	Logic, AdvS_Setting, AdvS_Setting_Second, AdvS_Setting_Third
	CloudyNebula_JS
	//ElectronNebula_JS
	ElectronNebula
	Ion_stormNebula_JS
	] 
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	&/JANI_COMMON/SettingsOnes/Part/Components
	&/JANI_COMMON/SettingsTens/Part/Components
	&/JANI_COMMON/SettingsHundreds/Part/Components //AdvS_Setting_Third
	<../../base_outputlogicpart.rules>/Base
	{
		SignalAComponents
		{
			Type = ToggledComponents
			Toggle = SignalAToggle
			Components
			{
				BuffProviderLogicA : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeA
				}
			}
		}
		SignalBComponents
		{
			Type = ToggledComponents
			Toggle = SignalBToggle
			Components
			{
				BuffProviderLogicB : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeB
				}
			}
		}
		SignalCComponents
		{
			Type = ToggledComponents
			Toggle = SignalCToggle
			Components
			{
				BuffProviderLogicC : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeC
				}
			}
		}
		SignalDComponents
		{
			Type = ToggledComponents
			Toggle = SignalDToggle
			Components
			{
				BuffProviderLogicD : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeD
				}
			}
		}
		SignalOverclockComponents
		{
			Type = ToggledComponents
			Toggle = SignalOverclockToggle
			Components
			{
				BuffProviderLogicOverclock : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeOverclock
				}
			}
		}	
		HullSensorMode
		{
			Type = UIToggle
			ToggleID = "logic_sensor_detection_mode"
			Default = 0
			//AvailableChoices = [0, 2, 3]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		} 
		
		NumberSelectVisibility
		{
			Type = MultiToggle
			Toggles = [HeatLevelToggle, NebulaLevelToggle]
			Mode = Any
		}
		
		NumberSelectOnes : ^/1/NumberSelectOnes
		{
			VisibilityToggle = NumberSelectVisibility
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility
		}
		NumberSelectTens : ^/2/NumberSelectTens
		{
			VisibilityToggle = NumberSelectVisibility
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility
		}
		NumberSelectHunds : ^/3/NumberSelectHunds
		{
			VisibilityToggle = NumberSelectVisibility
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility 
		}
		
		NebulaSensorMode
		{
			Type = UIToggle
			ToggleID = "logic_sensor_nebula_detection_mode"
			Default = 0
			//AvailableChoices = [0, 2, 3]
			//AlwaysAllowInBuildMode = true
			RequiresCommand = false
			VisibilityToggle = NebulaLevelToggle
		}

		HeatLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 0
		}
		HeatLevelComponents
		{
			Type = ToggledComponents
			Toggle = HeatLevelToggle
			IncludeInBlueprints = true
			Components
			{
				ValueProxy
				{
					Type = ValueProxy
					ComponentID = HeatValue
				}
				HeatValue
				{
					Type = BuffableValue
					Value
					{
						Basevalue = 1
						//MaxValue = 1//prevent divide by zero giving one quintillion
						Modifiers
						[
							{
								Type = Status
								StatusType = cosmoteer.heat
								ModificationMode = Multiply
							}
							{
								Type = ScaledBuff
								BuffType = AdvS_Setting_Third
								ModificationMode = Divide
								Scale = 10 // 1 at 10 heat
								MaxValue = 1
							}
						]
					}
				}
			}
		}
		
		CommandLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 1
		}
		CommandLevelComponents
		{
			Type = ToggledComponents
			Toggle = CommandLevelToggle
			IncludeInBlueprints = true
			Components
			{
				ValueProxy
				{
					Type = ToggleValueSelector
					Toggle = CommandToggle
					ToggleOffValue = Zero
					ToggleOnValue = One
				}
				CommandToggle
				{
					Type = CommandToggle
				}
			}
		}
		
		JunkLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 2
		}
		JunkLevelComponents
		{
			Type = ToggledComponents
			Toggle = JunkLevelToggle
			IncludeInBlueprints = true
			Components
			{
				ValueProxy
				{
					Type = ToggleValueSelector
					Toggle = JunkToggle
					ToggleOffValue = Zero
					ToggleOnValue = One
				}
				JunkToggle
				{
					Type = JunkToggle
					OnWhenJunk = true
				}
			}
		}
		
		FtlLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 3
		}
		FtlLevelComponents
		{
			Type = ToggledComponents
			Toggle = FtlLevelToggle
			IncludeInBlueprints = true
			Components
			{
				ValueProxy
				{
					Type = ToggleValueSelector
					Toggle = SensingStorage
					ToggleOffValue = One
					ToggleOnValue = Zero
				}
				SensingStorage
				{
					Type = ResourceStorage
					ResourceType = fake
					MaxResources = 150
					ToggleOnResources = 150
					DrainOnFtlJump = true
					StartingResources = &MaxResources
					//InitToMaxResources = true
				}
				SensingRestore
				{
					Type = ResourceConverter
					OperationalToggle = SensingStorage
					InvertOperationalToggle = true
					ToStorage = SensingStorage
					ToQuantity = 30
					Interval = 1
				}
			}
		}
		
		DirectControlLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 4
		}
		DirectControlLevelComponents
		{
			Type = ToggledComponents
			Toggle = DirectControlLevelToggle
			IncludeInBlueprints = true
			Components
			{
				ValueProxy
				{
					Type = ToggleValueSelector
					Toggle = IsInDCMode
					ToggleOffValue = Zero
					ToggleOnValue = One
				}
				IsInDCMode
				{
					Type = DirectControlToggle
				}
			}
		}
		
		NebulaLevelToggle
		{
			Type = ModeToggle
			Mode = HullSensorMode
			OnMode = 5
		}
		NebulaLevelComponents
		{
			Type = ToggledComponents
			Toggle = NebulaLevelToggle
			IncludeInBlueprints = true
			Components
			{
				CloudyNebulaToggle
				{
					Type = ModeToggle
					Mode = NebulaSensorMode
					OnMode = 0
				}
				CloudyComponents
				{
					Type = ToggledComponents
					Toggle = CloudyNebulaToggle
					IncludeInBlueprints = true
					Components
					{
						CloudybuffToggle
						{
							Type = BuffToggle
							BuffType = CloudyNebula_JS
						}
						ValueProxy
						{
							Type = ToggleValueSelector
							Toggle = CloudybuffToggle
							ToggleOffValue = Zero
							ToggleOnValue = ValueNebula
						}
						ValueNebula
						{
							Type = BuffableValue
							Value
							{
								Basevalue = 1
								Modifiers
								[
									{
										Type = Buff
										BuffType = CloudyNebula_JS
										ModificationMode = Multiply
									}
									{
										Type = ScaledBuff
										BuffType = AdvS_Setting_Third
										ModificationMode = Divide
										Scale = 0.01 // 1 at 10 heat
										MaxValue = 1
									}
								]
							}
						}
					}
				}
				ElectronNebulaToggle
				{
					Type = ModeToggle
					Mode = NebulaSensorMode
					OnMode = 1000
				}
				ElectronComponents
				{
					Type = ToggledComponents
					Toggle = ElectronNebulaToggle
					IncludeInBlueprints = true
					Components
					{
						ElectronbuffToggle
						{
							Type = BuffToggle
							BuffType = ElectronNebula
						}
						ValueProxy
						{
							Type = ToggleValueSelector
							Toggle = ElectronbuffToggle
							ToggleOffValue = Zero
							ToggleOnValue = ValueNebula
						}
						ValueNebula
						{
							Type = BuffableValue
							Value
							{
								Basevalue = 1
								Modifiers
								[
									{
										Type = Buff
										BuffType = ElectronNebula
										ModificationMode = Multiply
									}
									{
										Type = ScaledBuff
										BuffType = AdvS_Setting_Third
										ModificationMode = Divide
										Scale = 0.01 // 1 at 10 heat
										MaxValue = 1
									}
								]
							}
						}
					}
				}
				Ion_StormNebulaToggle
				{
					Type = ModeToggle
					Mode = NebulaSensorMode
					OnMode = 2000
				}
				Ion_StormComponents
				{
					Type = ToggledComponents
					Toggle = Ion_StormNebulaToggle
					IncludeInBlueprints = true
					Components
					{
						Ion_StormbuffToggle
						{
							Type = BuffToggle
							BuffType = Ion_stormNebula_JS
						}
						ValueProxy
						{
							Type = ToggleValueSelector
							Toggle = Ion_StormbuffToggle
							ToggleOffValue = Zero
							ToggleOnValue = ValueNebula
						}
						ValueNebula
						{
							Type = BuffableValue
							Value
							{
								Basevalue = 1
								Modifiers
								[
									{
										Type = Buff
										BuffType = Ion_stormNebula_JS
										ModificationMode = Multiply
									}
									{
										Type = ScaledBuff
										BuffType = AdvS_Setting_Third
										ModificationMode = Divide
										Scale = 0.01 // 1 at 10 heat
										MaxValue = 1
									}
								]
							}
						}
					}
				}
			}
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }
		
		OutputSignal
		{
			Type = MultiToggle
			Toggles = [XorFinal, LogicSignal]
			Mode = Any
		}
		InvertInput
		{
			Type = UIToggle
			ToggleID = "skipydog_invert_input_toggle"
			Default = 0
		}
//|||||||||||||||||||||||| XOR ||||||||||||||||||||||||
		XorToggle1
		{
			Type = MultiToggle
			Toggles = [Maxed, InvertInput]
			Invert = true
			Mode = Any
		}
		XorToggle2
		{
			Type = MultiToggle
			Toggles = [Maxed, InvertInput]
			Invert = false
			Mode = All
		}
		XorFinal
		{
			Type = MultiToggle
			Toggles = [XorToggle2, XorToggle1]
			Invert = true
			Mode = Any
		}
		
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		
		ValueCheck
		{
			Type = ValueProxy
			ComponentID = ValueProxy
		}
		
		VisualGaugeValue
		{
			Type = BuffableValue
			Value = { BaseValue=0.01; BuffType=AdvS_Setting_Third; BuffMode=Multiply; }
		}
		
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Red
		}
		Maxed
		{
			Type = ThresholdToggle
			ValueFrom = ValueCheck
			MinAmount = 100%
		}
		BuffProviderLogic
		{
			Type = AreaBuffProvider
			OperationalToggle = OutputSignal
			BuffType = Logic
			BuffAmount = 1
			BuffArea = [0, 1, 1, 1]
		}
		LocationLerpDefined
		{
			Type = TransformLerp
			Location = [0.5, 0.5]
			StartLocation = [0, 1/64]
			EndLocation = [0, -10/64]
			ValueFrom = VisualGaugeValue
		}
		HandleGraphic
		{
			Type = Graphics
			Location = [0, 0]
			ChainedTo = LocationLerpDefined
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "risers.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		AnalogLights
		{
			Type = ValueSprites
			Location = [0.5, 0.5]
			ValueFrom = ValueCheck
			Layer = "lights_add"
			//Range = [-1, 0]
			Round = Down
			ResourceLevels
			[
				{
					//Blank Frame
				}
				{
					File = "analog1.png"
					Size = [1, 1]
				}
				{
					File = "analog2.png"
					Size = [1, 1]
				}
				{
					File = "analog3.png"
					Size = [1, 1]
				}
				{
					File = "analog4.png"
					Size = [1, 1]
				}
			]
		}
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = OutputSignal
			ShowToggledDoodadsWhenNotOperational = false
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads2.png"
						Size = [1, 1]
						Offset = [0, 0.5]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads1.png"
						Size = [1, 1]
						Offset = [0, 0.5]
					}
				]
			}
			
		}
		WireGraphics
		{
			Type = Graphics
			Location = [15/64, 15/64]
			OperationalToggle = XorFinal
			OperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "wire2.png"
						Size = [1, 2]
						Offset = [17/64, 0.5 + 17/64]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "wire1.png"
						Size = [1, 2]
						Offset = [17/64, 0.5 + 17/64]
					}
				]
			}
			Walls
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "spinlight.png"
