Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Gauge_Comparator"
	IconNameKey = "Parts/Logic_Gauge_ComparatorIcon"
	ID = janiTNT.gauge_comparator // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Logic"
	DescriptionKey = "Parts/Logic_Gauge_ComparatorDesc"
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 4]
	]
	Size = [1, 1]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "comparator"
	TypeCategories = [sensor, logic, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, AdvS_Setting, AdvS_Setting_Second] 
	EditorIcon
	{
		Texture
		{
			File = "icon_gauge.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}
	Components : ^/0/Components
	&/JANI_COMMON/SettingsOnes/Part/Components
	&/JANI_COMMON/SettingsTens/Part/Components
	{	
		BlueprintNetworkNode = &<comparator.rules>/Part/Components/BlueprintNetworkNode
		Port_Up = &<comparator.rules>/Part/Components/Port_Up
		NetworkHeatOutputProxy = &<comparator.rules>/Part/Components/NetworkHeatOutputProxy
		ComparatorType = &<comparator.rules>/Part/Components/ComparatorType
		EnergyToggle = &<comparator.rules>/Part/Components/EnergyToggle
		EnergyComponents = &<comparator.rules>/Part/Components/EnergyComponents
		ThrustToggle = &<comparator.rules>/Part/Components/ThrustToggle
		ThrustComponents = &<comparator.rules>/Part/Components/ThrustComponents
		HeatToggle = &<comparator.rules>/Part/Components/HeatToggle
		HeatComponents = &<comparator.rules>/Part/Components/HeatComponents
		CheckForOperationalToggle = &<comparator.rules>/Part/Components/CheckForOperationalToggle
		CheckForOperationalComponents = &<comparator.rules>/Part/Components/CheckForOperationalComponents
		
		OutputSignal
		{
			Type = MultiToggle
			Toggles = [Maxed, LogicSignal]
			Mode = Any
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		
		ValueCheck
		{
			Type = ValueProxy
			ComponentID = ValueProxy
		}
		
		GaugeValue
		{
			Type = BuffableValue
			Value = { BaseValue=-0.01; BuffType=AdvS_Setting_Second; BuffMode=Multiply; }
		}
		
		VisualGaugeValue
		{
			Type = BuffableValue
			Value = { BaseValue=0.01; BuffType=AdvS_Setting_Second; BuffMode=Multiply; }
		}
		
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Red
		}
		RotationLerpValue
		{
			Type = TransformLerp
			Location = [0.5, 0.5 - 0.25]
			StartRotation = -89.5d
			EndRotation = 89.5d
			ValueFrom = ValueCheck
		}
		RotationLerpDefined
		{
			Type = TransformLerp
			Location = [0.5, 0.5 - 0.25]
			StartRotation = -89.5d
			EndRotation = 89.5d
			ValueFrom = VisualGaugeValue
		}
		TotalMultiValue
		{
			Type = MultiValue
			Values
			[
				ValueCheck
				GaugeValue
			]
			Mode = Add
		}
		Maxed
		{
			Type = ThresholdToggle
			ValueFrom = TotalMultiValue
			MinAmount = 0%
		}
		BuffProviderLogicA
		{
			Type = AreaBuffProvider
			OperationalToggle = OutputSignal
			BuffType = Logic
			BuffAmount = 1
			BuffArea = [0, 1, 1, 1]
		}
		GaugeHandleGraphic
		{
			Type = Graphics
			Location = [0, 0]
			ChainedTo = RotationLerpValue
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "gauge.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		GaugeTickGraphic
		{
			Type = Graphics
			Location = [0, 0]
			ChainedTo = RotationLerpDefined
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "gauge2.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = OutputSignal
			ShowToggledDoodadsWhenNotOperational = false
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doothose2.png"
						Size = [1, 1]
						Offset = [0, 0.5]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doothose1.png"
						Size = [1, 1]
						Offset = [0, 0.5]
					}
				]
			}
			
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = OutputSignal
			ShowToggledDoodadsWhenNotOperational = false
			OperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "advanced2.png"
						Size = [1, 2]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "advanced1.png"
						Size = [1, 2]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints3.png"
			Size = [1, 1]
		}
	}
}
