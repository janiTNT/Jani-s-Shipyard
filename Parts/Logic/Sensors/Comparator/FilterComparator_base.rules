Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Comparator_Resources"
	IconNameKey = "Parts/Logic_Comparator_ResourcesIcon"
	ID = janiTNT.comparator_filter_ // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	DescriptionKey = "Parts/Logic_Comparator_ResourcesDesc"
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 2]
		[cut.tristeel, 1]
	]
	Size = [1, 1]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "comparator"
	TypeCategories = [sensor, logic, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic]
	EditorIcon
	{
		Texture
		{
			File = "icon_filter.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		ValueCheck
		{
			Type = ValueProxy
			ComponentID = ValueProxy
		}
		
		OutputSignal
		{
			Type = MultiToggle
			Toggles = [Minimal, LogicSignal]
			Mode = Any
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Red
		}
		Minimal
		{
			Type = ThresholdToggle
			ValueFrom = ValueCheck
			MinAmount = 0.0000000000001%
		}
		Maxed
		{
			Type = ThresholdToggle
			ValueFrom = ValueCheck
			MinAmount = 100%
		}
		BuffProviderLogicA
		{
			Type = AreaBuffProvider
			OperationalToggle = OutputSignal
			BuffType = Logic
			BuffAmount = 1
			BuffArea = [0, 1, 1, 1]
		}
		BuffProviderLogicB
		{
			Type = AreaBuffProvider
			OperationalToggle = Maxed
			BuffType = Logic
			BuffAmount = 1
			BuffArea = [-1, 0, 3, 1]
		}
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = OutputSignal
			DoodadToggle = Maxed
			ShowToggledDoodadsWhenNotOperational = false
			GetColorFrom = ColorPicker
			ToggleOnDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads3.png"
						Size = [2, 1]
						Offset = [0, 0.25]
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads2.png"
						Size = [2, 1]
						Offset = [0, 0.25]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads1.png"
						Size = [2, 1]
						Offset = [0, 0.25]
					}
				]
			}
			
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = OutputSignal
			DoodadToggle = Maxed
			ShowToggledDoodadsWhenNotOperational = false
			ToggleOnDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "filter3.png"
						Size = [2, 2]
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "filter2.png"
						Size = [2, 2]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "filter1.png"
						Size = [2, 2]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints2.png"
			Size = [1, 1]
		}
	}
}
