Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/LogicWireSplitter1"
	IconNameKey = "Parts/LogicWireSplitter1Icon"
	ID = Skipydog.Logic_Splitter
	EditorParentParts = [ "Skipydog.Logic_Wire" ]
	SelectionTypeID = "logic_wire"
	DescriptionKey = "Parts/LogicWireSplitterDesc"
	Size = [1, 1]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	Components : ^/0/Components
	<../../base_outputlogicpart.rules>/Base
	{
		SignalAComponents
		{
			Type = ToggledComponents
			Toggle = SignalAToggle
			Components
			{
				BuffProviderLogicA : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeA
				}
				BuffProviderLogicA2 : ~/Part/Components/BuffProviderLogic2
				{
					BuffType = LogicAlternativeA
				}
			}
		}
		SignalBComponents
		{
			Type = ToggledComponents
			Toggle = SignalBToggle
			Components
			{
				BuffProviderLogicB : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeB
				}
				BuffProviderLogicB2 : ~/Part/Components/BuffProviderLogic2
				{
					BuffType = LogicAlternativeB
				}
			}
		}
		SignalCComponents
		{
			Type = ToggledComponents
			Toggle = SignalCToggle
			Components
			{
				BuffProviderLogicC : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeC
				}
				BuffProviderLogicC2 : ~/Part/Components/BuffProviderLogic2
				{
					BuffType = LogicAlternativeC
				}
			}
		}
		SignalDComponents
		{
			Type = ToggledComponents
			Toggle = SignalDToggle
			Components
			{
				BuffProviderLogicD : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeD
				}
				BuffProviderLogicD2 : ~/Part/Components/BuffProviderLogic2
				{
					BuffType = LogicAlternativeD
				}
			}
		}
		SignalOverclockComponents
		{
			Type = ToggledComponents
			Toggle = SignalOverclockToggle
			Components
			{
				BuffProviderLogicOverclock : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeOverclock
				}
				BuffProviderLogicOverclock2 : ~/Part/Components/BuffProviderLogic2
				{
					BuffType = LogicAlternativeOverclock
				}
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
			//Offset = [0, -0.5]
		}
		BuffProviderLogic
		{
			Type = AreaBuffProvider
			OperationalToggle = OperationalNotCombined
			BuffType = Logic
			ChainsFromBuffType = &BuffType
			BuffAmount = 1
			BuffArea = [1, 0, 1, 1]
		}
		BuffProviderLogic2
		{
			Type = AreaBuffProvider
			OperationalToggle = OperationalNotCombined
			BuffType = Logic
			ChainsFromBuffType = &BuffType
			BuffAmount = 1
			BuffArea = [-1, 0, 1, 1]
		}
		CombineType
		{
			Type = UIToggle
			ToggleID = "logic_signal_unique_or_combined"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		CombinationComponents
		{
			Type = ToggledComponents
			Toggle = CombineType
			IncludeInBlueprints = false
			Components
			{
				CombinationBuffProviderLogic : &../../BuffProviderLogic
				{
					OperationalToggle = CombineType
					BuffAmount = { BaseValue=0; BuffType=Logic; BuffMode=Add }
				}
				CombinationBuffProviderLogic2 : &../../BuffProviderLogic2
				{
					OperationalToggle = CombineType
					BuffAmount = { BaseValue=0; BuffType=Logic; BuffMode=Add }
				}
				CombinationBuffProviderLogicA : &CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeA
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeA; BuffMode=Add }
				}
				CombinationBuffProviderLogicA2 : &CombinationBuffProviderLogic2
				{
					BuffType = LogicAlternativeA
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeA; BuffMode=Add }
				}
				CombinationBuffProviderLogicB : &CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeB
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeB; BuffMode=Add }
				}
				CombinationBuffProviderLogicB2 : &CombinationBuffProviderLogic2
				{
					BuffType = LogicAlternativeB
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeB; BuffMode=Add }
				}
				CombinationBuffProviderLogicC : &CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeC
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeC; BuffMode=Add }
				}
				CombinationBuffProviderLogicC2 : &CombinationBuffProviderLogic2
				{
					BuffType = LogicAlternativeC
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeC; BuffMode=Add }
				}
				CombinationBuffProviderLogicD : &CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeD
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeD; BuffMode=Add }
				}
				CombinationBuffProviderLogicD2 : &CombinationBuffProviderLogic2
				{
					BuffType = LogicAlternativeD
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeD; BuffMode=Add }
				}
				CombinationBuffProviderLogicOverclock : &CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeOverclock
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeOverclock; BuffMode=Add }
				}
				CombinationBuffProviderLogicOverclock2 : &CombinationBuffProviderLogic2
				{
					BuffType = LogicAlternativeOverclock
					BuffAmount = { BaseValue=0; BuffType=LogicAlternativeOverclock; BuffMode=Add }
				}
			}
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [LogicSignal]
			Invert = false
			Mode = All
		}
		OperationalNotCombined
		{
			Type = MultiToggle
			Toggles = [IsOperational, {Toggle = CombineType, invert = true}]
			Mode = All
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
			MinBuffValue = 0.0000000000001 //fix so zero value does not activate
		}
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Green
		}
		//-----------------------------------------------------------------
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads2.png"
						Size = [2, 1]
						Offset = [0, 0]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads1.png"
						Size = [2, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "wire.png"
						Size = [2, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		BaseGraphics : <../../baselogicpart.rules>/BaseGraphics_ToggleCombine
		{
			OperationalToggle = CombineType
		}
	}
}
