Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Jump_Wire"
	IconNameKey = "Parts/Logic_Jump_Wire_Icon"
	ID = Skipydog.logic_jump_wire
	EditorGroup = "Logic"
	DescriptionKey = "Parts/Logic_Jump_Wire_Desc"
	Size = [1, 1]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic]
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 8]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}

	Components : ^/0/Components
	<jump_wire_stuff.rules>/Part/Components
	{
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Green
		}
		//-----------------------------------------------------------------
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = LogicSignal
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads2.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads1.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "wire.png"
						Size = [1, 2]
						Offset = [0, -0.5]
					}
				]
			}
		}
	}
}
