						[
							{
								File = "doomoms2.png"
								Size = [1, 1]
							}
						]
					}
					NonOperationalDoodad
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								File = "doomoms1.png"
								Size = [1, 1]
							}
						]
					}
				}
			}
		}

