Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/Logic_Jump_Wire_Superlong"
	IconNameKey = "Parts/Logic_Jump_Wire_SuperlongIcon"
	ID = janiTNT.logic_jump_wire_superlong
	EditorParentParts = [ "Skipydog.Logic_Wire" ]
	SelectionTypeID = "logic_wire"
	DescriptionKey = "Parts/Logic_Jump_Wire_SuperlongDesc"
	Size = [1, 1]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, LogicAlternativeA, LogicAlternativeB, LogicAlternativeC, LogicAlternativeD, LogicAlternativeOverclock]
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 14]
		[coil, 2]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}

	Components : ^/0/Components
	<jump_wire_stuff_superlong.rules>/Part/Components
	<../../base_outputlogicpart.rules>/Base
	{
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [LogicSignal]
			Invert = false
			Mode = All
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
			MinBuffValue = 0.0000000000001 //fix so zero value does not activate
		}
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Green
		}
		CombineType
		{
			Type = UIToggle
			ToggleID = "logic_signal_unique_or_combined"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		OperationalNotCombined
		{
			Type = MultiToggle
			Toggles = [IsOperational, {Toggle = CombineType, invert = true}]
			Mode = All
		}
		//-----------------------------------------------------------------
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads2.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "doodads1.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "wire.png"
						Size = [1, 2]
						Offset = [0, -0.5]
						VertexColor = [256/2,256/2, 256/2]
					}
				]
			}
		}
		BaseGraphics : <../../baselogicpart.rules>/BaseGraphics_ToggleCombineAdvanced
		{
			OperationalToggle = CombineType
		}
	}
}
