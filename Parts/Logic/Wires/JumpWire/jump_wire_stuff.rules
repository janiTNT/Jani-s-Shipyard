					{
						BuffProviderLogicOverclock : ../../../Components/BuffProviderLogic
						{
							BuffType = LogicAlternativeOverclock
						}
					}
				}
				EndGraphics
				{
					Type = Graphics
					Location = [0.5, -1.5 - (&../../../:/Range)]
					OperationalToggle = LogicSignal
					Walls
					{
						Layer = "doors"
						DamageLevels
						[
							{
								File = "end.png"
								Size = [1, 1]
							}
						]
					}
				}
				ColoredEndGraphics
				{
					Type = Graphics
					Location = &../EndGraphics/Location
					OperationalToggle = LogicSignal
					GetColorFrom = ColorPicker
