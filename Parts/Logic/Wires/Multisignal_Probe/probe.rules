Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/LogicWireProbe"
	IconNameKey = "Parts/LogicWireProbeIcon"
	ID = janiTNT.Signal_Probe
	EditorParentParts = [ "Skipydog.Logic_Wire", ["janiTNT.ValueOperatorLogic", 1] ]
	SelectionTypeID = "logic_wire"
	DescriptionKey = "Parts/LogicWireProbeDesc"
	Size = [1, 1]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, LogicAlternativeA, LogicAlternativeB, LogicAlternativeC, LogicAlternativeD, LogicAlternativeOverclock]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	Components : <../Wire1/Wire1.rules>/Part/Components
	{
		DecimalsToggle
		{
			Type = UIToggle
			ToggleID = "logic_multimiter_decimals"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		One { Type = StaticValue; Value = 1; }
		OneThousand { Type = StaticValue; Value = 1000; }
		Multiplier
		{
			Type = ToggleValueSelector
			Toggle = DecimalsToggle
			//BlueprintToggle = True
			ToggleOnValue = OneThousand
			ToggleOffValue = One
			//IncludeInBlueprints = true
		}
		LogicInputABuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=LogicAlternativeA; BuffMode=Add }
		}
		LogicInputAValue
		{
			Type = MultiValue
			Values = [LogicInputABuffableValue, Multiplier]
			Mode = Multiply
			Abs = true
		}
		LogicInputBBuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=LogicAlternativeB; BuffMode=Add }
		}
		LogicInputBValue : LogicInputAValue
		{
			Values = [LogicInputBBuffableValue, Multiplier]
		}
		LogicInputCBuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=LogicAlternativeC; BuffMode=Add }
		}
		LogicInputCValue : LogicInputAValue
		{
			Values = [LogicInputCBuffableValue, Multiplier]
		}
		LogicInputDBuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=LogicAlternativeD; BuffMode=Add }
		}
		LogicInputDValue : LogicInputAValue
		{
			Values = [LogicInputDBuffableValue, Multiplier]
		}
		LogicInputBuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=Logic; BuffMode=Add }
		}
		LogicInputValue : LogicInputAValue
		{
			Values = [LogicInputBuffableValue, Multiplier]
		}
		LogicInputOverclockBuffableValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=LogicAlternativeOverclock; BuffMode=Add }
		}
		LogicInputOverclockValue : LogicInputAValue
		{
			Values = [LogicInputOverclockBuffableValue, Multiplier]
		}
		
		NegativeToggleA
		{
			Type = ThresholdToggle
			ValueFrom = LogicInputABuffableValue
			MaxAmount = -0.000000001
		}
		NegativeToggleB : NegativeToggleA
		{
			ValueFrom = LogicInputBBuffableValue
		}
		NegativeToggleC : NegativeToggleA
		{
			ValueFrom = LogicInputCBuffableValue
		}
		NegativeToggleD : NegativeToggleA
		{
			ValueFrom = LogicInputDBuffableValue
		}
		NegativeToggle : NegativeToggleA
		{
			ValueFrom = LogicInputBuffableValue
		}
		NegativeToggleOverclock : NegativeToggleA
		{
			ValueFrom = LogicInputOverclockBuffableValue
		}
		
		NegativeSpriteA
		{
			Type = Sprite
			OperationalToggle = NegativeToggleA
			Location = [.5, .5]
			Layer = "lights_add"
			AtlasSprite
			{
				File = "A.png"
				Size = [1, 1]
			}
		}
		
		NegativeSpriteB : NegativeSpriteA
		{
			OperationalToggle = NegativeToggleB
			AtlasSprite
			{
				File = "B.png"
				Size = [1, 1]
			}
		}
		
		NegativeSpriteC : NegativeSpriteA
		{
			OperationalToggle = NegativeToggleC
			AtlasSprite
			{
				File = "C.png"
				Size = [1, 1]
			}
		}
		
		NegativeSpriteD : NegativeSpriteA
		{
			OperationalToggle = NegativeToggleD
			AtlasSprite
			{
				File = "D.png"
				Size = [1, 1]
			}
		}
		
		NegativeSprite : NegativeSpriteA
		{
			OperationalToggle = NegativeToggle
			AtlasSprite
			{
				File = "basic.png"
				Size = [1, 1]
			}
		}
		
		NegativeSpriteOverclock : NegativeSpriteA
		{
			OperationalToggle = NegativeToggleOverclock
			AtlasSprite
			{
				File = "Overclock.png"
				Size = [1, 1]
			}
		}
		
