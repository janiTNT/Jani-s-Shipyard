Part : <../../baselogicpart.rules>/Part
{
	NameKey = "Parts/LogicGateBulb"
	IconNameKey = "Parts/LogicGateBulbIcon"
	ID = janiTNT.Logic_Gate_Bulb
	OtherIDs = [Skipydog.Logic_Switch]
	EditorGroup = "Logic"
	DescriptionKey = "Parts/LogicGateBulbDesc"
	Resources
	[
		[steel, 2]
		[janitnt.circuit1, 3]
	]
	Size = [1, 1]
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic, AdvS_Setting, AdvS_Setting_Second, AdvS_Setting_Third]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	Components : ^/0/Components
	&/JANI_COMMON/SettingsOnes/Part/Components
	&/JANI_COMMON/SettingsTens/Part/Components
	&/JANI_COMMON/SettingsHundreds/Part/Components
	<../../base_outputlogicpart.rules>/Base
	{
		SignalAComponents
		{
			Type = ToggledComponents
			Toggle = SignalAToggle
			Components
			{
				BuffProviderLogicA : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeA
				}
				CombinationBuffProviderLogicA : ~/Part/Components/CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeA
				}
			}
		}
		SignalBComponents
		{
			Type = ToggledComponents
			Toggle = SignalBToggle
			Components
			{
				BuffProviderLogicB : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeB
				}
				CombinationBuffProviderLogicB : ~/Part/Components/CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeB
				}
			}
		}
		SignalCComponents
		{
			Type = ToggledComponents
			Toggle = SignalCToggle
			Components
			{
				BuffProviderLogicC : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeC
				}
				CombinationBuffProviderLogicC : ~/Part/Components/CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeC
				}
			}
		}
		SignalDComponents
		{
			Type = ToggledComponents
			Toggle = SignalDToggle
			Components
			{
				BuffProviderLogicD : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeD
				}
				CombinationBuffProviderLogicD : ~/Part/Components/CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeD
				}
			}
		}
		SignalOverclockComponents
		{
			Type = ToggledComponents
			Toggle = SignalOverclockToggle
			Components
			{
				BuffProviderLogicOverclock : ~/Part/Components/BuffProviderLogic
				{
					BuffType = LogicAlternativeOverclock
				}
				CombinationBuffProviderLogicOverclock : ~/Part/Components/CombinationBuffProviderLogic
				{
					BuffType = LogicAlternativeOverclock
				}
			}
		}
		CombineType
		{
			Type = UIToggle
			ToggleID = "logic_signal_unique_or_combined"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		NumberSelectOnes : ^/1/NumberSelectOnes
		{
			VisibilityToggle = CombineType
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility
			//AvailableChoices = [1,2,3,4,5,6,7,8,9]
			Default = 1
		}
		NumberSelectTens : ^/2/NumberSelectTens
		{
			VisibilityToggle = CombineType
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility
			Default = 0
		}
		NumberSelectHunds : ^/3/NumberSelectHunds
		{
			VisibilityToggle = CombineType
			//AlwaysAllowInBuildMode = false
			//OperationalToggle = NumberSelectVisibility
			Default = 0
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
			//Offset = [0, -0.5]
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [ToggledOn]
			Invert = false
			Mode = All
		}
		OperationalNotCombined
		{
			Type = MultiToggle
			Toggles = [IsOperational, {Toggle = CombineType, invert = true}]
			Mode = All
		}
		OperationalCombined
		{
			Type = MultiToggle
			Toggles = [IsOperational, CombineType]
			Mode = All
		}
		BuffProviderLogic
		{
			Type = AreaBuffProvider
			OperationalToggle = OperationalNotCombined
			BuffType = Logic
			ChainsFromBuffType = &BuffType
			BuffAmount = 1
			BuffArea = [0, -1, 1, 1]
		}
		CombinationBuffProviderLogic : &BuffProviderLogic
		{
			OperationalToggle = OperationalCombined
			BuffAmount = { BaseValue=0; BuffType=AdvS_Setting_Third; BuffMode=Add }
		}
		LogicTrigger
		{
			Type = ToggleTrigger
			Toggle = LogicSignal
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ManualTrigger
		{
			Type = UITrigger
			TriggerID = "janilogicflip"
		}
		MultiTrigger
		{
			Type = MultiTrigger
			Triggers = [LogicTrigger, ManualTrigger]
		}
		ModeCycle
		{
			Type = ModeCycle
			IncrementTrigger = MultiTrigger
		}
		ToggledOn
		{
			Type = ModeToggle
			Mode = ModeCycle
			OnModes = [1]
		}
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
			MinBuffValue = 0.0000000000001 //fix so zero value does not activate
		}
		ColorPicker
		{
			Type = UIColor
			ColorID = "logiccolor"
			Default = Green
		}
		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			GetColorFrom = ColorPicker
			OperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "doodads_on.png"
						Size = [1, 2]
						Offset = [0, -0.5]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doors"
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [1, 1]
						Offset = [0, -0.25]
					}
				]
			}
		}
		WireGraphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = IsOperational
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "wire.png"
						Size = [1, 2]
						Offset = [0, -0.5]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "overlay2.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "overlay1.png"
						Size = [1, 1]
						Offset = [0, 0]
					}
				]
			}
		}
	}
}
