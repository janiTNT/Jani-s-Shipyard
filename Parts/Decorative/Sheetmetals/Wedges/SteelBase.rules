Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/SheetmetalSteel"
	IconNameKey = "Parts/SheetmetalSteelIcon"
	ID = janiTNT.sheetmetal_steel
	EditorParentParts = [ "janiTNT.sheetmetal_steel" ]
	DescriptionKey = "Parts/SheetmetalSteelDesc"
	Resources
	[
		[steel, 1]
	]
	AIValueFactor = 0
	SelectionTypeID = "armor"
	MaxHealth = 250
	TypeCategories = [sheetmetal, non_flammable]
	UnderlyingPartPerTile = ""
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	InitialPenetrationResistance = 0.25
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	Density = 0.25
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "steel1.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 100
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [.5, .5]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
	}
}