BaseWedge = &<../basewedge3.rules>/Part
Part : <../SteelBase.rules>/Part
{
	NameKey = "Parts/SheetmetalSteelWedge3_Hybrid"
	IconNameKey = "Parts/SheetmetalSteelWedge3_HybridIcon"
	ID = janiTNT.steel.sheetmetal_wedge.3_hybrid
	EditorReplacementPartID = ""
	Resources
	[
		[&~/Part/^/0/Resources/0/0, ceil((&~/Part/^/0/Resources/0/1)*(&~/BaseWedge/COSTMULTIPLIER))+3]
	]
	MaxHealth = (&^/0/MaxHealth)*(&~/BaseWedge/HEALTHMULTIPLIER)
	ReceivableBuffs : ^/0/ReceivableBuffs []
	InitialPenetrationResistance = (&^/0/InitialPenetrationResistance)*(&~/BaseWedge/PENETRATIONFACTOR)
	
	Size = &~/BaseWedge/Size
	
	//Wedge copypaste
	
	IsFlippable = true
	//AllowedContiguity = [Right, Bottom]
	SelectionTypeID = "armor"
	UnderlyingPartPerTile = ""
	UnderlyingPart = ""
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	IsRotateable = true
	IsWalled = true
	IsSelfDestructible = false
	ExternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [TopRight, Right]
		}
		{
			Key = [0, 1]
			Value = [Right]
		}
		{
			Key = [0, 2]
			Value = [Right, BottomRight, Bottom, BottomLeft]
		}
	]
	InternalWallsByCell
	[
	 	{
	 		Key = [0, 0]
	 		Value = [BottomLeft, Left, TopLeft, Top]
	 	}
	 	{
	 		Key = [0, 1]
	 		Value = [TopLeft, Left, BottomLeft]
	 	}
	 	{
	 		Key = [0, 2]
	 		Value = [Left, TopLeft]
	 	}
	]
	VirtualInternalCells
	[
		{ExternalCell=[0, -1]; InternalCell=[1, 0]}
		{ExternalCell=[-1, 2]; InternalCell=[0, 3]}
	]
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	FlipHRotate = [0, 3, 2, 1]
	FlipVRotate = [2, 1, 0, 3]
	GenerateRectCollider = false
	
	EditorIcon
	{
		Texture
		{
			File = "steel_wedge3_hybrid_icon.png"
			SampleMode = Linear
		}
		Size = [27, 80]
	}
	Components : ^/0/Components
	{
		Collider = &~/BaseWedge/Components/Collider
		
		DestroyedEffects = &~/BaseWedge/Components/DestroyedEffects
		
		Graphics : &~/BaseWedge/Components/Graphics
		{
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{File = "steel_wedge3_hybrid1.png"; Size = [1, 3]}
					{File = "steel_wedge3_hybrid2.png"; Size = [1, 3]}
					{File = "steel_wedge3_hybrid3.png"; Size = [1, 3]}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{File = "steel_wedge3_hybrid1.png"
					NormalsFile = &~/BaseWedge/Components/Graphics/Path/Hybrid_WallNormals;Size = [1, 3]}
					{File = "steel_wedge3_hybrid2.png"
					NormalsFile = &~/BaseWedge/Components/Graphics/Path/Hybrid_WallNormals_33;Size = [1, 3]}
					{File = "steel_wedge3_hybrid3.png"
					NormalsFile = &~/BaseWedge/Components/Graphics/Path/Hybrid_WallNormals_66;Size = [1, 3]}
				]
			}
		}
		
		Blueprints
		{
			Type = BlueprintSprite
			File = "steel_wedge3_hybrid4.png"
			Size = [1, 3]
		}
	}

	Stats
	{
		PenResist = &~/Part/InitialPenetrationResistance
	}
}