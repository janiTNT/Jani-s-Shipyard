Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/DecouplerHeat"
	IconNameKey = "Parts/DecouplerHeatIcon"
	ID = janiTNT.Decoupler_Heat_pipe_adaptive
	EditorParentParts = [ "janiTNT.Decoupler" ]
	DescriptionKey = "Parts/DecouplerHeatDesc"
	Resources
	[
		[steel, 4]
		[coil, 4]
	]
	TypeCategories = [explosives, heat_management, logic]
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	CrewSpeedFactor = 0
	Size = [1, 1]
	SelectionTypeID = heat_pipe
	SelectionPriority = 1
	MaxHealth = 100
	IsWalled = false
	DestroyedPartHealthFraction = 100%
	UnderlyingPartPerTile = "janiTNT.Decoupler_Boomed"
	ReceivableBuffs : ^/0/ReceivableBuffs [Logic]
	EditorIcon
	{
		Texture
		{
			File = "iconheat.png"
			SampleMode = Linear
		}
		Size = [32, 48]
	}
	Components : &<./data/ships/terran/heat_pipe_adaptive/heat_pipe_adaptive.rules>/Part/Components
	{
		LogicSignal
		{
			Type = BuffToggle
			BuffType = Logic
		}
		LogicRepeatingTrigger
		{
			Type = Timer
			Duration = .05
			OperationalToggle = LogicSignal
			AutoStart = true
			Repeats = true
		}
		LogicDetonateEffects
		{
			// SKIPY

			Type = TriggeredEffects
			Trigger = LogicRepeatingTrigger
			HitEffects
			[
				{
					Type = Damage
					Damage = 999999
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
				}
			]
		}
		DetonateTrigger
		{
			Type = UITrigger
			TriggerID = "detonate"
			RequiresCommand = false
		}
		DetonateEffects
		{
			// This just destroys the part, which in turn will trigger the DeathEffects, causing the actual collateral damage.
			// the only reason i used this is because repair was being dumb

			Type = TriggeredEffects
			Trigger = DetonateTrigger
			HitEffects
			[
				{
					Type = Damage
					Damage = 8000
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
				}
			]
		}
		
		DestroyedEffects
		{
			Type = DeathEffects
			Location = [.5, 0]
			MediaEffects
			[
				&<./Data/common_effects/particles/explosions/small_part_explode.rules>
				&<./Data/common_effects/particles/explosions/med_part_explode_flash.rules>
				&<./Data/common_effects/particles/explosions/med_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/common_effects/sounds/med_part_destroyed_01.wav",
									"./Data/common_effects/sounds/med_part_destroyed_02.wav",
									"./Data/common_effects/sounds/med_part_destroyed_03.wav"]
					Volume = 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .15
					Duration = 1
				}
			]
		}

		Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"bomb1.png"
							"bomb2.png"
							"bomb3.png"
							"bomb4.png"
							"bomb5.png"
							"bomb4.png"
							"bomb3.png"
							"bomb2.png"
						]
						Size = [1, 1]
						AnimationInterval = .1
						AnimationStartTime = Zero
					}
				]
			}
		}
		
		BlueprintBlendSprites//removes

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints_heat.png"
			Size = [1, 1]
		}
	}
}