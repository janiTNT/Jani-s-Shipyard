OVERCLOCK : &<./data/ships/terran/thruster_small/thruster_small.rules>/OVERCLOCK
{
	THRUST_HEAT_PER_SECOND = 100 * 2
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
Part : <./data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/PulseThrusterSmall"
	IconNameKey = "Parts/PulseThrusterSmallIcon"
	ID = janiTNT.pulse_thruster_small // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Flight"
	DescriptionKey = "Parts/PulseThrustersDesc"
	Resources
	[
		[steel, 8]
		[coil, 3]
	]
	TypeCategories = [thruster, uses_power]
	SignificanceToggle = ScorchedToggle
	Size = [1, 1]
	MaxHealth = 1000
	ProhibitBelow = 0
	ThrusterForce = 200 * 0.75
	ThrustIncreaseTime = 0
	ThrustDecreaseTime = 0
	ThrustRecoveryTime = 0
	FuelUsage = 15 * 1.25
	AllowedDoorLocations
	[
		[-1, 0]
		[0, -1]
		[1, 0]
	]
	DoorAccessWarningLevel = Weak
	ProhibitRects
	[
		[default, [0, 2, 1, 4]]
	]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "thrusters"
	ReceivableBuffs : ^/0/ReceivableBuffs [Engine, EnginePowerDistribution, EngineHeatCollection, ThermalActivity]
	EditorIcon
	{
		Texture
		{
			File = "small_icon.png"
			SampleMode = Linear
		}
		Size = [21.33, 21.33]
	}
	Components : &<./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components
	{
		MainThruster : &<./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/MainThruster
		{
			Location = [0.5, 1]// Relative to upper-left corner of unrotated part.
			Force = &../../ThrusterForce
			FuelUsagePerSecond
			{
				BaseValue = &~/Part/FuelUsage
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
					}
				]
			}
		}
		
		Overclock_ThrusterHeatProducer : &<./data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Overclock_ThrusterHeatProducer
		{
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&Interval))
			ToQuantity
			{
				BaseValue = (&../HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
		}

		NozzleCollider
		{
			Type = StaticToggle
			ToggleOn = "false"
		}
		
		Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			OperationalToggle = IsOperational
			AnimationSpeedFactor = MainThruster
			AnimationSpeedFactorRenormalize = [0.75, 2.0]
			Floor = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/Floor
			OperationalDoodad = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/OperationalDoodad
			NonOperationalDoodad = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/NonOperationalDoodad
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "small_lights.png"
						Size = [1, 1]
					}
				]
			}
			Walls = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/Walls
		}
		
		RoofToggle
		{
			Type = UIToggle
			ToggleID = "thruster_roof_detail"
			Default = 1
			AlwaysAllowInBuildMode = true
		}

		LowDetail
		{
			Type = ModeToggle
			Mode = RoofToggle
			OnMode = 0
		}
		
		LowComponents
		{
			Type = ToggledComponents
			Toggle = LowDetail
			IncludeInBlueprints = true
			Components
			{
				LowQualityGrid
				{
					Type = SpriteGrid
					Location = [.5, .5]
					//GridSpacing = [0.25, 0.25]
					GridSize = [1, 1]
					RandomDamageLevels
					[
						[
							{
								File = "./Data/ships/terran/corridor/roof.png"
								NormalsFile = "./Data/ships/terran/corridor/roof_normals.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/corridor/roof_33.png"
								NormalsFile = "./Data/ships/terran/corridor/roof_normals_33.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/corridor/roof_66.png"
								NormalsFile = "./Data/ships/terran/corridor/roof_normals_66.png"
								Size = [1, 1]
							}
						]
					]
					RandomUVRotation = true
					Layer = "roofs"
				}
			}
		}
		
		HighDetail
		{
			Type = ModeToggle
			Mode = RoofToggle
			OnMode = 1
		}
		
		HighComponents
		{
			Type = ToggledComponents
			Toggle = HighDetail
			IncludeInBlueprints = true
			Components
			{
				HighRoofGraphics
				{
					Type = Graphics
					Location = [0.5, 0.5]
					OperationalToggle = IsOperational
					Roof = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/Roof
					OperationalRoofDoodad = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/OperationalRoofDoodad
					OperationalRoofLighting = &<./Data/ships/terran/thruster_small/thruster_small.rules>/Part/Components/Graphics/OperationalRoofLighting
				}
			}
		}
		NozzleGraphics
		{
			Type = StaticToggle
			ToggleOn = "false"
		}
		ThrustEffects
		{
			Type = ContinuousEffects
			ChainedTo = MainThruster
			Location = [0, 0]
			FactorMediaEffectsIntensityWith = MainThruster
			IntensityTweenDuration = 0.1
			MinMediaEffectsIntensity = 1%
			MediaEffects
			[
				&<particles/thruster_heat_small.rules>

				: /COMMON_SOUNDS/ThrusterRumble
				{
					Volume = .075
					Speed = 2
					MaxConcurrentVolume = .15
				}
			]
		}

		BurstEffects
		{
			Type = TriggeredEffects
			ChainedTo = MainThruster
			Trigger = BurstTrigger
			FactorMediaEffectsIntensityWith = MainThruster
			MinMediaEffectsIntensity = 1%
			AnchorMediaEffects = true
			MediaEffects
			[
				: /COMMON_SOUNDS/ThrusterBurst
				{
					Volume = .125
					Speed = 2
					MaxConcurrentVolume = .25
				}
			]
		}
		
		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "small_blueprints.png"
			Size = [1, 1]
		}
	}

	Stats : &<./data/ships/terran/thruster_small/thruster_small.rules>/Part/Stats
	{
		ThrusterForce = &~/Part/ThrusterForce
		ThrusterRampUp = &~/Part/ThrustIncreaseTime
		ThrusterRampDown = &~/Part/ThrustDecreaseTime
		ThrusterPowerUsage = (&~/Part/FuelUsage) / 1000
		RecPower = (&ThrusterPowerUsage) / 2
		RecCrew = (&RecPower) * 4
	}
	
	StatsByCategory
	[
		{
			NameKey = "StatCategories/Overclocked"
			Stats
			{
				ThrusterForce = (&~/Part/ThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
				PowerGeneration = (&~/Part/Stats/PowerGeneration) * (&~/OVERCLOCK/POWER_GENERATION_FACTOR)
				ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
			}
		}
	]
}