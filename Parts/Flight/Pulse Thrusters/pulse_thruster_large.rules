OVERCLOCK : &<./data/ships/terran/thruster_large/thruster_large.rules>/OVERCLOCK
{
	THRUST_HEAT_PER_SECOND = 275 * 2
}
Part : &<./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/PulseThrusterLarge"
	IconNameKey = "Parts/PulseThrusterLargeIcon"
	ID = janiTNT.pulse_thruster_large // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Flight"
	DescriptionKey = "Parts/PulseThrustersDesc"
	Resources
	[
		[steel, 40]
		[coil2, 10]
	]
	TypeCategories = [thruster, uses_power]
	Size = [2, 2]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "thrusters"
	MaxHealth = 4000
	ProhibitRects
	[
		[default, [0, 4, 2, 8]]
	]
	ThrusterForce = 1600 * 0.75
	ThrustIncreaseTime
	{
		BaseValue = 4
		Modifiers
		[
			{
				Type = Buff
				BuffType = Engine
				ModificationMode = Divide
			}
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Divide
				RemapFrom = [0, 1]
				RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
			}
		]
	}
	ThrustDecreaseTime = 0
	ThrustRecoveryTime = 4
	FuelUsage = 100 * 1.25
	ReceivableBuffs : ^/0/ReceivableBuffs [Engine, EnginePowerDistribution, EngineHeatCollection, ThermalActivity]
	AllowedDoorLocations
	[
		[-1, 0]
		[0, -1]
		[1, -1]
		[2, 0]
	]
	EditorIcon
	{
		Texture
		{
			File = "large_icon.png"
			SampleMode = Linear
		}
		Size = [42.66, 42.66]
	}
	Components : &<./data/ships/terran/thruster_large/thruster_large.rules>/Part/Components
	{
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			AnimationSpeedFactor = MainThruster
			AnimationSpeedFactorRenormalize = [0.75, 2.0]
			Floor = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/Floor
			OperationalDoodad = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/OperationalDoodad
			NonOperationalDoodad = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/NonOperationalDoodad
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "large_lights.png"
						Size = [2, 2]
					}
				]
			}
			Walls = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/Walls
		}
		
		RoofToggle
		{
			Type = UIToggle
			ToggleID = "thruster_roof_detail"
			Default = 1
			AlwaysAllowInBuildMode = true
		}

		LowDetail
		{
			Type = ModeToggle
			Mode = RoofToggle
			OnMode = 0
		}
		
		LowComponents
		{
			Type = ToggledComponents
			Toggle = LowDetail
			IncludeInBlueprints = true
			Components
			{
				RoofGridFlat
				{
					Type = BlendSpriteGrid
					AllowUndefinedBlendSprites = true
					BlendsWithCategories = []
					AlwaysBlendWithSelf = true
					RectType = Physical
					Location = [0.5, 0.5]
					//GridSize = [20, 26]
					Layer = "roofs"
					//CellOffset = [0, 3]
					AmbiguousSprites = &<../Big Thrusters/RoofGrid/roof_grid_blank.rules>/AmbiguousSprites
				}
			}
		}
		
		HighDetail
		{
			Type = ModeToggle
			Mode = RoofToggle
			OnMode = 1
		}
		
		HighComponents
		{
			Type = ToggledComponents
			Toggle = HighDetail
			IncludeInBlueprints = true
			Components
			{
				HighRoofGraphics
				{
					Type = Graphics
					Location = [1, 1]
					OperationalToggle = IsOperational
					Roof = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/Roof
					OperationalRoofDoodad = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/OperationalRoofDoodad
					OperationalRoofLighting = &<./Data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/Graphics/OperationalRoofLighting
				}
			}
		}

		NozzleGraphics
		{
			Type = StaticToggle
			ToggleOn = "false"
		}

		MainThruster : &<./data/ships/terran/thruster_large/thruster_large.rules>/Part/Components/MainThruster
		{
			Location = [1, 2]// Relative to upper-left corner of unrotated part.
			Force = &../../ThrusterForce
			FuelUsagePerSecond
			{
				BaseValue = &~/Part/FuelUsage
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
					}
				]
			}
		}

		NozzleCollider
		{
			Type = StaticToggle
			ToggleOn = "false"
		}

		ThrustEffects
		{
			Type = ContinuousEffects
			ChainedTo = MainThruster
			Location = [0, 0]
			FactorMediaEffectsIntensityWith = MainThruster
			IntensityTweenDuration = 0.1
			MinMediaEffectsIntensity = 1%
			MediaEffects
			[
				&<particles/thruster_heat_large.rules>

				: /COMMON_SOUNDS/ThrusterRumble
				{
					Volume = .25
					Speed = 1
					MaxConcurrentVolume = .5
				}
			]
		}

		BurstEffects
		{
			Type = TriggeredEffects
			ChainedTo = MainThruster
			Trigger = BurstTrigger
			FactorMediaEffectsIntensityWith = MainThruster
			AnchorMediaEffects = true
			MinMediaEffectsIntensity = 1%
			MediaEffects
			[
				: /COMMON_SOUNDS/ThrusterBurst
				{
					Volume = .5
					Speed = 1
					MaxConcurrentVolume = 1
				}
			]
		}
		
		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "large_blueprints.png"
			Size = [2, 2]
		}
	}
	
	Stats : &<./data/ships/terran/thruster_large/thruster_large.rules>/Part/Stats
	{
		ThrusterForce = &~/Part/ThrusterForce
		ThrusterRampUp = &~/Part/ThrustIncreaseTime/BaseValue
		ThrusterRampDown = &~/Part/ThrustDecreaseTime
		ThrusterPowerUsage = (&~/Part/FuelUsage) / 1000
		
		RecPower = (&ThrusterPowerUsage) / 2
		RecCrew = (&RecPower) * 4
	}
	
	StatsByCategory
	[
		{
			NameKey = "StatCategories/Overclocked"
			Stats
			{
				ThrusterForce = (&~/Part/ThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
				ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
				ThrusterPowerUsage = (&~/Part/FuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
			}
		}
	]
}